<div class="max-w-7xl mx-auto space-y-6 pb-16">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 mb-2">PHASE 4 · ADMIN</div>
      <h1 class="text-3xl font-bold text-stone-900">Translation Management</h1>
      <p class="mt-1 text-sm text-stone-500">Customer, Worker, Field Agent and Masters: translate original data once, then publish language-wise.</p>
    </div>
    <a href="/admin/languages" class="rounded-xl border border-stone-300 bg-white px-5 py-3 text-center text-sm font-bold text-stone-800 hover:bg-stone-50">Manage Languages</a>
  </div>
  <% if (success) { %><div role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800"><%= success %></div><% } %>
  <% if (error) { %><div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= error %></div><% } %>
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Records to translate</p><p class="mt-1 text-3xl font-bold text-amber-700"><%= pendingRecords %></p></div>
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-stone-500 uppercase tracking-wider">All translations complete</p><p class="mt-1 text-3xl font-bold text-emerald-700"><%= completedRecords %></p></div>
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm"><p class="text-xs font-semibold text-stone-500 uppercase tracking-wider">Total source records</p><p class="mt-1 text-3xl font-bold text-stone-900"><%= totalRecords %></p></div>
  </div>
  <div class="rounded-xl border border-blue-200 bg-blue-50 px-5 py-4 text-sm text-blue-900">
    <strong>Automatic queue:</strong> New records saved from Admin, Field Agent or Customer App are found without editing the registration forms. Incomplete Worker/Customer drafts are not translated until registration is submitted. Original source values are preserved. <strong>Customer saved work addresses are grouped under their Customer record</strong> (no duplicate Work Address queue items). Excel/CSV bulk export/import is available below. Only translate the target-language columns; keep record identifiers and fingerprints unchanged.
  </div>
  <form method="get" action="/admin/translations" class="grid grid-cols-1 gap-3 rounded-2xl border border-stone-200 bg-white p-4 sm:grid-cols-4 sm:items-end">
    <div><label for="type" class="block text-xs font-semibold text-stone-600 mb-1">Record type</label><select id="type" name="type" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm"><option value="ALL">All record types</option><% for (const [key,def] of Object.entries(entities)) { %><option value="<%= key %>" <%= selectedType===key ? 'selected' : '' %>><%= def.label %></option><% } %></select></div>
    <div><label for="language" class="block text-xs font-semibold text-stone-600 mb-1">Target language</label><select id="language" name="language" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm"><option value="ALL">All languages</option><% for (const l of languages) { %><option value="<%= l.code %>" <%= selectedLanguage===l.code ? 'selected' : '' %>><%= l.name %><%= l.isActive ? '' : ' (Inactive)' %></option><% } %></select></div>
    <div><label for="status" class="block text-xs font-semibold text-stone-600 mb-1">Translation status</label><select id="status" name="status" class="w-full rounded-lg border border-stone-300 bg-white px-3 py-2.5 text-sm"><option value="PENDING" <%= selectedStatus==='PENDING' ? 'selected' : '' %>>Pending / Needs review</option><option value="COMPLETE" <%= selectedStatus==='COMPLETE' ? 'selected' : '' %>>Completed</option><option value="ALL" <%= selectedStatus==='ALL' ? 'selected' : '' %>>All records</option></select></div>
    <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-700">Apply Filters</button>
  </form>
  <!-- Phase 4: Export–Import all matching records, not just the current 20-row page. -->
  <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm space-y-4">
    <div>
      <h2 class="text-lg font-bold text-stone-900">Bulk Translation · Excel / CSV</h2>
      <p class="mt-1 text-sm text-stone-500">Export pending translations, fill the language columns in Excel (or use an external AI tool), then import your completed file. No paid translation API needed.</p>
    </div>
    <form method="get" action="/admin/translations/export" class="flex flex-wrap items-center gap-3 rounded-xl bg-emerald-50 p-4">
      <input type="hidden" name="type" value="<%= selectedType %>">
      <input type="hidden" name="language" value="<%= selectedLanguage %>">
      <input type="hidden" name="status" value="<%= selectedStatus %>">
      <span class="mr-auto text-sm font-semibold text-emerald-900">Export current filters · all pages</span>
      <button type="submit" name="format" value="xlsx" class="rounded-lg bg-emerald-700 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-800">Download Excel (.xlsx)</button>
      <button type="submit" name="format" value="csv" class="rounded-lg border border-emerald-300 bg-white px-4 py-2.5 text-sm font-bold text-emerald-900 hover:bg-emerald-50">Download CSV</button>
    </form>
    <form action="/admin/translations/import" method="post" enctype="multipart/form-data" class="grid grid-cols-1 gap-3 rounded-xl border border-stone-200 p-4 md:grid-cols-3 md:items-end">
      <input type="hidden" name="_csrf" value="<%= typeof csrf === 'string' ? csrf : '' %>">
      <div class="md:col-span-2"><label class="mb-1 block text-xs font-semibold text-stone-700" for="translationFile">Upload completed template (.xlsx or UTF-8 .csv, max 5 MB)</label>
        <input type="file" id="translationFile" name="translationFile" accept=".xlsx,.csv" required class="block w-full rounded-lg border border-stone-300 bg-white p-2.5 text-sm" /></div>
      <div><label class="mb-1 block text-xs font-semibold text-stone-700" for="importAction">After import</label>
        <select id="importAction" name="action" class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm">
          <option value="draft">Save as Draft (safer)</option>
          <option value="publish">Publish completed records</option>
        </select></div>
      <label class="md:col-span-2 inline-flex items-start gap-2 text-sm text-stone-700"><input type="checkbox" name="overwriteExisting" value="yes" class="mt-1" /> Allow replacement of already published translations when file has a different value</label>
      <button type="submit" class="rounded-lg bg-stone-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-stone-700">Import Translations</button>
    </form>
    <p class="text-xs leading-relaxed text-stone-500">Important: Edit only language columns, not Record Type, IDs, Field Key, Original Text, Source Hash or Row Token. Existing published translations are protected by default. Changes to original records after export are skipped automatically. In Publish mode, incomplete record/language groups stay Draft. Customer work addresses are included within the Customer export. These files contain personal names/addresses; share securely.</p>
  </section>
  <div class="flex flex-wrap gap-2">
    <% for (const [key,stat] of Object.entries(perType)) { %>
      <a href="/admin/translations?type=<%= key %>&language=<%= encodeURIComponent(selectedLanguage) %>&status=PENDING" class="inline-flex items-center gap-2 rounded-full border <%= selectedType===key ? 'border-emerald-400 bg-emerald-50' : 'border-stone-200 bg-white' %> px-3 py-1.5 text-xs font-semibold text-stone-700 hover:border-emerald-300"><%= stat.label %><span class="rounded-full bg-amber-100 px-2 py-0.5 text-amber-800"><%= stat.pending %></span></a>
    <% } %>
  </div>
  <section class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
    <div class="flex items-center justify-between gap-2 border-b border-stone-100 px-5 py-4"><h2 class="font-bold text-stone-900">Records <span class="font-normal text-stone-500">(<%= displayedTotal %> matches)</span></h2><span class="text-xs text-stone-500">Page <%= page %> of <%= pageCount %></span></div>
    <% if (!items.length) { %>
      <div class="p-12 text-center"><p class="font-semibold text-stone-800">No matching records</p><p class="mt-1 text-sm text-stone-500">Try another language or status. New completed registrations appear automatically.</p></div>
    <% } else { %>
      <div class="divide-y divide-stone-100">
        <% for (const item of items) { %>
          <div class="flex flex-col gap-3 p-5 hover:bg-stone-50 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2"><span class="rounded-md bg-stone-100 px-2 py-1 text-[11px] font-bold uppercase text-stone-600"><%= item.label %></span><span class="text-xs text-stone-400">#<%= item.id %></span><% if (item.done) { %><span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-800">Complete</span><% } %></div>
              <p class="mt-1 truncate font-bold text-stone-900"><%= item.title %></p>
              <% if (item.type === 'CUSTOMER' && item.addressCount) { %><p class="mt-1 text-xs text-stone-500"><%= item.addressCount %> saved work address<%= item.addressCount === 1 ? '' : 'es' %> included in translation progress</p><% } %>
              <div class="mt-2 flex flex-wrap gap-2">
                <% for (const c of item.checks) { %>
                  <span class="rounded-lg border px-2.5 py-1 text-xs font-semibold <%= c.state==='COMPLETE' ? 'border-emerald-200 bg-emerald-50 text-emerald-800' : c.state==='NEEDS_REVIEW' ? 'border-orange-200 bg-orange-50 text-orange-800' : 'border-amber-200 bg-amber-50 text-amber-800' %>"><%= c.label %>: <%= c.state==='COMPLETE' ? 'Complete' : c.state==='NEEDS_REVIEW' ? 'Needs review' : 'Pending' %> <span class="font-normal">(<%= c.completed %>/<%= c.total %>)</span></span>
                <% } %>
              </div>
            </div>
            <a href="/admin/translations/<%= item.type %>/<%= item.id %>" class="shrink-0 rounded-xl bg-stone-900 px-5 py-2.5 text-center text-sm font-bold text-white hover:bg-stone-700">Translate →</a>
          </div>
        <% } %>
      </div>
    <% } %>
    <div class="flex items-center justify-between gap-3 border-t border-stone-100 px-5 py-4">
      <% const params = (n) => `?type=${encodeURIComponent(selectedType)}&language=${encodeURIComponent(selectedLanguage)}&status=${encodeURIComponent(selectedStatus)}&page=${n}`; %>
      <% if (page > 1) { %><a href="/admin/translations<%= params(page-1) %>" class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold hover:bg-stone-50">← Previous</a><% } else { %><span></span><% } %>
      <span class="text-sm text-stone-500">Showing up to <%= pageSize %> records</span>
      <% if (page < pageCount) { %><a href="/admin/translations<%= params(page+1) %>" class="rounded-lg border border-stone-300 px-4 py-2 text-sm font-semibold hover:bg-stone-50">Next →</a><% } else { %><span></span><% } %>
    </div>
  </section>
</div>
