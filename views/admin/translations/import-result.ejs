<div class="mx-auto max-w-4xl space-y-5 pb-16">
  <a href="/admin/translations" class="inline-flex text-sm font-bold text-emerald-700 hover:underline">← Back to Translation Management</a>
  <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
    <span class="text-xs font-bold uppercase text-emerald-700">Phase 4 · Excel / CSV</span>
    <h1 class="mt-2 text-2xl font-bold text-stone-900">Translation Import Result</h1>
    <% if (error) { %>
      <div role="alert" class="mt-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800"><%= error %></div>
      <p class="mt-3 text-sm text-stone-600">No translations were imported. Download a fresh template from Translation Management and retry.</p>
    <% } else { %>
      <p class="mt-2 text-sm text-stone-600">Processed spreadsheet rows and validated every translated field against the original database source.</p>
      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-4">
        <% for (const [label,value] of [['Rows',report.rows],['New translations',report.added],['Updated fields',report.updated],['Skipped entries',report.skipped]]) { %>
          <div class="rounded-xl bg-stone-50 p-4"><p class="text-xs text-stone-500"><%= label %></p><p class="mt-1 text-2xl font-bold text-stone-900"><%= value %></p></div>
        <% } %>
      </div>
      <div class="mt-4 flex flex-wrap gap-3 text-sm text-stone-700">
        <span class="rounded-lg bg-emerald-50 px-3 py-2">Groups published: <strong><%= report.published %></strong></span>
        <span class="rounded-lg bg-amber-50 px-3 py-2">Groups saved as draft: <strong><%= report.drafts %></strong></span>
        <span class="rounded-lg bg-stone-100 px-3 py-2">Already current fields: <strong><%= report.unchanged %></strong></span>
      </div>
      <% if (report.errors.length) { %>
        <section class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4">
          <h2 class="font-bold text-amber-950">Skipped / warnings (<%= report.errors.length %> shown)</h2>
          <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-amber-900"><% for (const message of report.errors) { %><li><%= message %></li><% } %></ul>
        </section>
      <% } %>
    <% } %>
  </div>
  <a href="/admin/translations" class="inline-block rounded-lg bg-emerald-700 px-5 py-3 text-sm font-bold text-white hover:bg-emerald-800">Go to Translation Queue</a>
</div>
