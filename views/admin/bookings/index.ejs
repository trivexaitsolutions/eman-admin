<%
    const statusLabel = {
        PENDING: "Payment Pending",
        ASSIGNED: "Workers Assigned",
        IN_PROGRESS: "In Progress",
        COMPLETED: "Completed",
        CANCELLED: "Cancelled"
    };
%>

<div class="space-y-6 pb-8">
    <section class="rounded-3xl border border-stone-200 bg-white px-5 py-6 shadow-sm sm:px-7">
        <div class="flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between">
            <div>
                <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                    <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
                    Live booking operations
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-stone-950 sm:text-3xl">Bookings</h1>
                <p class="mt-2 text-sm leading-6 text-stone-500">
                    Current work, pending payments aur complete booking history ek hi page par monitor karo.
                </p>
            </div>

            <div class="flex flex-col gap-2 sm:flex-row">
                <a href="/admin/bookings/online-workers" class="inline-flex items-center justify-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-2.5 text-sm font-bold text-emerald-700 transition hover:bg-emerald-100">
                    <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
                    Online Workers
                </a>
                <a href="/admin/bookings" class="inline-flex items-center justify-center rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-semibold text-stone-700 transition hover:bg-stone-50">
                    Refresh
                </a>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <a href="/admin/bookings?status=IN_PROGRESS" class="rounded-2xl border border-violet-200 bg-violet-50 p-5 transition hover:-translate-y-0.5 hover:shadow-md">
            <p class="text-sm font-semibold text-violet-800">Currently Running</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.activeBookings %></p>
            <p class="mt-1 text-xs text-violet-700">Assigned + in-progress jobs</p>
        </a>

        <a href="/admin/bookings/online-workers" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 transition hover:-translate-y-0.5 hover:shadow-md">
            <p class="text-sm font-semibold text-emerald-800">Online Workers</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.onlineWorkers %></p>
            <p class="mt-1 text-xs text-emerald-700">Availability window active</p>
        </a>

        <a href="/admin/bookings?status=PENDING" class="rounded-2xl border border-amber-200 bg-amber-50 p-5 transition hover:-translate-y-0.5 hover:shadow-md">
            <p class="text-sm font-semibold text-amber-800">Pending Payments</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.pendingPayments %></p>
            <p class="mt-1 text-xs text-amber-700">Checkout initiated bookings</p>
        </a>

        <a href="/admin/bookings?status=COMPLETED" class="rounded-2xl border border-sky-200 bg-sky-50 p-5 transition hover:-translate-y-0.5 hover:shadow-md">
            <p class="text-sm font-semibold text-sky-800">Completed Today</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.completedToday %></p>
            <p class="mt-1 text-xs text-sky-700">Updated since midnight</p>
        </a>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <form method="GET" action="/admin/bookings" class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-7">
            <div class="xl:col-span-2">
                <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">Search</label>
                <input
                    type="text"
                    name="search"
                    value="<%= filters.search %>"
                    placeholder="Booking ID, customer, worker, phone..."
                    class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-100"
                >
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">Status</label>
                <select name="status" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
                    <option value="">All statuses</option>
                    <% filterOptions.statuses.forEach(item => { %>
                        <option value="<%= item %>" <%= filters.status === item ? "selected" : "" %>><%= statusLabel[item] || item %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">Primary Naka</label>
                <select name="nakaId" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
                    <option value="">All Nakas</option>
                    <% filterOptions.nakas.forEach(naka => { %>
                        <option value="<%= naka.id %>" <%= Number(filters.nakaId) === Number(naka.id) ? "selected" : "" %>><%= naka.name %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">Skill</label>
                <select name="skillId" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
                    <option value="">All Skills</option>
                    <% filterOptions.skills.forEach(skill => { %>
                        <option value="<%= skill.id %>" <%= Number(filters.skillId) === Number(skill.id) ? "selected" : "" %>><%= skill.name %></option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">From</label>
                <input type="date" name="fromDate" value="<%= filters.fromDate %>" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
            </div>

            <div>
                <label class="mb-1.5 block text-xs font-bold uppercase tracking-wide text-stone-500">To</label>
                <input type="date" name="toDate" value="<%= filters.toDate %>" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
            </div>

            <div class="flex items-end gap-2 xl:col-span-7">
                <button type="submit" class="inline-flex flex-1 items-center justify-center rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-emerald-700 sm:flex-none">
                    Apply Filters
                </button>
                <a href="/admin/bookings" class="inline-flex flex-1 items-center justify-center rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-semibold text-stone-600 transition hover:bg-stone-50 sm:flex-none">
                    Clear
                </a>
            </div>
        </form>
    </section>

    <section class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
        <div class="flex flex-col gap-2 border-b border-stone-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="font-bold text-stone-950">Booking Records</h2>
                <p class="mt-1 text-xs text-stone-500">
                    Showing <%= pagination.firstRecord %>–<%= pagination.lastRecord %> of <%= pagination.totalRecords %>
                </p>
            </div>
            <span class="text-xs font-semibold text-stone-400"><%= pagination.pageSize %> records per page</span>
        </div>

        <% if (rows.length === 0) { %>
            <div class="px-6 py-16 text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-stone-100 text-2xl">📭</div>
                <h3 class="mt-4 font-bold text-stone-900">No bookings found</h3>
                <p class="mt-1 text-sm text-stone-500">Filters clear karke dobara check karein.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 gap-4 p-4 md:hidden">
                <% rows.forEach(booking => { %>
                    <a href="/admin/bookings/<%= booking.id %>" class="rounded-2xl border border-stone-200 bg-white p-4 transition hover:border-emerald-300 hover:shadow-md">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="font-black text-stone-950">Booking #<%= booking.id %></p>
                                <p class="mt-1 text-sm font-semibold text-stone-700"><%= booking.customer?.name || "Customer" %></p>
                            </div>
                            <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold <%= booking.statusMeta.classes %>"><%= booking.statusMeta.label %></span>
                        </div>

                        <div class="mt-4 grid grid-cols-2 gap-3 text-xs">
                            <div>
                                <p class="text-stone-400">Skill</p>
                                <p class="mt-1 font-semibold text-stone-700"><%= booking.skill?.name || `Skill #${booking.skillId}` %></p>
                            </div>
                            <div>
                                <p class="text-stone-400">Workers</p>
                                <p class="mt-1 font-semibold text-stone-700"><%= booking.workers.length %> / <%= booking.workerCount %></p>
                            </div>
                            <div>
                                <p class="text-stone-400">Amount</p>
                                <p class="mt-1 font-semibold text-stone-700">₹<%= Number(booking.amount || 0).toLocaleString("en-IN") %></p>
                            </div>
                            <div>
                                <p class="text-stone-400">Created</p>
                                <p class="mt-1 font-semibold text-stone-700"><%= booking.createdAgo %></p>
                            </div>
                        </div>
                    </a>
                <% }) %>
            </div>

            <div class="hidden overflow-x-auto md:block">
                <table class="w-full min-w-[1100px] text-left">
                    <thead class="border-b border-stone-200 bg-stone-50">
                        <tr>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Booking</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Customer</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Skill / Naka</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Workers</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Amount</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Status</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Created</th>
                            <th class="px-5 py-4 text-right text-xs font-bold uppercase tracking-wide text-stone-500">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100">
                        <% rows.forEach(booking => { %>
                            <tr class="transition hover:bg-stone-50">
                                <td class="px-5 py-4">
                                    <p class="font-black text-stone-950">#<%= booking.id %></p>
                                    <p class="mt-1 text-xs text-stone-400"><%= booking.razorpayOrderId || "No payment order" %></p>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="text-sm font-bold text-stone-900"><%= booking.customer?.name || "Customer" %></p>
                                    <p class="mt-1 text-xs text-stone-500"><%= booking.customer?.phone || "—" %></p>
                                    <% if (booking.customer?.businessName) { %>
                                        <p class="mt-1 text-[11px] text-stone-400"><%= booking.customer.businessName %></p>
                                    <% } %>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="text-sm font-semibold text-stone-800"><%= booking.skill?.name || `Skill #${booking.skillId}` %></p>
                                    <p class="mt-1 text-xs text-stone-500"><%= booking.primaryNaka?.name || `Naka #${booking.nakaId}` %></p>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="text-sm font-bold text-stone-800"><%= booking.workers.length %> / <%= booking.workerCount %></p>
                                    <p class="mt-1 max-w-[180px] truncate text-xs text-stone-500"><%= booking.workers.map(worker => worker.name).join(", ") || "Not assigned" %></p>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="text-sm font-black text-stone-900">₹<%= Number(booking.amount || 0).toLocaleString("en-IN") %></p>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex rounded-full border px-2.5 py-1 text-[11px] font-bold <%= booking.statusMeta.classes %>"><%= booking.statusMeta.label %></span>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="text-sm font-semibold text-stone-700"><%= booking.createdAtFormatted %></p>
                                    <p class="mt-1 text-xs text-stone-400"><%= booking.createdAgo %></p>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <a href="/admin/bookings/<%= booking.id %>" class="inline-flex rounded-lg bg-stone-900 px-3 py-2 text-xs font-bold text-white transition hover:bg-emerald-700">View</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <% if (pagination.totalPages > 1) { %>
            <div class="flex flex-col gap-3 border-t border-stone-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-xs font-semibold text-stone-500">
                    Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
                </p>

                <div class="flex flex-wrap items-center gap-1">
                    <% if (pagination.currentPage > 1) { %>
                        <a href="<%= pagination.pageUrl(pagination.currentPage - 1) %>" class="rounded-lg border border-stone-200 px-3 py-2 text-xs font-bold text-stone-600 hover:bg-stone-50">Previous</a>
                    <% } %>

                    <%
                        const startPage = Math.max(1, pagination.currentPage - 2);
                        const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
                    %>

                    <% for (let page = startPage; page <= endPage; page += 1) { %>
                        <a href="<%= pagination.pageUrl(page) %>" class="rounded-lg border px-3 py-2 text-xs font-bold <%= page === pagination.currentPage ? 'border-emerald-600 bg-emerald-600 text-white' : 'border-stone-200 text-stone-600 hover:bg-stone-50' %>"><%= page %></a>
                    <% } %>

                    <% if (pagination.currentPage < pagination.totalPages) { %>
                        <a href="<%= pagination.pageUrl(pagination.currentPage + 1) %>" class="rounded-lg border border-stone-200 px-3 py-2 text-xs font-bold text-stone-600 hover:bg-stone-50">Next</a>
                    <% } %>
                </div>
            </div>
        <% } %>
    </section>
</div>
