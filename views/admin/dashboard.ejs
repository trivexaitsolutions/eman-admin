<%
    const m = dashboard.metrics || {};
    const canManage = dashboard.permissions?.canManage;
%>

<% if (dashboard.loadError) { %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"><%= dashboard.loadError %></div>
<% } %>

<div class="space-y-5">
    <section class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h1 class="text-2xl font-black text-stone-900">Dashboard</h1>
            <p class="text-sm text-stone-500 mt-1">Today’s operational snapshot</p>
        </div>
        <div class="flex items-center gap-2">
            <% if (canManage) { %>
                <a href="/admin/leaves" class="inline-flex items-center gap-2 rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-bold text-stone-700 hover:border-emerald-300 hover:text-emerald-700">
                    Leave Requests
                    <% if (m.pendingLeaves > 0) { %><span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700"><%= m.pendingLeaves %></span><% } %>
                </a>
            <% } else { %>
                <a href="/admin/leaves/my" class="inline-flex items-center rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-bold text-stone-700">My Leaves</a>
            <% } %>
            <a href="/admin/dashboard" class="rounded-xl bg-stone-900 px-4 py-2.5 text-sm font-bold text-white hover:bg-stone-800">Refresh</a>
        </div>
    </section>

    <section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
        <a href="/admin/workers" class="rounded-2xl border border-stone-200 bg-white p-4 hover:border-sky-300 transition">
            <div class="flex items-center justify-between gap-3">
                <span class="text-xs font-bold uppercase tracking-wide text-stone-500">Workers</span>
                <span class="h-2.5 w-2.5 rounded-full bg-sky-500"></span>
            </div>
            <div class="mt-3 text-3xl font-black text-stone-900"><%= m.totalWorkers || 0 %></div>
            <div class="mt-1 text-xs font-semibold text-sky-700"><%= m.availableWorkers || 0 %> available</div>
        </a>

        <a href="/admin/bookings" class="rounded-2xl border border-stone-200 bg-white p-4 hover:border-emerald-300 transition">
            <div class="flex items-center justify-between gap-3">
                <span class="text-xs font-bold uppercase tracking-wide text-stone-500">Active Jobs</span>
                <span class="h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
            </div>
            <div class="mt-3 text-3xl font-black text-stone-900"><%= m.activeBookings || 0 %></div>
            <div class="mt-1 text-xs font-semibold text-stone-500">In progress / assigned</div>
        </a>

        <a href="/admin/conflicts" class="rounded-2xl border <%= m.unassignedConflicts > 0 ? 'border-red-300 bg-red-50' : 'border-stone-200 bg-white' %> p-4 hover:border-violet-300 transition">
            <div class="flex items-center justify-between gap-3">
                <span class="text-xs font-bold uppercase tracking-wide text-stone-500">Open Conflicts</span>
                <span class="h-2.5 w-2.5 rounded-full bg-violet-500"></span>
            </div>
            <div class="mt-3 text-3xl font-black text-stone-900"><%= m.openConflicts || 0 %></div>
            <div class="mt-1 text-xs font-semibold <%= m.unassignedConflicts > 0 ? 'text-red-700' : 'text-stone-500' %>"><%= m.unassignedConflicts || 0 %> unassigned</div>
        </a>

        <% if (canManage) { %>
            <a href="/admin/leaves?status=ON_LEAVE" class="rounded-2xl border border-stone-200 bg-white p-4 hover:border-amber-300 transition">
                <div class="flex items-center justify-between gap-3">
                    <span class="text-xs font-bold uppercase tracking-wide text-stone-500">On Leave</span>
                    <span class="h-2.5 w-2.5 rounded-full bg-amber-500"></span>
                </div>
                <div class="mt-3 text-3xl font-black text-stone-900"><%= m.onLeaveToday || 0 %></div>
                <div class="mt-1 text-xs font-semibold text-amber-700"><%= m.pendingLeaves || 0 %> pending requests</div>
            </a>
        <% } else { %>
            <div class="rounded-2xl border border-stone-200 bg-white p-4">
                <div class="text-xs font-bold uppercase tracking-wide text-stone-500">Operational Nakas</div>
                <div class="mt-3 text-3xl font-black text-stone-900"><%= m.verifiedNakas || 0 %></div>
                <div class="mt-1 text-xs font-semibold text-stone-500"><%= m.verificationHealthPercent || 0 %>% verified</div>
            </div>
        <% } %>
    </section>

    <% if (canManage) { %>
        <section class="rounded-2xl border border-stone-200 bg-white p-4">
            <div class="flex items-center justify-between gap-3 mb-3">
                <h2 class="font-black text-stone-900">Quick Actions</h2>
            </div>
            <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
                <a href="/admin/workers/create" class="rounded-xl bg-stone-50 px-4 py-3 text-sm font-bold text-stone-700 hover:bg-sky-50 hover:text-sky-700">+ Worker</a>
                <a href="/admin/mitras/create" class="rounded-xl bg-stone-50 px-4 py-3 text-sm font-bold text-stone-700 hover:bg-emerald-50 hover:text-emerald-700">+ Mitra</a>
                <a href="/admin/nakas/create" class="rounded-xl bg-stone-50 px-4 py-3 text-sm font-bold text-stone-700 hover:bg-amber-50 hover:text-amber-700">+ Naka</a>
                <a href="/admin/leaves" class="rounded-xl bg-stone-50 px-4 py-3 text-sm font-bold text-stone-700 hover:bg-violet-50 hover:text-violet-700">Review Leaves</a>
            </div>
        </section>

        <section class="grid gap-4 lg:grid-cols-2">
            <div class="rounded-2xl border border-stone-200 bg-white overflow-hidden">
                <div class="flex items-center justify-between border-b border-stone-100 px-4 py-3">
                    <div>
                        <h2 class="font-black text-stone-900">Naka Verification</h2>
                        <p class="text-xs text-stone-500"><%= m.attentionNakasCount || 0 %> need attention</p>
                    </div>
                    <a href="/admin/nakas?filter=pending" class="text-xs font-bold text-emerald-700">View all</a>
                </div>
                <% if (!dashboard.nakaQueue?.length) { %>
                    <div class="px-4 py-6 text-sm text-stone-500">No verification pending.</div>
                <% } else { %>
                    <div class="divide-y divide-stone-100">
                        <% dashboard.nakaQueue.forEach((item) => { %>
                            <a href="/admin/nakas?filter=pending" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-stone-50">
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-stone-900 truncate"><%= item.name %></p>
                                    <p class="text-xs text-stone-500 truncate"><%= item.location %></p>
                                </div>
                                <span class="text-stone-400">›</span>
                            </a>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <div class="rounded-2xl border border-stone-200 bg-white overflow-hidden">
                <div class="flex items-center justify-between border-b border-stone-100 px-4 py-3">
                    <div>
                        <h2 class="font-black text-stone-900">Pending Leaves</h2>
                        <p class="text-xs text-stone-500"><%= m.pendingLeaves || 0 %> waiting for decision</p>
                    </div>
                    <a href="/admin/leaves?status=PENDING" class="text-xs font-bold text-emerald-700">View all</a>
                </div>
                <% if (!dashboard.leaveQueue?.length) { %>
                    <div class="px-4 py-6 text-sm text-stone-500">No leave request pending.</div>
                <% } else { %>
                    <div class="divide-y divide-stone-100">
                        <% dashboard.leaveQueue.forEach((item) => { %>
                            <a href="/admin/leaves?status=PENDING" class="flex items-center justify-between gap-3 px-4 py-3 hover:bg-stone-50">
                                <div class="min-w-0">
                                    <div class="flex items-center gap-2">
                                        <p class="text-sm font-bold text-stone-900 truncate"><%= item.name %></p>
                                        <span class="rounded-full bg-stone-100 px-2 py-0.5 text-[10px] font-bold text-stone-600"><%= item.subjectType %></span>
                                    </div>
                                    <p class="text-xs text-stone-500 truncate"><%= item.leaveType %> · <%= item.dates %></p>
                                </div>
                                <span class="text-stone-400">›</span>
                            </a>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </section>
    <% } %>

    <p class="text-[11px] text-stone-400 text-right">Updated <%= dashboard.generatedAt %></p>
</div>
