<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-6">
  <div><h1 class="text-2xl font-bold text-stone-900">Clients</h1>
    <p class="text-sm text-stone-500 mt-1">Customer contacts, booking status and assigned Mitra.</p></div>
  <a href="/admin/clients" class="inline-flex justify-center items-center rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-semibold text-stone-700 hover:bg-stone-50">Refresh Status</a>
</div>
<div class="bg-white rounded-xl border border-stone-200 px-4 py-3 mb-4">
  <label class="text-xs font-semibold text-stone-500" for="clientSearch">Search Client</label>
  <input id="clientSearch" type="search" placeholder="Name, phone, email or Mitra" autocomplete="off" class="block w-full mt-1 rounded-lg border border-stone-200 bg-stone-50 px-3 py-2.5 outline-none focus:border-emerald-500" />
</div>
<p class="text-xs text-stone-500 mb-4">Online = app active within the last 2 minutes. In Booking = active assigned work. Refresh to see latest statuses.</p>
<div id="clientCards" class="grid grid-cols-1 gap-3 md:hidden">
  <% clients.forEach((client) => { %>
    <article class="client-item rounded-2xl bg-white border border-stone-200 p-4 shadow-sm" data-search="<%= [client.name, client.phone, client.email, client.mitra?.name, client.mitra?.phone].join(' ').toLowerCase() %>">
      <div class="flex justify-between gap-3 items-start mb-3">
        <div class="min-w-0"><p class="font-bold text-stone-900 break-words"><%= client.name %></p><p class="text-xs text-stone-400">Client #<%= client.id %></p></div>
        <div class="shrink-0"><%- include('../../partials/operational-status', { operationalStatus: client.operationalStatus }) %></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <div><p class="text-[11px] font-semibold uppercase text-stone-400 mb-1">Client Contact</p>
          <a class="block font-medium text-stone-800" href="tel:<%= client.phone %>"><%= client.phone || '—' %></a><p class="text-stone-600 break-all"><%= client.email || 'No email' %></p></div>
        <div><p class="text-[11px] font-semibold uppercase text-stone-400 mb-1">Assigned Mitra</p>
          <p class="font-semibold text-stone-900"><%= client.mitra?.name || 'Not Assigned' %></p>
          <% if (client.mitra?.phone) { %><a href="tel:<%= client.mitra.phone %>" class="text-emerald-700 font-medium"><%= client.mitra.phone %></a><% } %></div>
      </div>
    </article>
  <% }) %>
</div>
<div class="hidden md:block bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
 <table class="w-full text-left"><thead class="bg-stone-50 border-b border-stone-200 text-xs text-stone-500 uppercase">
  <tr><th class="px-5 py-4">Client</th><th class="px-5 py-4">Phone / Email</th><th class="px-5 py-4">Status</th><th class="px-5 py-4">Assigned Mitra</th></tr>
 </thead><tbody class="divide-y divide-stone-100">
 <% clients.forEach((client) => { %>
 <tr class="client-item hover:bg-stone-50" data-search="<%= [client.name, client.phone, client.email, client.mitra?.name, client.mitra?.phone].join(' ').toLowerCase() %>">
  <td class="px-5 py-4"><div class="font-bold text-stone-900"><%= client.name %></div><div class="text-xs text-stone-400">Client #<%= client.id %></div></td>
  <td class="px-5 py-4 text-sm"><a href="tel:<%= client.phone %>" class="font-semibold text-stone-800"><%= client.phone || '—' %></a><div class="text-stone-500 text-xs break-all"><%= client.email || 'No email' %></div></td>
  <td class="px-5 py-4"><%- include('../../partials/operational-status', { operationalStatus: client.operationalStatus }) %></td>
  <td class="px-5 py-4 text-sm"><div class="font-semibold text-stone-800"><%= client.mitra?.name || 'Not Assigned' %></div>
    <% if (client.mitra?.phone) { %><a href="tel:<%= client.mitra.phone %>" class="text-xs font-medium text-emerald-700"><%= client.mitra.phone %></a><% } %></td>
 </tr>
 <% }) %></tbody></table>
</div>
<% if (!clients.length) { %><div class="text-center py-12 text-stone-500">No clients registered yet.</div><% } %>
<p id="noClientMatches" class="hidden py-8 text-center text-stone-500">No matching clients.</p>
<script>
(() => {
 const search = document.getElementById('clientSearch');
 search.addEventListener('input', () => {
   const query = search.value.trim().toLowerCase();
   let matching = 0;
   document.querySelectorAll('.client-item').forEach(item => {
     const visible = item.dataset.search.includes(query);
     item.classList.toggle('hidden', !visible);
     if (visible) matching += 1;
   });
   document.getElementById('noClientMatches').classList.toggle('hidden', matching > 0 || !query);
 });
})();
</script>
