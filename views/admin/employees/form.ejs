<div class="mb-8 flex items-center">
    <a href="/admin/employees" class="mr-4 text-stone-400 hover:text-stone-600 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
    </a>
    <div>
        <h1 class="text-3xl font-bold text-stone-900"><%= isEdit ? 'Edit Employee' : 'Add New Employee' %></h1>
        <p class="text-stone-500 mt-1"><%= isEdit ? 'Update staff details below.' : 'Grant access to the E-man system.' %></p>
    </div>
</div>

<div class="bg-white border border-stone-200 rounded-xl shadow-sm p-8 max-w-2xl">
    <form action="/admin/employees/save" method="POST">
        <% if (isEdit) { %>
            <input type="hidden" name="id" value="<%= employee.id %>">
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label class="block text-stone-700 text-sm font-bold mb-2">Full Name</label>
                <input type="text" name="name" value="<%= isEdit ? employee.name : '' %>" required class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
            </div>
            
            <div>
                <label class="block text-stone-700 text-sm font-bold mb-2">Email Address</label>
                <input type="email" name="email" value="<%= isEdit ? employee.email : '' %>" required class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
            </div>
        </div>

        <div class="mb-6">
            <label class="block text-stone-700 text-sm font-bold mb-2">System Role</label>
            <select name="role" required class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
                <option value="superadmin" <%= isEdit && employee.role === 'superadmin' ? 'selected' : '' %>>Superadmin (Full Access)</option>
                <option value="admin" <%= isEdit && employee.role === 'admin' ? 'selected' : '' %>>Admin (Manager)</option>
                <option value="employee" <%= isEdit && employee.role === 'employee' ? 'selected' : '' %>>Employee (Restricted)</option>
            </select>
        </div>

        <div class="mb-8">
            <label class="block text-stone-700 text-sm font-bold mb-2">
                Password 
                <% if (isEdit) { %> <span class="text-stone-400 font-normal text-xs ml-2">(Leave blank to keep current password)</span> <% } %>
            </label>
            <input type="password" name="password" <%= isEdit ? '' : 'required' %> class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
        </div>

        <div class="flex justify-end pt-4 border-t border-stone-100">
            <a href="/admin/employees" class="px-6 py-2.5 text-stone-600 hover:bg-stone-100 font-medium rounded-lg transition-colors mr-3">Cancel</a>
            <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg shadow-sm transition-colors">
                <%= isEdit ? 'Update Employee' : 'Create Employee' %>
            </button>
        </div>
    </form>
</div>