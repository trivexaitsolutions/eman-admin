<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-6 md:mb-8">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Manage Staff</h1>
        <p class="text-sm text-stone-500 mt-1">Add, edit, or remove access to the E-man Control Center.</p>
    </div>
    <a href="/admin/employees/create" class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm hover:shadow-md transition-all">
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Add Employee
    </a>
</div>

<div class="grid grid-cols-1 gap-4 md:hidden">
    <% employees.forEach(emp => { %>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-stone-200 flex flex-col gap-4">
            
            <div class="flex justify-between items-start">
                <div class="flex items-center gap-3">
                    <div class="h-12 w-12 rounded-full bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-600 font-bold uppercase shadow-sm shrink-0">
                        <%= emp.name.charAt(0) %>
                    </div>
                    <div class="truncate">
                        <p class="font-bold text-stone-900 truncate"><%= emp.name %></p>
                        <p class="text-xs text-stone-500 truncate"><%= emp.email %></p>
                    </div>
                </div>
                
                <span class="inline-flex items-center px-2 py-1 rounded-md text-[10px] font-bold tracking-wider uppercase border shrink-0
                    <%= emp.role === 'superadmin' ? 'bg-purple-50 text-purple-700 border-purple-200' : 
                       emp.role === 'admin' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 
                       'bg-stone-50 text-stone-700 border-stone-200' %>">
                    <%= emp.role %>
                </span>
            </div>

            <div class="flex justify-end gap-2 border-t border-stone-100 pt-3">
                <a href="/admin/employees/edit/<%= emp.id %>" class="flex-1 inline-flex justify-center items-center px-3 py-2 text-sm font-medium rounded-lg text-emerald-700 bg-emerald-50 border border-emerald-100 active:bg-emerald-100 transition-colors">
                    Edit
                </a>
                
                <% if (user.id !== emp.id) { %>
                    <a href="/admin/employees/delete/<%= emp.id %>" onclick="return confirm('Remove <%= emp.name %>?')" class="flex-1 inline-flex justify-center items-center px-3 py-2 text-sm font-medium rounded-lg text-red-700 bg-red-50 border border-red-100 active:bg-red-100 transition-colors">
                        Delete
                    </a>
                <% } else { %>
                    <div class="flex-1 inline-flex justify-center items-center px-3 py-2 text-sm font-medium rounded-lg text-stone-400 bg-stone-50 border border-stone-100 cursor-not-allowed">
                        You
                    </div>
                <% } %>
            </div>
            
        </div>
    <% }) %>

    <% if (employees.length === 0) { %>
        <div class="bg-white p-8 rounded-2xl border border-stone-200 text-center">
            <p class="text-sm font-semibold text-stone-900">No employees found</p>
        </div>
    <% } %>
</div>

<div class="hidden md:block bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-left whitespace-nowrap">
        <thead class="bg-stone-50 border-b border-stone-200">
            <tr>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">Employee</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider">System Role</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase tracking-wider text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
            <% employees.forEach(emp => { %>
                <tr class="hover:bg-stone-50 transition-colors group">
                    <td class="px-6 py-4">
                        <div class="flex items-center">
                            <div class="h-10 w-10 flex-shrink-0 rounded-full bg-stone-100 border border-stone-200 flex items-center justify-center text-stone-600 font-bold uppercase shadow-sm">
                                <%= emp.name.charAt(0) %>
                            </div>
                            <div class="ml-4">
                                <div class="text-sm font-semibold text-stone-900"><%= emp.name %></div>
                                <div class="text-sm text-stone-500"><%= emp.email %></div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold tracking-wide uppercase border
                            <%= emp.role === 'superadmin' ? 'bg-purple-50 text-purple-700 border-purple-200' : 
                               emp.role === 'admin' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 
                               'bg-stone-50 text-stone-700 border-stone-200' %>">
                            <%= emp.role %>
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex justify-end space-x-2">
                            <a href="/admin/employees/edit/<%= emp.id %>" class="p-2 rounded-lg text-stone-400 hover:text-emerald-600 hover:bg-emerald-50 transition-colors">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
                            </a>
                            <% if (user.id !== emp.id) { %>
                                <a href="/admin/employees/delete/<%= emp.id %>" class="p-2 rounded-lg text-stone-400 hover:text-red-600 hover:bg-red-50 transition-colors">
                                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
                                </a>
                            <% } %>
                        </div>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>