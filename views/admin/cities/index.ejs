<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 md:text-3xl">Master: Cities</h1>
    <p class="mt-1 text-sm text-stone-500">Manage the City master. Every City belongs to one State / Union Territory.</p>
  </div>
  <a href="/admin/cities/create" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
    <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
    Add City
  </a>
</div>

<% if (success) { %>
  <div class="mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800"><%= success %></div>
<% } %>

<% if (error) { %>
  <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"><%= error %></div>
<% } %>

<div class="mb-5 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
  <strong>Current flow:</strong> City has a required State / UT. While adding a Naka, Admin selects State first and then selects a City from that State. PIN-code lookup will be added later through an API.
</div>

<% if (cities.length === 0) { %>
  <div class="rounded-2xl border border-dashed border-stone-300 bg-white px-6 py-14 text-center">
    <h2 class="text-lg font-bold text-stone-800">No Cities found</h2>
    <p class="mt-1 text-sm text-stone-500">Create a City with its State before adding Nakas.</p>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 gap-4 md:hidden">
    <% cities.forEach(city => { %>
      <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p class="font-bold text-stone-900"><%= city.name %></p>
            <p class="mt-1 text-xs <%= city.state ? 'text-stone-500' : 'font-semibold text-red-600' %>"><%= city.state ? `${city.state.name} (${city.state.code})` : 'State missing — edit this legacy City' %></p>
          </div>
          <span class="rounded-lg bg-stone-100 px-2 py-1 text-xs font-bold text-stone-700"><%= city._count.nakas %> Nakas</span>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2 border-t border-stone-100 pt-3">
          <a href="/admin/cities/edit/<%= city.id %>" class="rounded-lg bg-stone-100 px-3 py-2 text-center text-xs font-bold text-stone-700 hover:bg-stone-200">Edit</a>
          <a href="/admin/cities/delete/<%= city.id %>" onclick="return confirm('Delete this City?')" class="rounded-lg bg-red-50 px-3 py-2 text-center text-xs font-bold text-red-700 hover:bg-red-100">Delete</a>
        </div>
      </article>
    <% }) %>
  </div>

  <div class="hidden overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm md:block">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[760px] text-left">
        <thead class="border-b border-stone-200 bg-stone-50">
          <tr>
            <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">City</th>
            <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">State / UT</th>
            <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">Nakas</th>
            <th class="px-6 py-4 text-right text-xs font-semibold uppercase text-stone-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% cities.forEach(city => { %>
            <tr class="hover:bg-stone-50">
              <td class="px-6 py-4 font-bold text-stone-900"><%= city.name %></td>
              <td class="px-6 py-4 text-sm <%= city.state ? 'text-stone-600' : 'font-semibold text-red-600' %>"><%= city.state ? `${city.state.name} (${city.state.code})` : 'State missing — edit legacy City' %></td>
              <td class="px-6 py-4 text-sm font-semibold text-stone-700"><%= city._count.nakas %></td>
              <td class="px-6 py-4 text-right">
                <div class="flex justify-end gap-2">
                  <a href="/admin/cities/edit/<%= city.id %>" class="rounded-lg px-3 py-2 text-xs font-bold text-emerald-700 hover:bg-emerald-50">Edit</a>
                  <a href="/admin/cities/delete/<%= city.id %>" onclick="return confirm('Delete this City?')" class="rounded-lg px-3 py-2 text-xs font-bold text-red-700 hover:bg-red-50">Delete</a>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
