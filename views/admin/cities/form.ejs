<div class="mb-8 flex items-center">
    <a href="/admin/cities" class="mr-4 text-stone-400 hover:text-stone-600 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
    </a>
    <div>
        <h1 class="text-3xl font-bold text-stone-900"><%= isEdit ? 'Edit City' : 'Add New City' %></h1>
    </div>
</div>

<div class="bg-white border border-stone-200 rounded-xl shadow-sm p-8 max-w-lg">
    <form action="/admin/cities/save" method="POST">
        <% if (isEdit) { %> <input type="hidden" name="id" value="<%= city.id %>"> <% } %>

        <div class="mb-6">
            <label class="block text-stone-700 text-sm font-bold mb-2">City Name</label>
            <input type="text" name="name" value="<%= isEdit ? city.name : '' %>" required placeholder="e.g., Mumbai, Pune" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
        </div>

        <div class="flex justify-end pt-4 border-t border-stone-100">
            <a href="/admin/cities" class="px-6 py-2.5 text-stone-600 hover:bg-stone-100 font-medium rounded-lg mr-3">Cancel</a>
            <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg">
                <%= isEdit ? 'Update City' : 'Create City' %>
            </button>
        </div>
    </form>
</div>