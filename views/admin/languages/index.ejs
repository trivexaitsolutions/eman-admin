<div class="max-w-6xl mx-auto space-y-6 pb-16">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-700 mb-2">PHASE 1 · ADMIN</div>
      <h1 class="text-3xl font-bold text-stone-900">Language Master</h1>
      <p class="mt-1 text-sm text-stone-500">Manage supported languages. English always remains the default and active language.</p>
    </div>
    <a href="/admin/translations" class="rounded-xl bg-emerald-600 px-5 py-3 text-center text-sm font-bold text-white hover:bg-emerald-700">Open Translation Queue →</a>
  </div>
  <% if (success) { %><div role="status" class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-sm font-semibold text-emerald-800"><%= success %></div><% } %>
  <% if (error) { %><div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800"><%= error %></div><% } %>

  <div class="rounded-2xl border border-blue-200 bg-blue-50 p-4 text-sm text-blue-900">
    <strong>How Phase 1 works:</strong> A language can be added or activated here and translated content prepared in the Admin panel. Customer/Worker Android app language switching is part of <strong>Phase 2</strong>; enabling a language here does not change the current APK yet.
  </div>

  <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <div class="flex items-center justify-between gap-2 mb-5"><h2 class="text-lg font-bold text-stone-900">Configured languages</h2><span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-stone-600"><%= languages.length %> languages</span></div>
    <div class="space-y-3">
      <% for (const lang of languages) { %>
        <form method="post" action="/admin/languages/<%= encodeURIComponent(lang.code) %>" class="grid grid-cols-1 gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 md:grid-cols-[100px_1fr_1fr_90px_100px_100px] md:items-end">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div><label class="block text-xs font-semibold text-stone-500 mb-1">Code</label><div class="rounded-lg border border-stone-200 bg-white px-3 py-2.5 font-mono font-bold"><%= lang.code %></div></div>
          <div><label for="name-<%= lang.code %>" class="block text-xs font-semibold text-stone-500 mb-1">Language name</label><input id="name-<%= lang.code %>" required maxlength="80" name="name" value="<%= lang.name %>" <%= lang.code === 'en' ? 'readonly' : '' %> class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm"></div>
          <div><label for="native-<%= lang.code %>" class="block text-xs font-semibold text-stone-500 mb-1">Native name</label><input id="native-<%= lang.code %>" required maxlength="80" name="nativeName" value="<%= lang.nativeName %>" <%= lang.code === 'en' ? 'readonly' : '' %> class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm"></div>
          <div><label for="order-<%= lang.code %>" class="block text-xs font-semibold text-stone-500 mb-1">Order</label><input id="order-<%= lang.code %>" type="number" min="0" max="9999" name="sortOrder" value="<%= lang.sortOrder %>" <%= lang.code === 'en' ? 'readonly' : '' %> class="w-full rounded-lg border border-stone-300 px-3 py-2.5 text-sm"></div>
          <div class="flex flex-col gap-1"><label class="text-xs font-semibold text-stone-500">Visibility</label><label class="inline-flex items-center gap-2 rounded-lg bg-white px-3 py-2.5 text-sm font-semibold"><input type="checkbox" name="isActive" <%= lang.isActive ? 'checked' : '' %> <%= lang.code === 'en' ? 'disabled' : '' %> class="h-4 w-4 accent-emerald-600"> <%= lang.code === 'en' ? 'Default' : (lang.isActive ? 'Active' : 'Inactive') %></label></div>
          <button type="submit" class="rounded-lg bg-stone-900 px-3 py-2.5 font-bold text-white hover:bg-stone-700">Save</button>
        </form>
      <% } %>
    </div>
    <p class="mt-4 text-xs text-stone-500">Disabling a language hides it from the future mobile selector, but does not delete its translations. Code cannot be changed after creation.</p>
  </section>

  <section class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-bold text-stone-900 mb-1">Add a new language</h2>
    <p class="mb-4 text-sm text-stone-500">Example: Gujarati → <code class="rounded bg-stone-100 px-1">gu</code> · ગુજરાતી. Keep it inactive until all important UI text is ready in Phase 2.</p>
    <form method="post" action="/admin/languages" class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div><label for="new-code" class="block text-xs font-semibold text-stone-700 mb-1">Language code *</label><input id="new-code" required pattern="[a-z]{2,3}(-[A-Z]{2})?" maxlength="12" name="code" placeholder="gu" class="w-full rounded-xl border border-stone-300 px-3 py-3 text-sm"></div>
      <div><label for="new-name" class="block text-xs font-semibold text-stone-700 mb-1">English name *</label><input id="new-name" required maxlength="80" name="name" placeholder="Gujarati" class="w-full rounded-xl border border-stone-300 px-3 py-3 text-sm"></div>
      <div><label for="new-native" class="block text-xs font-semibold text-stone-700 mb-1">Native name *</label><input id="new-native" required maxlength="80" name="nativeName" placeholder="ગુજરાતી" class="w-full rounded-xl border border-stone-300 px-3 py-3 text-sm"></div>
      <div><label for="new-order" class="block text-xs font-semibold text-stone-700 mb-1">Sort order</label><input id="new-order" type="number" min="0" max="9999" name="sortOrder" value="100" class="w-full rounded-xl border border-stone-300 px-3 py-3 text-sm"></div>
      <div class="flex items-center gap-2 sm:col-span-2 xl:col-span-3"><label class="inline-flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="isActive" class="h-4 w-4 accent-emerald-600"> Activate now (Phase 2 app visibility)</label></div>
      <button type="submit" class="rounded-xl bg-emerald-600 px-5 py-3 font-bold text-white hover:bg-emerald-700">Create language</button>
    </form>
  </section>
</div>
