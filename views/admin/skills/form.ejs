<div class="mb-8 flex items-center">
    <a href="/admin/skills" class="mr-4 text-stone-400 hover:text-stone-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
    </a>
    <h1 class="text-3xl font-bold text-stone-900"><%= isEdit ? 'Edit Skill' : 'Add New Skill' %></h1>
</div>

<div class="bg-white border border-stone-200 rounded-xl shadow-sm p-8 max-w-4xl">
    <% if (error) { %>
        <div class="bg-red-50 text-red-700 p-4 rounded-lg mb-6 text-sm font-medium"><%= error %></div>
    <% } %>

    <form action="/admin/skills/save" method="POST">
        <% if (isEdit) { %> <input type="hidden" name="id" value="<%= skill.id %>"> <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
            <div class="space-y-5">
                <h3 class="text-lg font-semibold text-stone-800 border-b border-stone-100 pb-2">Basic Details</h3>
                
                <div>
                    <label class="block text-stone-700 text-sm font-bold mb-2">Skill Name</label>
                    <input type="text" name="name" value="<%= isEdit ? skill.name : '' %>" required class="w-full px-4 py-2 bg-stone-50 border border-stone-200 rounded-lg outline-none focus:border-emerald-500">
                </div>

                <div>
                    <label class="block text-stone-700 text-sm font-bold mb-2">Description</label>
                    <textarea name="description" rows="3" class="w-full px-4 py-2 bg-stone-50 border border-stone-200 rounded-lg outline-none focus:border-emerald-500 resize-none"><%= isEdit ? skill.description : '' %></textarea>
                </div>

                <label class="flex items-center cursor-pointer mt-4">
                    <input type="checkbox" name="isActive" class="w-5 h-5 text-emerald-600 rounded" <%= skill.isActive ? 'checked' : '' %>>
                    <span class="ml-3 text-stone-700 text-sm font-bold">Skill is Active</span>
                </label>
            </div>

            <div class="space-y-5">
                <div class="flex justify-between items-end border-b border-stone-100 pb-2">
                    <h3 class="text-lg font-semibold text-stone-800">Pricing Tiers</h3>
                    <button type="button" onclick="addTier()" class="text-sm text-emerald-600 hover:text-emerald-700 font-bold">+ Add Tier</button>
                </div>
                
                <div id="tiersContainer" class="space-y-3">
                    <% if (isEdit && skill.rates.length > 0) { %>
                        <% skill.rates.forEach(rate => { %>
                            <div class="flex gap-4 items-center">
                                <div class="flex-1">
                                    <label class="text-xs font-bold text-stone-500">Stars (e.g., 3.5)</label>
                                    <input type="number" step="0.5" name="stars[]" value="<%= rate.star %>" required class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg">
                                </div>
                                <div class="flex-1">
                                    <label class="text-xs font-bold text-stone-500">Rate (₹)</label>
                                    <input type="number" name="rates[]" value="<%= rate.rate %>" required class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg">
                                </div>
                                <button type="button" onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600 mt-5">✖</button>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <% [1, 2, 3, 4, 5].forEach(star => { %>
                            <div class="flex gap-4 items-center">
                                <div class="flex-1">
                                    <label class="text-xs font-bold text-stone-500">Stars</label>
                                    <input type="number" step="0.5" name="stars[]" value="<%= star %>" required class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg">
                                </div>
                                <div class="flex-1">
                                    <label class="text-xs font-bold text-stone-500">Rate (₹)</label>
                                    <input type="number" name="rates[]" placeholder="e.g. 500" required class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg">
                                </div>
                                <button type="button" onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600 mt-5">✖</button>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="flex justify-end pt-4 border-t border-stone-100">
            <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg">Save Skill & Rates</button>
        </div>
    </form>
</div>

<script>
function addTier() {
    const container = document.getElementById('tiersContainer');
    const row = document.createElement('div');
    row.className = 'flex gap-4 items-center';
    row.innerHTML = `
        <div class="flex-1">
            <input type="number" step="0.5" name="stars[]" placeholder="Stars" required class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg">
        </div>
        <div class="flex-1">
            <input type="number" name="rates[]" placeholder="Rate (₹)" required class="w-full px-3 py-2 bg-stone-50 border border-stone-200 rounded-lg">
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-red-400 hover:text-red-600">✖</button>
    `;
    container.appendChild(row);
}
</script>