<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-6 md:mb-8">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Master: Skills</h1>
        <p class="text-sm text-stone-500 mt-1">Manage labor categories and dynamic star-based pricing tiers.</p>
    </div>
    <a href="/admin/skills/create" class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-all">
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Add Skill
    </a>
</div>

<div class="grid grid-cols-1 gap-4 md:hidden">
    <% skills.forEach(skill => { %>
        <% 
           let rangeText = "No rates set";
           if(skill.rates && skill.rates.length > 0) {
               const lowest = skill.rates[0].rate;
               const highest = skill.rates[skill.rates.length - 1].rate;
               rangeText = `₹${lowest} → ₹${highest}`;
           }
        %>
        
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-stone-200 flex flex-col gap-3 <%= skill.isActive ? 'opacity-100' : 'opacity-60' %>">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-bold text-stone-900"><%= skill.name %></p>
                    <p class="text-xs text-stone-500 mt-0.5"><%= skill.isActive ? '🟢 Active' : '🔴 Inactive' %></p>
                </div>
                <span class="bg-stone-100 text-stone-600 text-[10px] font-bold px-2 py-1 rounded-md border border-stone-200"><%= rangeText %></span>
            </div>
            <div class="flex gap-2 border-t border-stone-100 pt-3">
                <a href="/admin/skills/edit/<%= skill.id %>" class="flex-1 text-center py-2 text-sm font-medium text-emerald-700 bg-emerald-50 rounded-lg">Edit</a>
                <a href="/admin/skills/delete/<%= skill.id %>" onclick="return confirm('Delete this Skill?')" class="flex-1 text-center py-2 text-sm font-medium text-red-700 bg-red-50 rounded-lg">Delete</a>
            </div>
        </div>
    <% }) %>

    <% if (skills.length === 0) { %>
        <div class="bg-white p-8 rounded-2xl border border-stone-200 text-center">
            <p class="text-sm font-semibold text-stone-900">No skills found</p>
        </div>
    <% } %>
</div>

<div class="hidden md:block bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-left whitespace-nowrap">
        <thead class="bg-stone-50 border-b border-stone-200">
            <tr>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Skill Name</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Pricing Tiers</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Status</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
            <% skills.forEach(skill => { %>
                <% 
                   let rangeText = "No rates set";
                   if(skill.rates && skill.rates.length > 0) {
                       const lowest = skill.rates[0].rate;
                       const highest = skill.rates[skill.rates.length - 1].rate;
                       rangeText = `₹${lowest} → ₹${highest}`;
                   }
                %>
                <tr class="hover:bg-stone-50 transition-colors group <%= !skill.isActive ? 'opacity-60 bg-stone-50/50' : '' %>">
                    <td class="px-6 py-4">
                        <p class="font-bold text-stone-900"><%= skill.name %></p>
                        <p class="text-xs text-stone-500"><%= skill.rates ? skill.rates.length : 0 %> Tiers Configured</p>
                    </td>
                    <td class="px-6 py-4 text-stone-600 font-mono text-sm"><%= rangeText %></td>
                    <td class="px-6 py-4">
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold uppercase border <%= skill.isActive ? 'bg-emerald-50 text-emerald-700 border-emerald-200' : 'bg-red-50 text-red-700 border-red-200' %>">
                            <%= skill.isActive ? 'Active' : 'Inactive' %>
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right space-x-2">
                        <a href="/admin/skills/edit/<%= skill.id %>" class="text-stone-400 hover:text-emerald-600 font-medium text-sm">Edit</a>
                        <a href="/admin/skills/delete/<%= skill.id %>" onclick="return confirm('Delete this Skill?')" class="text-stone-400 hover:text-red-600 font-medium text-sm">Delete</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>