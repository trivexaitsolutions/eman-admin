<div class="mb-8 flex items-center">
    <a href="/admin/nakas" class="mr-4 text-stone-400 hover:text-stone-600 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
    </a>
    <div>
        <h1 class="text-3xl font-bold text-stone-900"><%= isEdit ? 'Edit Naka' : 'Add New Naka' %></h1>
    </div>
</div>

<div class="bg-white border border-stone-200 rounded-xl shadow-sm p-8 max-w-lg">
    <form action="/admin/nakas/save" method="POST">
        <% if (isEdit) { %> <input type="hidden" name="id" value="<%= naka.id %>"> <% } %>

        <div class="mb-5">
            <label class="block text-stone-700 text-sm font-bold mb-2">City <span class="text-red-500">*</span></label>
            <select name="cityId" required class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
                <option value="" disabled <%= !isEdit ? 'selected' : '' %>>-- Select City --</option>
                <% cities.forEach(city => { %>
                    <option value="<%= city.id %>" <%= isEdit && naka.cityId === city.id ? 'selected' : '' %>>
                        <%= city.name %>
                    </option>
                <% }) %>
            </select>
            <% if(cities.length === 0) { %>
                <p class="text-xs text-red-500 mt-2">You must create a City first before adding a Naka!</p>
            <% } %>
        </div>

        <div class="mb-5">
            <label class="block text-stone-700 text-sm font-bold mb-2">Naka Name <span class="text-red-500">*</span></label>
            <input type="text" name="name" value="<%= isEdit ? naka.name : '' %>" required placeholder="e.g., Station Road Naka" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
        </div>

        <div class="mb-8">
            <label class="block text-stone-700 text-sm font-bold mb-2">Pincode</label>
            <input type="text" name="pincode" value="<%= isEdit ? naka.pincode : '' %>" placeholder="e.g., 421201" class="w-full px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-lg focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 outline-none text-stone-700">
        </div>

        <div class="form-group mb-4">
    <label class="block text-sm font-bold mb-2">Map par location select karein</label>
    <div id="map" style="height: 300px; width: 100%; border-radius: 8px; z-index: 1;"></div>
</div>

<div class="flex gap-4 mb-4">
    <div class="flex-1">
        <label>Latitude</label>
        <input type="text" id="latitude" name="latitude" value="<%= naka.latitude || '' %>" class="form-control" readonly>
    </div>
    <div class="flex-1">
        <label>Longitude</label>
        <input type="text" id="longitude" name="longitude" value="<%= naka.longitude || '' %>" class="form-control" readonly>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // Map setup
    var lat = <%= naka.latitude || 19.2183 %>; // Default: Kalyan/Dombivli lat
    var lng = <%= naka.longitude || 73.0867 %>; // Default: Kalyan/Dombivli lng

    var map = L.map('map').setView([lat, lng], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    var marker = L.marker([lat, lng]).addTo(map);

    // Click karne par marker move karna aur inputs update karna
    map.on('click', function(e) {
        marker.setLatLng(e.latlng);
        document.getElementById('latitude').value = e.latlng.lat.toFixed(6);
        document.getElementById('longitude').value = e.latlng.lng.toFixed(6);
    });
</script>

        <div class="flex justify-end pt-4 border-t border-stone-100">
            <a href="/admin/nakas" class="px-6 py-2.5 text-stone-600 hover:bg-stone-100 font-medium rounded-lg mr-3">Cancel</a>
            <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg" <%= cities.length === 0 ? 'disabled' : '' %>>
                <%= isEdit ? 'Update Naka' : 'Create Naka' %>
            </button>
        </div>
    </form>
</div>