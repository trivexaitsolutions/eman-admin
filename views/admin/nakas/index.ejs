<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-6 md:mb-8">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Master: Nakas</h1>
        <p class="text-sm text-stone-500 mt-1">Manage the digital labor hubs across your cities.</p>
    </div>
    <a href="/admin/nakas/create" class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-all">
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Add Naka
    </a>
</div>

<div class="grid grid-cols-1 gap-4 md:hidden">
    <% nakas.forEach(naka => { %>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-stone-200 flex flex-col gap-3">
            <div class="flex justify-between items-start">
                <div>
                    <p class="font-bold text-stone-900"><%= naka.name %></p>
                    <p class="text-xs text-stone-500 mt-0.5"><%= naka.city.name %> • Pin: <%= naka.pincode || 'N/A' %></p>
                </div>
                <span class="bg-emerald-50 text-emerald-700 text-[10px] font-bold px-2 py-1 rounded-md border border-emerald-200"><%= naka._count.workers %> Workers</span>
            </div>
            <div class="flex gap-2 border-t border-stone-100 pt-3">
                <a href="/admin/nakas/edit/<%= naka.id %>" class="flex-1 text-center py-2 text-sm font-medium text-emerald-700 bg-emerald-50 rounded-lg">Edit</a>
                <a href="/admin/nakas/delete/<%= naka.id %>" onclick="return confirm('Delete this Naka?')" class="flex-1 text-center py-2 text-sm font-medium text-red-700 bg-red-50 rounded-lg">Delete</a>
            </div>
        </div>
    <% }) %>
</div>

<div class="hidden md:block bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-left whitespace-nowrap">
        <thead class="bg-stone-50 border-b border-stone-200">
            <tr>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Naka Name</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">City</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Pincode</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
            <% nakas.forEach(naka => { %>
                <tr class="hover:bg-stone-50 transition-colors group">
                    <td class="px-6 py-4 font-bold text-stone-900"><%= naka.name %></td>
                    <td class="px-6 py-4 text-stone-600"><%= naka.city.name %></td>
                    <td class="px-6 py-4 text-stone-500"><%= naka.pincode || '--' %></td>
                    <td class="px-6 py-4 text-right">
                        <div class="flex justify-end space-x-2">
                            <a href="/admin/nakas/edit/<%= naka.id %>" class="p-2 text-stone-400 hover:text-emerald-600">Edit</a>
                            <a href="/admin/nakas/delete/<%= naka.id %>" onclick="return confirm('Delete this Naka?')" class="p-2 text-stone-400 hover:text-red-600">Delete</a>
                        </div>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>