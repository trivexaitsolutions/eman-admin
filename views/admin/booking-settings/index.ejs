<%- include('../../partials/toast') %>

<div class="mb-6 md:mb-8">
    <div class="flex items-center gap-3 mb-2">
        <div class="w-11 h-11 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m12 14a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
        </div>
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Booking Settings</h1>
            <p class="text-sm text-stone-500 mt-1">Choose how workers will be assigned to new customer bookings.</p>
        </div>
    </div>
</div>

<div class="max-w-4xl">
    <form action="/admin/booking-settings" method="POST" id="bookingSettingsForm">
        <div class="bg-white border border-stone-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-5 md:px-7 py-5 border-b border-stone-100 bg-stone-50/70">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-bold text-stone-900">Worker Assignment Mode</h2>
                        <p class="text-sm text-stone-500 mt-1">Only one mode can remain active at a time.</p>
                    </div>

                    <span id="currentModeBadge" class="inline-flex self-start items-center px-3 py-1.5 rounded-full text-xs font-bold border
                        <%= setting.assignmentMode === 'AUTO'
                            ? 'bg-blue-50 text-blue-700 border-blue-200'
                            : 'bg-emerald-50 text-emerald-700 border-emerald-200' %>">
                        Current: <%= setting.assignmentMode === 'AUTO' ? 'Automatic' : 'Customer Selection' %>
                    </span>
                </div>
            </div>

            <div class="p-5 md:p-7 space-y-4">
                <label class="block cursor-pointer group">
                    <input
                        type="radio"
                        name="assignmentMode"
                        value="AUTO"
                        class="peer sr-only"
                        <%= setting.assignmentMode === 'AUTO' ? 'checked' : '' %>
                    >

                    <div class="rounded-2xl border-2 border-stone-200 bg-white p-5 transition-all
                                group-hover:border-blue-300 group-hover:bg-blue-50/30
                                peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:shadow-sm">
                        <div class="flex items-start gap-4">
                            <div class="mt-0.5 w-11 h-11 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 5h8m-8 5h5M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z" />
                                </svg>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-base md:text-lg font-bold text-stone-900">Automatic Worker Assignment</h3>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">Existing Flow</span>
                                </div>
                                <p class="text-sm text-stone-600 mt-2 leading-6">
                                    The backend automatically selects available workers from the customer&apos;s selected Nakas. This keeps the current booking flow unchanged.
                                </p>
                            </div>

                            <div class="w-6 h-6 rounded-full border-2 border-stone-300 peer-checked:border-blue-600 flex items-center justify-center shrink-0 radio-indicator">
                                <span class="w-3 h-3 rounded-full bg-blue-600 hidden"></span>
                            </div>
                        </div>
                    </div>
                </label>

                <label class="block cursor-pointer group">
                    <input
                        type="radio"
                        name="assignmentMode"
                        value="CUSTOMER_SELECT"
                        class="peer sr-only"
                        <%= setting.assignmentMode === 'CUSTOMER_SELECT' ? 'checked' : '' %>
                    >

                    <div class="rounded-2xl border-2 border-stone-200 bg-white p-5 transition-all
                                group-hover:border-emerald-300 group-hover:bg-emerald-50/30
                                peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:shadow-sm">
                        <div class="flex items-start gap-4">
                            <div class="mt-0.5 w-11 h-11 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H2v-2a4 4 0 014-4h3m6-4a4 4 0 10-8 0 4 4 0 008 0zm4-4a3 3 0 11-6 0" />
                                </svg>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-base md:text-lg font-bold text-stone-900">Customer Selects Worker</h3>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-emerald-100 text-emerald-700">New Flow</span>
                                </div>
                                <p class="text-sm text-stone-600 mt-2 leading-6">
                                    After selecting Nakas, the customer will see matching available workers and choose the required workers before payment.
                                </p>
                            </div>

                            <div class="w-6 h-6 rounded-full border-2 border-stone-300 peer-checked:border-emerald-600 flex items-center justify-center shrink-0 radio-indicator">
                                <span class="w-3 h-3 rounded-full bg-emerald-600 hidden"></span>
                            </div>
                        </div>
                    </div>
                </label>

                <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3.5 flex items-start gap-3">
                    <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                    </svg>
                    <p class="text-sm text-amber-800 leading-6">
                        Saving this setting only stores the active mode. Until the customer app and booking API are connected in the next steps, the current automatic booking flow will continue safely.
                    </p>
                </div>
            </div>

            <div class="px-5 md:px-7 py-5 border-t border-stone-100 bg-stone-50 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
                <p class="text-xs text-stone-500">
                    Last updated: <%= new Date(setting.updatedAt).toLocaleString('en-IN') %>
                </p>

                <button
                    type="submit"
                    id="saveButton"
                    class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold shadow-sm transition-all disabled:opacity-60 disabled:cursor-not-allowed"
                >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Save Booking Mode
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    const form = document.getElementById('bookingSettingsForm');
    const saveButton = document.getElementById('saveButton');

    function updateRadioIndicators() {
        document.querySelectorAll('input[name="assignmentMode"]').forEach((radio) => {
            const card = radio.closest('label');
            const dot = card?.querySelector('.radio-indicator span');

            if (dot) {
                dot.classList.toggle('hidden', !radio.checked);
            }
        });
    }

    document.querySelectorAll('input[name="assignmentMode"]').forEach((radio) => {
        radio.addEventListener('change', updateRadioIndicators);
    });

    form.addEventListener('submit', () => {
        saveButton.disabled = true;
        saveButton.innerHTML = `
            <svg class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            Saving...
        `;
    });

    updateRadioIndicators();
</script>
