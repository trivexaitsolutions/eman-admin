<%- include('../../partials/toast') %>

<div class="mb-6 md:mb-8">
    <div class="flex items-center gap-3 mb-2">
        <div class="w-11 h-11 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m12 14a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
        </div>
        <div>
            <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Booking Settings</h1>
            <p class="text-sm text-stone-500 mt-1">Control worker assignment and the customer&apos;s nearby-Naka experience.</p>
        </div>
    </div>
</div>

<div class="max-w-4xl">
    <form action="/admin/booking-settings" method="POST" id="bookingSettingsForm">
        <div class="bg-white border border-stone-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="px-5 md:px-7 py-5 border-b border-stone-100 bg-stone-50/70">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                    <div>
                        <h2 class="text-lg font-bold text-stone-900">Worker Assignment Mode</h2>
                        <p class="text-sm text-stone-500 mt-1">Only one mode can remain active at a time.</p>
                    </div>

                    <span id="currentModeBadge" class="inline-flex self-start items-center px-3 py-1.5 rounded-full text-xs font-bold border
                        <%= setting.assignmentMode === 'AUTO'
                            ? 'bg-blue-50 text-blue-700 border-blue-200'
                            : 'bg-emerald-50 text-emerald-700 border-emerald-200' %>">
                        Current: <%= setting.assignmentMode === 'AUTO' ? 'Automatic' : 'Customer Selection' %>
                    </span>
                </div>
            </div>

            <div class="p-5 md:p-7 space-y-4">
                <label class="block cursor-pointer group">
                    <input
                        type="radio"
                        name="assignmentMode"
                        value="AUTO"
                        class="peer sr-only"
                        <%= setting.assignmentMode === 'AUTO' ? 'checked' : '' %>
                    >

                    <div class="rounded-2xl border-2 border-stone-200 bg-white p-5 transition-all
                                group-hover:border-blue-300 group-hover:bg-blue-50/30
                                peer-checked:border-blue-500 peer-checked:bg-blue-50 peer-checked:shadow-sm">
                        <div class="flex items-start gap-4">
                            <div class="mt-0.5 w-11 h-11 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 5h8m-8 5h5M5 3h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2z" />
                                </svg>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-base md:text-lg font-bold text-stone-900">Automatic Worker Assignment</h3>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-blue-100 text-blue-700">Existing Flow</span>
                                </div>
                                <p class="text-sm text-stone-600 mt-2 leading-6">
                                    The backend automatically assigns available workers from every verified Naka inside the configured work-location radius.
                                </p>
                            </div>

                            <div class="w-6 h-6 rounded-full border-2 border-stone-300 peer-checked:border-blue-600 flex items-center justify-center shrink-0 radio-indicator">
                                <span class="w-3 h-3 rounded-full bg-blue-600 hidden"></span>
                            </div>
                        </div>
                    </div>
                </label>

                <label class="block cursor-pointer group">
                    <input
                        type="radio"
                        name="assignmentMode"
                        value="CUSTOMER_SELECT"
                        class="peer sr-only"
                        <%= setting.assignmentMode === 'CUSTOMER_SELECT' ? 'checked' : '' %>
                    >

                    <div class="rounded-2xl border-2 border-stone-200 bg-white p-5 transition-all
                                group-hover:border-emerald-300 group-hover:bg-emerald-50/30
                                peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:shadow-sm">
                        <div class="flex items-start gap-4">
                            <div class="mt-0.5 w-11 h-11 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-4-4h-1M9 20H2v-2a4 4 0 014-4h3m6-4a4 4 0 10-8 0 4 4 0 008 0zm4-4a3 3 0 11-6 0" />
                                </svg>
                            </div>

                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-base md:text-lg font-bold text-stone-900">Customer Selects Worker</h3>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide bg-emerald-100 text-emerald-700">New Flow</span>
                                </div>
                                <p class="text-sm text-stone-600 mt-2 leading-6">
                                    The customer sees matching workers from every verified Naka inside the radius and chooses the required workers before payment.
                                </p>
                            </div>

                            <div class="w-6 h-6 rounded-full border-2 border-stone-300 peer-checked:border-emerald-600 flex items-center justify-center shrink-0 radio-indicator">
                                <span class="w-3 h-3 rounded-full bg-emerald-600 hidden"></span>
                            </div>
                        </div>
                    </div>
                </label>

                <div class="pt-5 border-t border-stone-100">
                    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
                        <div>
                            <h2 class="text-lg font-bold text-stone-900">Worker Pool & Pricing</h2>
                            <p class="text-sm text-stone-500 mt-1">Set the daily pool window, add as many pool start-times as required, and control rate reduction for each next pool.</p>
                        </div>
                        <span class="inline-flex self-start items-center rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 text-xs font-bold">Asia/Kolkata</span>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-4">
                    <label class="block rounded-2xl border border-stone-200 p-5">
                        <span class="block text-sm font-bold text-stone-800">Pool Start Time</span>
                        <input id="poolDayStart" type="time" name="poolDayStart" required value="<%= setting.poolDayStart || '08:00' %>" class="mt-3 w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none">
                        <span class="block text-xs text-stone-500 mt-2">Pool 1 always starts at this time.</span>
                    </label>

                    <label class="block rounded-2xl border border-stone-200 p-5">
                        <span class="block text-sm font-bold text-stone-800">Pool End Time</span>
                        <input id="poolDayEnd" type="time" name="poolDayEnd" required value="<%= setting.poolDayEnd || '20:00' %>" class="mt-3 w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none">
                        <span class="block text-xs text-stone-500 mt-2">All Full Day / short-work workers go offline at this daily pool end.</span>
                    </label>
                </div>

                <div class="rounded-2xl border border-stone-200 p-5">
                    <div class="flex items-center justify-between gap-3 mb-4">
                        <div>
                            <p class="font-bold text-stone-900">Pool Start Times</p>
                            <p class="text-sm text-stone-500 mt-1">Example: 08:00, 09:00, 10:00. A worker joins the latest active pool.</p>
                        </div>
                        <button type="button" id="addPoolButton" class="shrink-0 px-4 py-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200 text-sm font-bold hover:bg-emerald-100">+ Add Pool</button>
                    </div>

                    <div id="poolRows" class="space-y-3">
                        <% (setting.poolSlots || []).forEach((pool, index) => { %>
                            <div class="pool-row flex items-center gap-3 rounded-xl bg-stone-50 border border-stone-200 p-3">
                                <div class="w-20 shrink-0">
                                    <span class="pool-number text-sm font-bold text-stone-700">Pool <%= index + 1 %></span>
                                </div>
                                <input type="time" name="poolStartTimes" value="<%= pool.startTime %>" required class="pool-time flex-1 rounded-xl border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none" <%= index === 0 ? 'readonly' : '' %>>
                                <button type="button" class="remove-pool w-10 h-10 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 <%= index === 0 ? 'invisible pointer-events-none' : '' %>" aria-label="Remove pool">×</button>
                            </div>
                        <% }) %>
                    </div>

                    <div class="mt-4 rounded-xl bg-blue-50 border border-blue-100 px-4 py-3 text-sm text-blue-800">
                        Worker agar late join kare to usko current/latest pool milega, lekin daily pool end time same rahega.
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-4">
                    <div class="rounded-2xl border border-stone-200 p-5">
                        <span class="block text-sm font-bold text-stone-800 mb-3">Rate Reduction Type</span>
                        <div class="grid grid-cols-2 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="poolReductionType" value="FIXED" class="peer sr-only" <%= (setting.poolReductionType || 'FIXED') === 'FIXED' ? 'checked' : '' %>>
                                <div class="rounded-xl border-2 border-stone-200 p-3 text-center font-bold text-stone-700 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-700">Fixed ₹</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="poolReductionType" value="PERCENTAGE" class="peer sr-only" <%= setting.poolReductionType === 'PERCENTAGE' ? 'checked' : '' %>>
                                <div class="rounded-xl border-2 border-stone-200 p-3 text-center font-bold text-stone-700 peer-checked:border-emerald-500 peer-checked:bg-emerald-50 peer-checked:text-emerald-700">Percentage %</div>
                            </label>
                        </div>
                    </div>

                    <label class="block rounded-2xl border border-stone-200 p-5">
                        <span class="block text-sm font-bold text-stone-800">Reduction Per Next Pool</span>
                        <div class="mt-3 flex items-center gap-2">
                            <input type="number" min="0" step="0.01" name="poolReductionValue" required value="<%= Number(setting.poolReductionValue ?? 100) %>" class="w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none">
                        </div>
                        <span class="block text-xs text-stone-500 mt-2">Pool 1 = full base rate. Pool 2 onward reduces one step per pool.</span>
                    </label>
                </div>

                <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3.5">
                    <p class="text-sm font-bold text-emerald-900">Example</p>
                    <p class="text-sm text-emerald-800 mt-1 leading-6">Base ₹1000 + Fixed ₹100: Pool 1 ₹1000, Pool 2 ₹900, Pool 3 ₹800. Percentage mode applies the selected percentage step against the original base rate.</p>
                </div>

                <div class="pt-3 border-t border-stone-100">
                    <h2 class="text-lg font-bold text-stone-900">Customer Location & Nearby Nakas</h2>
                    <p class="text-sm text-stone-500 mt-1">Distance matching always runs on the backend using Haversine. Customers cannot manually change the Naka pool.</p>
                </div>

                <label class="flex items-center justify-between gap-4 rounded-2xl border border-stone-200 p-5 bg-stone-50/60">
                    <div>
                        <p class="font-bold text-stone-900">Show map to customer</p>
                        <p class="text-sm text-stone-500 mt-1">OFF shows a nearby-Naka list. ON shows the same Nakas as map markers.</p>
                    </div>
                    <span class="relative inline-flex items-center shrink-0">
                        <input
                            id="showMapToCustomer"
                            type="checkbox"
                            name="showMapToCustomer"
                            value="1"
                            class="peer sr-only"
                            <%= setting.showMapToCustomer ? 'checked' : '' %>
                        >
                        <span class="w-12 h-7 rounded-full bg-stone-300 peer-checked:bg-emerald-600 transition-colors"></span>
                        <span class="absolute left-1 w-5 h-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
                    </span>
                </label>

                <div class="grid md:grid-cols-2 gap-4">
                    <label class="block rounded-2xl border border-stone-200 p-5">
                        <span class="block text-sm font-bold text-stone-800">Nearby Naka radius (meters)</span>
                        <input
                            type="number"
                            name="nearbyNakaRadiusMeters"
                            required
                            step="1"
                            min="<%= minRadiusMeters %>"
                            max="<%= maxRadiusMeters %>"
                            value="<%= setting.nearbyNakaRadiusMeters %>"
                            class="mt-3 w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none"
                        >
                        <span class="block text-xs text-stone-500 mt-2">Example: 5000 meters = 5 km.</span>
                    </label>

                    <div class="rounded-2xl border border-stone-200 p-5">
                        <label for="mapApiKey" class="block text-sm font-bold text-stone-800">Map API key</label>
                        <input
                            id="mapApiKey"
                            type="password"
                            name="mapApiKey"
                            maxlength="500"
                            autocomplete="new-password"
                            placeholder="<%= hasMapApiKey ? 'Leave blank to keep saved key' : 'Enter map API key' %>"
                            class="mt-3 w-full rounded-xl border border-stone-300 px-4 py-3 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none"
                        >
                        <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
                            <span class="text-xs <%= hasMapApiKey ? 'text-emerald-700' : 'text-stone-500' %>">
                                <%= hasMapApiKey ? `Saved: ${mapApiKeyPreview}` : 'No key saved' %>
                            </span>
                            <% if (hasMapApiKey) { %>
                                <label class="inline-flex items-center gap-2 text-xs text-red-600 cursor-pointer">
                                    <input type="checkbox" name="clearMapApiKey" value="1" class="rounded border-stone-300">
                                    Clear saved key
                                </label>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3.5 flex items-start gap-3">
                    <svg class="w-5 h-5 text-amber-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                    </svg>
                    <p class="text-sm text-amber-800 leading-6">
                        A native Android Google Maps SDK key is embedded in the APK manifest. Saving a new key here updates central configuration, but the installed native APK must be rebuilt to use a changed native SDK key.
                    </p>
                </div>
            </div>

            <div class="px-5 md:px-7 py-5 border-t border-stone-100 bg-stone-50 flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-3">
                <p class="text-xs text-stone-500">
                    Last updated: <%= new Date(setting.updatedAt).toLocaleString('en-IN') %>
                </p>

                <button
                    type="submit"
                    id="saveButton"
                    class="inline-flex items-center justify-center w-full sm:w-auto px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold shadow-sm transition-all disabled:opacity-60 disabled:cursor-not-allowed"
                >
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    Save Booking Settings
                </button>
            </div>
        </div>
    </form>
</div>

<script>
    const form = document.getElementById('bookingSettingsForm');
    const saveButton = document.getElementById('saveButton');

    function updateRadioIndicators() {
        document.querySelectorAll('input[name="assignmentMode"]').forEach((radio) => {
            const card = radio.closest('label');
            const dot = card?.querySelector('.radio-indicator span');

            if (dot) {
                dot.classList.toggle('hidden', !radio.checked);
            }
        });
    }

    document.querySelectorAll('input[name="assignmentMode"]').forEach((radio) => {
        radio.addEventListener('change', updateRadioIndicators);
    });

    form.addEventListener('submit', () => {
        saveButton.disabled = true;
        saveButton.innerHTML = `
            <svg class="animate-spin w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
            Saving...
        `;
    });

    const poolRows = document.getElementById('poolRows');
    const addPoolButton = document.getElementById('addPoolButton');
    const poolDayStart = document.getElementById('poolDayStart');

    function renumberPools() {
        const rows = Array.from(poolRows.querySelectorAll('.pool-row'));
        rows.forEach((row, index) => {
            const number = row.querySelector('.pool-number');
            const remove = row.querySelector('.remove-pool');
            const input = row.querySelector('.pool-time');

            if (number) number.textContent = `Pool ${index + 1}`;
            if (index === 0) {
                if (input) {
                    input.value = poolDayStart.value;
                    input.readOnly = true;
                }
                remove?.classList.add('invisible', 'pointer-events-none');
            } else {
                if (input) input.readOnly = false;
                remove?.classList.remove('invisible', 'pointer-events-none');
            }
        });
    }

    addPoolButton?.addEventListener('click', () => {
        const row = document.createElement('div');
        row.className = 'pool-row flex items-center gap-3 rounded-xl bg-stone-50 border border-stone-200 p-3';
        row.innerHTML = `
            <div class="w-20 shrink-0"><span class="pool-number text-sm font-bold text-stone-700"></span></div>
            <input type="time" name="poolStartTimes" required class="pool-time flex-1 rounded-xl border border-stone-300 px-4 py-2.5 text-stone-900 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-100 outline-none">
            <button type="button" class="remove-pool w-10 h-10 rounded-xl border border-red-200 text-red-600 hover:bg-red-50" aria-label="Remove pool">×</button>
        `;
        poolRows.appendChild(row);
        renumberPools();
        row.querySelector('.pool-time')?.focus();
    });

    poolRows?.addEventListener('click', (event) => {
        const button = event.target.closest('.remove-pool');
        if (!button) return;
        button.closest('.pool-row')?.remove();
        renumberPools();
    });

    poolDayStart?.addEventListener('change', renumberPools);

    updateRadioIndicators();
    renumberPools();
</script>
