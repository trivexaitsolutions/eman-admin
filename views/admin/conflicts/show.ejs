<div class="space-y-6 max-w-7xl mx-auto pb-12">

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
        <div>
            <!-- Breadcrumb -->
            <nav class="flex items-center gap-2 text-sm font-medium text-stone-500 mb-2">
                <a href="/admin/conflicts" class="hover:text-stone-900 transition-colors flex items-center gap-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Conflicts
                </a>
                <span class="text-stone-300">/</span>
                <span class="text-stone-900 font-semibold">Review C#<%= conflict.id %></span>
            </nav>
            
            <div class="flex flex-wrap items-center gap-3 mt-1">
                <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">
                    Dispute Resolution
                </h1>
                
                <!-- Status Badge -->
                <% if (conflict.status === 'PENDING') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-yellow-50 text-yellow-700 border border-yellow-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 mr-2 animate-pulse"></span> Pending Review
                    </span>
                <% } else if (conflict.status === 'IN_PROGRESS') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 mr-2"></span> In Progress
                    </span>
                <% } else if (conflict.status === 'SOLVED') { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-2"></span> Solved
                    </span>
                <% } else { %>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-red-50 text-red-700 border border-red-200 shadow-sm">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-2"></span> Unresolved
                    </span>
                <% } %>
            </div>
            
            <p class="text-sm text-stone-500 mt-1.5">
                Managing dispute for Booking <span class="font-semibold text-stone-700">B#<%= conflict.bookingId %></span>
            </p>
        </div>
    </div>

    <!-- Top Financial Summary Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm flex flex-col justify-center">
            <p class="text-[11px] font-semibold text-stone-500 uppercase tracking-wider mb-1">Total Booking</p>
            <p class="text-2xl font-bold text-stone-900">₹<%= conflict.totalBookingAmount || 0 %></p>
        </div>

        <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm flex flex-col justify-center">
            <p class="text-[11px] font-semibold text-stone-500 uppercase tracking-wider mb-1">Per Worker</p>
            <p class="text-2xl font-bold text-stone-900">₹<%= conflict.perWorkerAmount || 0 %></p>
        </div>

        <div class="bg-rose-50 border border-rose-100 rounded-xl p-5 shadow-sm flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-rose-100 rounded-full opacity-50"></div>
            <p class="text-[11px] font-bold text-rose-600 uppercase tracking-wider mb-1 relative z-10">System Refund</p>
            <p class="text-2xl font-black text-rose-700 relative z-10">₹<%= conflict.suggestedRefundAmount || 0 %></p>
        </div>

        <div class="bg-orange-50 border border-orange-100 rounded-xl p-5 shadow-sm flex flex-col justify-center relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-16 h-16 bg-orange-100 rounded-full opacity-50"></div>
            <p class="text-[11px] font-bold text-orange-600 uppercase tracking-wider mb-1 relative z-10">System Penalty</p>
            <p class="text-2xl font-black text-orange-700 relative z-10">₹<%= conflict.penaltyAmount || 0 %></p>
        </div>
    </div>

    <!-- Main Content Layout (2/3 Left, 1/3 Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        <!-- ==========================================
             LEFT COLUMN (Larger Side - 2/3 Width)
             Details, Parties, and Resolution Form
        =========================================== -->
        <div class="lg:col-span-2 space-y-6">

            <!-- 1. Parties Involved (CRM Style Cards) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Client Card -->
                <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm flex items-start gap-4">
                    <div class="w-12 h-12 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg border border-blue-100 shrink-0">
                        C
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-0.5">Client</p>
                        <h3 class="text-base font-bold text-stone-900 truncate"><%= conflict.customer?.name || 'Unknown' %></h3>
                        <p class="text-sm text-stone-500 truncate mb-3"><%= conflict.customer?.email || 'No email provided' %></p>
                        
                        <% if (conflict.customer?.phone) { %>
                            <a href="tel:<%= conflict.customer.phone %>" class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 border border-blue-100 px-3 py-1.5 rounded-lg transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                <%= conflict.customer.phone %>
                            </a>
                        <% } %>
                    </div>
                </div>

                <!-- Worker Card -->
                <div class="bg-white border border-stone-200 rounded-xl p-5 shadow-sm flex items-start gap-4">
                    <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg border border-emerald-100 shrink-0">
                        W
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-[10px] font-bold text-stone-400 uppercase tracking-wider mb-0.5">Worker</p>
                        <h3 class="text-base font-bold text-stone-900 truncate"><%= conflict.worker?.name || 'Full Booking Issue' %></h3>
                        <p class="text-sm text-stone-500 truncate mb-3"><%= conflict.worker?.email || 'No email provided' %></p>
                        
                        <% if (conflict.worker?.phone) { %>
                            <a href="tel:<%= conflict.worker.phone %>" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-100 px-3 py-1.5 rounded-lg transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                <%= conflict.worker.phone %>
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- 2. Issue Core Information -->
            <div class="bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-stone-200 bg-stone-50/50 flex items-center gap-2">
                    <svg class="w-5 h-5 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <h2 class="text-base font-bold text-stone-800">Issue Details</h2>
                </div>
                
                <div class="p-6">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-6">
                        <div>
                            <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Raised By</p>
                            <% if (conflict.raisedByType === 'CLIENT') { %>
                                <span class="inline-flex items-center bg-blue-50 text-blue-700 px-2.5 py-1 rounded text-xs font-bold border border-blue-100">
                                    CLIENT
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center bg-orange-50 text-orange-700 px-2.5 py-1 rounded text-xs font-bold border border-orange-100">
                                    WORKER
                                </span>
                            <% } %>
                        </div>

                        <div>
                            <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Requested Action</p>
                            <span class="inline-flex items-center bg-stone-100 text-stone-800 px-2.5 py-1 rounded text-xs font-bold border border-stone-200">
                                <%= conflict.requestedAction || 'Not Specified' %>
                            </span>
                        </div>

                        <div>
                            <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Continue Work?</p>
                            <% if (conflict.continueWork) { %>
                                <span class="inline-flex items-center text-emerald-600 font-bold text-sm bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Yes
                                </span>
                            <% } else { %>
                                <span class="inline-flex items-center text-red-600 font-bold text-sm bg-red-50 px-2 py-0.5 rounded border border-red-100">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg> No
                                </span>
                            <% } %>
                        </div>
                    </div>

                    <div class="mb-6">
                        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Primary Reason</p>
                        <p class="text-base font-bold text-stone-900"><%= conflict.reason || 'No reason selected' %></p>
                    </div>

                    <div>
                        <p class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5">Detailed Description</p>
                        <div class="bg-stone-50 border border-stone-200 rounded-xl p-4 text-sm text-stone-700 leading-relaxed min-h-[80px]">
                            <%= conflict.description || 'No additional details provided by the user.' %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. Resolution Action Form (Moved to Left Side) -->
            <div class="bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden border-t-4 border-t-emerald-500">
                <div class="px-6 py-4 border-b border-stone-200 bg-emerald-50/30 flex items-center gap-2">
                    <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    <h2 class="text-base font-bold text-stone-900">Resolve Conflict</h2>
                </div>

                <form method="POST" action="/admin/conflicts/<%= conflict.id %>/status" class="p-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        
                        <!-- Status Dropdown -->
                        <div>
                            <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Update Status</label>
                            <select name="status" required class="w-full border border-stone-300 rounded-lg px-4 py-3 text-sm text-stone-900 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all cursor-pointer shadow-sm">
                                <option value="PENDING" <%= conflict.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
                                <option value="IN_PROGRESS" <%= conflict.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
                                <option value="SOLVED" <%= conflict.status === 'SOLVED' ? 'selected' : '' %>>Solved</option>
                                <option value="UNRESOLVED" <%= conflict.status === 'UNRESOLVED' ? 'selected' : '' %>>Unresolved</option>
                            </select>
                        </div>

                        <!-- Info/Calculation helper -->
                        <div class="bg-stone-50 border border-stone-200 rounded-lg p-3 text-xs flex flex-col justify-center">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-stone-500">Base Amount:</span>
                                <span class="font-bold text-stone-700">₹<%= conflict.totalBookingAmount || 0 %></span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-stone-500">System Refund:</span>
                                <span class="font-bold text-rose-600">₹<%= conflict.suggestedRefundAmount || 0 %></span>
                            </div>
                        </div>

                    </div>

                    <!-- Note Textarea -->
                    <div class="mb-6">
                        <label class="block text-xs font-semibold text-stone-500 uppercase tracking-wider mb-2">Admin Note (Mandatory)</label>
                        <textarea name="note" rows="3" required placeholder="Log your investigation details, manual refund processed (if any), and actions taken..." class="w-full border border-stone-300 rounded-lg px-4 py-3 text-sm text-stone-900 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-all resize-none shadow-sm"></textarea>
                    </div>

                    <div class="flex justify-end">
                        <button type="submit" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg px-8 py-3 text-sm transition-colors shadow-md flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Save Resolution Update
                        </button>
                    </div>
                </form>
            </div>

        </div>

        <!-- ==========================================
             RIGHT COLUMN (Smaller Side - 1/3 Width)
             Sticky Resolution Timeline
        =========================================== -->
        <div class="lg:col-span-1">
            
            <div class="bg-white border border-stone-200 rounded-xl shadow-sm sticky top-6 max-h-[calc(100vh-2rem)] overflow-y-auto">
                <div class="px-5 py-4 border-b border-stone-200 bg-stone-50/80 sticky top-0 z-10 flex justify-between items-center">
                    <h2 class="text-base font-bold text-stone-800 flex items-center gap-2">
                        <svg class="w-4 h-4 text-stone-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        Timeline
                    </h2>
                    <span class="text-[10px] font-bold text-stone-400 uppercase"><%= conflict.timeline ? conflict.timeline.length : 0 %> Updates</span>
                </div>

                <div class="p-5">
                    <% if (!conflict.timeline || conflict.timeline.length === 0) { %>
                        <div class="text-center py-10">
                            <div class="w-12 h-12 bg-stone-50 rounded-full flex items-center justify-center mx-auto mb-3">
                                <svg class="w-5 h-5 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                            </div>
                            <p class="text-sm text-stone-500 font-medium">No actions taken yet.</p>
                        </div>
                    <% } else { %>
                        <div class="relative pl-3 border-l-2 border-stone-100 space-y-6 ml-2">
                            <% conflict.timeline.forEach((item, index) => { %>
                                <div class="relative">
                                    <!-- Timeline Dot -->
                                    <div class="absolute -left-[30px] top-1.5 w-4 h-4 rounded-full bg-white border-[3px] border-stone-300"></div>
                                    
                                    <div class="ml-1">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1">
                                            <span class="text-[11px] font-bold text-stone-400 line-through"><%= item.oldStatus || 'NEW' %></span>
                                            <svg class="w-3 h-3 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                            <span class="text-xs font-bold text-stone-900"><%= item.newStatus %></span>
                                        </div>
                                        
                                        <div class="bg-stone-50 border border-stone-100 rounded-lg p-3 mt-2">
                                            <p class="text-sm text-stone-700 leading-snug"><%= item.note || 'No notes added.' %></p>
                                        </div>
                                        
                                        <div class="flex items-center justify-between mt-2 text-[10px] font-semibold text-stone-400 uppercase tracking-wider">
                                            <span><%= item.updatedByType || 'SYSTEM' %></span>
                                            <span><%= new Date(item.createdAt).toLocaleString('en-IN', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>

    </div>
</div>