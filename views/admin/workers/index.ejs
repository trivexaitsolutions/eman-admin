<div class="flex flex-col gap-3 sm:flex-row sm:justify-between sm:items-center mb-6">
  <div><h1 class="text-2xl md:text-3xl font-bold text-stone-900">Manage Workers</h1>
  <p class="text-sm text-stone-500 mt-1">Worker status, contact and assigned Mitra.</p></div>
  <div class="flex flex-wrap gap-2">
    <a href="/admin/workers" class="inline-flex items-center justify-center rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-semibold text-stone-700">Refresh Status</a>
    <a href="/admin/workers/create" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl">+ Register Worker</a>
  </div>
</div>
<div class="rounded-xl bg-white border border-stone-200 px-4 py-3 mb-4">
 <label for="workerSearch" class="text-xs font-semibold text-stone-500">Search Worker</label>
 <input type="search" id="workerSearch" autocomplete="off" placeholder="Name, phone, email or Mitra" class="mt-1 w-full rounded-lg border border-stone-200 bg-stone-50 px-3 py-2.5 outline-none focus:border-emerald-500" />
</div>
<p class="text-xs text-stone-500 mb-4">Online = available in current pool. In Booking = assigned to active work. Refresh to see latest statuses.</p>
<div class="grid grid-cols-1 gap-3 md:hidden">
<% workers.forEach(worker => { %>
  <div class="worker-item bg-white p-4 rounded-2xl shadow-sm border border-stone-200 <%= !worker.isActive ? 'opacity-70' : '' %>" data-search="<%= [worker.name, worker.phone, worker.email, worker.mitra?.name, worker.mitra?.phone].join(' ').toLowerCase() %>">
    <div class="flex items-start justify-between gap-2">
      <div class="flex items-center gap-3 min-w-0">
        <div class="w-11 h-11 flex shrink-0 items-center justify-center rounded-full bg-emerald-50 text-emerald-800 font-bold"><%= (worker.name || '?').charAt(0).toUpperCase() %></div>
        <div class="min-w-0"><p class="font-bold text-stone-900 break-words"><%= worker.name %></p><p class="text-xs text-stone-500">#<%= worker.id %> · <%= worker.nakas.length %> Nakas</p></div>
      </div>
      <div class="shrink-0"><%- include('../../partials/operational-status', { operationalStatus: worker.operationalStatus }) %></div>
    </div>
    <div class="grid grid-cols-2 gap-3 mt-4 text-sm">
      <div class="min-w-0"><p class="text-xs text-stone-400 font-semibold mb-1">Worker Contact</p><a class="block font-semibold text-stone-800" href="tel:<%= worker.phone %>"><%= worker.phone %></a><p class="text-xs text-stone-500 break-all"><%= worker.email || 'No email' %></p></div>
      <div class="min-w-0"><p class="text-xs text-stone-400 font-semibold mb-1">Assigned Mitra</p><p class="font-semibold text-stone-900"><%= worker.mitra?.name || 'Not Assigned' %></p>
        <% if (worker.mitra?.phone) { %><a class="text-xs text-emerald-700 font-medium" href="tel:<%= worker.mitra.phone %>"><%= worker.mitra.phone %></a><% } %></div>
    </div>
    <div class="flex flex-wrap items-center gap-1.5 mt-3">
      <% worker.skills.slice(0, 3).forEach(skill => { %><span class="text-xs px-2 py-1 rounded-md bg-stone-100 text-stone-600"><%= skill.name %></span><% }) %>
      <span class="ml-auto text-sm font-semibold text-amber-700">★ <%= worker.rating.averageRating.toFixed(1) %></span>
    </div>
    <div class="flex gap-2 pt-3 mt-3 border-t border-stone-100">
      <a href="/admin/workers/edit/<%= worker.id %>" class="flex-1 text-center py-2.5 rounded-lg bg-emerald-50 text-emerald-700 font-semibold">Edit</a>
      <% if (user && ['admin','superadmin'].includes(user.role)) { %>
        <a href="/admin/workers/delete/<%= worker.id %>" onclick="return confirm('Delete this Worker?')" class="flex-1 text-center py-2.5 rounded-lg bg-red-50 text-red-700 font-semibold">Delete</a>
      <% } %>
    </div>
  </div>
<% }) %>
</div>
<div class="hidden md:block bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
<table class="w-full text-left"><thead class="bg-stone-50 border-b border-stone-200"><tr>
  <th class="px-4 py-4 text-xs font-semibold text-stone-500 uppercase">Worker</th>
  <th class="px-4 py-4 text-xs font-semibold text-stone-500 uppercase">Phone / Email</th>
  <th class="px-4 py-4 text-xs font-semibold text-stone-500 uppercase">Status</th>
  <th class="px-4 py-4 text-xs font-semibold text-stone-500 uppercase">Assigned Mitra</th>
  <th class="px-4 py-4 text-xs font-semibold text-stone-500 uppercase">Skills / Rating</th>
  <th class="px-4 py-4 text-xs font-semibold text-stone-500 uppercase text-right">Actions</th>
</tr></thead><tbody class="divide-y divide-stone-100">
<% workers.forEach(worker => { %>
<tr class="worker-item hover:bg-stone-50 <%= !worker.isActive ? 'opacity-70' : '' %>" data-search="<%= [worker.name, worker.phone, worker.email, worker.mitra?.name, worker.mitra?.phone].join(' ').toLowerCase() %>">
 <td class="px-4 py-4"><div class="text-sm font-bold text-stone-900"><%= worker.name %></div><div class="text-xs text-stone-500">#<%= worker.id %> · <%= worker.nakas.length %> Nakas · Age: <%= worker.age %></div></td>
 <td class="px-4 py-4 text-sm"><a href="tel:<%= worker.phone %>" class="font-semibold text-stone-800"><%= worker.phone %></a><div class="text-xs text-stone-500 break-all"><%= worker.email || 'No email' %></div></td>
 <td class="px-4 py-4"><%- include('../../partials/operational-status', { operationalStatus: worker.operationalStatus }) %></td>
 <td class="px-4 py-4 text-sm"><div class="font-semibold text-stone-800"><%= worker.mitra?.name || 'Not Assigned' %></div><% if (worker.mitra?.phone) { %><a href="tel:<%= worker.mitra.phone %>" class="text-xs font-medium text-emerald-700"><%= worker.mitra.phone %></a><% } %></td>
 <td class="px-4 py-4"><div class="flex flex-wrap gap-1 max-w-40"><% worker.skills.slice(0,2).forEach(skill => { %><span class="text-xs text-stone-600 bg-stone-100 rounded-md px-2 py-1"><%= skill.name %></span><% }) %></div>
  <p class="text-xs font-semibold text-amber-700 mt-1.5">★ <%= worker.rating.averageRating.toFixed(1) %> <span class="text-stone-400">(<%= worker.rating.ratingCount %>)</span></p></td>
 <td class="px-4 py-4 text-right whitespace-nowrap"><a class="text-sm font-semibold text-emerald-700 hover:underline" href="/admin/workers/edit/<%= worker.id %>">Edit</a>
 <% if (user && ['admin','superadmin'].includes(user.role)) { %><a class="text-sm font-semibold text-red-600 ml-3 hover:underline" href="/admin/workers/delete/<%= worker.id %>" onclick="return confirm('Delete this Worker?')">Delete</a><% } %></td>
</tr>
<% }) %>
</tbody></table></div>
<% if (!workers.length) { %><p class="py-10 text-center text-stone-500">No workers registered yet.</p><% } %>
<p id="noWorkerMatches" class="hidden py-8 text-center text-stone-500">No matching workers.</p>
<script>
(() => {
 const search = document.getElementById('workerSearch');
 search.addEventListener('input', () => {
   const query = search.value.trim().toLowerCase();
   let matching = 0;
   document.querySelectorAll('.worker-item').forEach(item => {
     const visible = item.dataset.search.includes(query);
     item.classList.toggle('hidden', !visible);
     if (visible) matching += 1;
   });
   document.getElementById('noWorkerMatches').classList.toggle('hidden', matching > 0 || !query);
 });
})();
</script>
