<div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 mb-6 md:mb-8">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Manage Workers</h1>
        <p class="text-sm text-stone-500 mt-1">Onboard and manage the daily-wage labor force.</p>
    </div>
    <a href="/admin/workers/create" class="inline-flex items-center justify-center w-full sm:w-auto px-5 py-2.5 text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-sm transition-all">
        <svg class="w-5 h-5 mr-2 -ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Register Worker
    </a>
</div>

<div class="grid grid-cols-1 gap-4 md:hidden">
    <% workers.forEach(worker => { %>
        <div class="bg-white p-5 rounded-2xl shadow-sm border border-stone-200 flex flex-col gap-3 <%= worker.isActive ? 'opacity-100' : 'opacity-60' %>">
            <div class="flex gap-4 items-center">
                <div class="h-12 w-12 rounded-full bg-stone-100 bg-cover bg-center border border-stone-200 shrink-0" 
                     style="background-image: url('<%= worker.photoUrl || 'https://ui-avatars.com/api/?name=' + worker.name %>')">
                </div>
                <div>
                    <p class="font-bold text-stone-900"><%= worker.name %></p>
                    <p class="text-xs text-stone-500"><%= worker.idProofType %>: <%= worker.idNumber %></p>
                </div>
            </div>
            <div class="flex flex-wrap gap-1 mt-2">
                <% worker.skills.forEach(skill => { %>
                    <span class="bg-stone-100 text-stone-600 text-[10px] font-bold px-2 py-1 rounded-md border border-stone-200"><%= skill.name %></span>
                <% }) %>
            </div>
            <div class="flex gap-2 border-t border-stone-100 pt-3">
                <a href="/admin/workers/edit/<%= worker.id %>" class="flex-1 text-center py-2 text-sm font-medium text-emerald-700 bg-emerald-50 rounded-lg">Edit</a>
                <a href="/admin/workers/delete/<%= worker.id %>" onclick="return confirm('Delete this Worker?')" class="flex-1 text-center py-2 text-sm font-medium text-red-700 bg-red-50 rounded-lg">Delete</a>
            </div>
        </div>
    <% }) %>
</div>

<div class="hidden md:block bg-white border border-stone-200 rounded-xl shadow-sm overflow-hidden">
    <table class="w-full text-left whitespace-nowrap">
        <thead class="bg-stone-50 border-b border-stone-200">
            <tr>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Worker Profile</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Verification</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase">Skills</th>
                <th class="px-6 py-4 text-xs font-semibold text-stone-500 uppercase text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
            <% workers.forEach(worker => { %>
                <tr class="hover:bg-stone-50 transition-colors group <%= !worker.isActive ? 'opacity-60 bg-stone-50/50' : '' %>">
                    <td class="px-6 py-4">
                        <div class="flex items-center">
                            <div class="h-10 w-10 flex-shrink-0 rounded-full bg-cover bg-center border border-stone-200" style="background-image: url('<%= worker.photoUrl || 'https://ui-avatars.com/api/?name=' + worker.name %>')"></div>
                            <div class="ml-4">
                                <div class="text-sm font-bold text-stone-900"><%= worker.name %> <span class="text-xs text-stone-400 font-normal ml-1">(Age: <%= worker.age %>)</span></div>
                                <div class="text-xs text-stone-500"><%= worker.nakas.length %> Nakas Assigned</div>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="text-sm text-stone-900 font-medium"><%= worker.idProofType %></div>
                        <div class="text-xs text-stone-500"><%= worker.idNumber %></div>
                    </td>
                    <td class="px-6 py-4">
                        <div class="flex flex-wrap gap-1 max-w-[200px]">
                            <% worker.skills.slice(0, 2).forEach(skill => { %>
                                <span class="bg-stone-100 text-stone-600 text-[10px] font-bold px-2 py-1 rounded-md border border-stone-200"><%= skill.name %></span>
                            <% }) %>
                            <% if (worker.skills.length > 2) { %>
                                <span class="text-xs text-stone-400 font-medium ml-1">+<%= worker.skills.length - 2 %></span>
                            <% } %>
                        </div>
                    </td>
                    <td class="px-6 py-4 text-right space-x-2">
                        <a href="/admin/workers/edit/<%= worker.id %>" class="text-stone-400 hover:text-emerald-600 font-medium text-sm">Edit</a>
                        <a href="/admin/workers/delete/<%= worker.id %>" onclick="return confirm('Delete this Worker?')" class="text-stone-400 hover:text-red-600 font-medium text-sm">Delete</a>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>