<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
    .scroll-area{flex:1;overflow-y:auto}
  </style>
</head>
<body>
<%- include('../partials/toast') %>
<div class="app">
  <%- include('./partials/navbar', { activePage: 'dashboard' }) %>

  <main class="scroll-area">
    <div class="mitra-page">
      <section class="mitra-stat-grid">
        <a href="/mitra/conflicts?status=PENDING" class="mitra-stat-card">
          <div class="stat-row"><span class="stat-label">Conflicts</span><span class="stat-icon">!</span></div>
          <div class="stat-value"><%= stats.pendingWorkerRequests %></div>
        </a>

        <a href="/mitra/workers" class="mitra-stat-card">
          <div class="stat-row"><span class="stat-label">Workers</span><span class="stat-icon">♙</span></div>
          <div class="stat-value"><%= stats.totalWorkers %></div>
        </a>

        <a href="/mitra/clients" class="mitra-stat-card">
          <div class="stat-row"><span class="stat-label">Clients</span><span class="stat-icon">▣</span></div>
          <div class="stat-value"><%= stats.totalClients %></div>
        </a>

        <a href="/mitra/nakas" class="mitra-stat-card">
          <div class="stat-row"><span class="stat-label">My Nakas</span><span class="stat-icon">⌖</span></div>
          <div class="stat-value stat-action-value">Manage</div>
        </a>
      </section>

      <% if (Number(stats.pendingWorkerRequests || 0) > 0) { %>
        <a href="/mitra/conflicts?status=PENDING" class="mitra-attention">
          <div>
            <strong><%= stats.pendingWorkerRequests %> conflict<%= Number(stats.pendingWorkerRequests) === 1 ? '' : 's' %> pending</strong>
            <span>Review now</span>
          </div>
          <b>›</b>
        </a>
      <% } %>

      <section class="mitra-dashboard-actions" aria-label="Quick actions">
        <a href="/mitra/workers/add" class="mitra-dashboard-action">
          <span class="action-icon">+</span><span>Add Worker</span>
        </a>
        <a href="/mitra/clients/add" class="mitra-dashboard-action">
          <span class="action-icon">+</span><span>Add Client</span>
        </a>
        <a href="/mitra/nakas/add" class="mitra-dashboard-action">
          <span class="action-icon">⌖</span><span>Submit Naka</span>
        </a>
        <a href="/mitra/leaves" class="mitra-dashboard-action">
          <span class="action-icon">▦</span><span>Leaves</span>
        </a>
      </section>
    </div>
  </main>
</div>
</body>
</html>
