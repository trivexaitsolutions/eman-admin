<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Workers | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
    .scroll-area{flex:1;overflow-y:auto}
  </style>
</head>
<body>
<%- include('../partials/toast') %>
<div class="app">
  <%- include('./partials/navbar', { activePage: 'workers' }) %>

  <main class="scroll-area">
    <div class="mitra-page">
      <div class="mitra-page-head">
        <div style="display:flex;align-items:center;gap:8px">
          <h1 class="mitra-page-title">Workers</h1>
          <span class="mitra-page-count"><%= workers.length %></span>
        </div>
        <a href="/mitra/workers/add" class="mitra-primary-btn">+ Add</a>
      </div>

      <form method="GET" action="/mitra/workers" class="mitra-filter two">
        <input class="mitra-input" type="text" name="search" value="<%= filters.search %>" placeholder="Search worker" />
        <select class="mitra-input" name="status">
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All</option>
          <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
          <option value="INACTIVE" <%= filters.status === 'INACTIVE' ? 'selected' : '' %>>Inactive</option>
        </select>
        <div class="filter-actions" style="display:flex;gap:6px">
          <button class="mitra-primary-btn" type="submit">Search</button>
          <% if (filters.search || filters.status !== 'ALL') { %>
            <a href="/mitra/workers" class="mitra-secondary-btn">Clear</a>
          <% } %>
        </div>
      </form>

      <% if (!workers.length) { %>
        <div class="mitra-empty">No workers found.</div>
      <% } else { %>
        <section class="mitra-list-grid">
          <% workers.forEach(worker => { %>
            <%
              const initial = String(worker.name || 'W').trim().charAt(0).toUpperCase() || 'W';
              const skills = Array.isArray(worker.skills) ? worker.skills : [];
              const nakas = Array.isArray(worker.nakas) ? worker.nakas : [];
            %>
            <article class="mitra-list-card">
              <div class="mitra-person-row">
                <div class="mitra-avatar">
                  <% if (worker.photoUrl) { %><img src="<%= worker.photoUrl %>" alt="" /><% } else { %><%= initial %><% } %>
                </div>
                <div style="flex:1;min-width:0">
                  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
                    <div style="min-width:0">
                      <div class="mitra-card-title" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= worker.name %></div>
                      <div class="mitra-card-sub"><%= worker.phone %> · #<%= worker.id %></div>
                    </div>
                    <span class="mitra-status-badge <%= worker.isActive ? 'mitra-chip green' : 'mitra-chip' %>"><%= worker.isActive ? 'Active' : 'Inactive' %></span>
                  </div>

                  <div class="mitra-chip-row">
                    <% skills.slice(0,2).forEach(skill => { %><span class="mitra-chip green"><%= skill.name %></span><% }) %>
                    <% if (skills.length > 2) { %><span class="mitra-chip">+<%= skills.length - 2 %></span><% } %>
                    <% if (nakas.length) { %><span class="mitra-chip blue"><%= nakas[0].name %><%= nakas.length > 1 ? ` +${nakas.length - 1}` : '' %></span><% } %>
                  </div>
                </div>
              </div>
              <div class="mitra-card-foot">
                <span class="mitra-card-sub"><%= skills.length %> skill<%= skills.length === 1 ? '' : 's' %> · <%= nakas.length %> naka<%= nakas.length === 1 ? '' : 's' %></span>
                <a class="mitra-link" href="/mitra/workers/edit/<%= worker.id %>">Edit ›</a>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
