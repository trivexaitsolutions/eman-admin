<%
  const page = (typeof activePage !== 'undefined' && activePage) ? activePage : 'dashboard';
%>

<header class="mitra-topbar">
  <div class="mitra-topbar-inner">
    <a href="/mitra/dashboard" class="mitra-brand" aria-label="Mitra dashboard">
      <span class="mitra-brand-mark">E</span>
      <span>E-MAN</span>
    </a>

    <div class="mitra-top-actions">
      <details class="mitra-menu">
        <summary class="mitra-icon-btn" aria-label="More options">⋮</summary>
        <div class="mitra-menu-panel">
          <a href="/mitra/nakas">My Nakas</a>
          <a href="/mitra/leaves">Leaves</a>
          <a href="/mitra/logout" class="danger">Logout</a>
        </div>
      </details>
    </div>
  </div>
</header>

<%- include('./bottom-nav', { activePage: page }) %>
<script>
(() => {
  const closeMenus = (except = null) => {
    document.querySelectorAll('details.mitra-menu[open]').forEach((menu) => {
      if (menu !== except) menu.removeAttribute('open');
    });
  };

  document.addEventListener('click', (event) => {
    const openMenu = event.target.closest('details.mitra-menu');
    if (!openMenu) closeMenus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenus();
  });
})();
</script>
