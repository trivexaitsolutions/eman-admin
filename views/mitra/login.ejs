<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>E-MAN Mitra Login</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      background: #ffffff;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .app {
      width: 100%;
      height: 100dvh;
      background: #ffffff;
      position: relative;
      overflow: hidden;
    }

    .screen-scroll {
      height: 100dvh;
      overflow-y: auto;
      padding-bottom: 120px;
    }

    .screen-scroll::-webkit-scrollbar {
      display: none;
    }

    .material-input {
      width: 100%;
      border: none;
      border-bottom: 1.5px solid #d1d5db;
      outline: none;
      background: transparent;
      padding: 14px 0 10px;
      font-size: 17px;
      color: #111827;
    }

    .material-input:focus {
      border-bottom-color: #10b981;
    }
  </style>
</head>

<body>

  <div class="app">

    <main class="screen-scroll px-6 pt-12 bg-white">

      <!-- Logo -->
      <div class="mb-12">
        <div class="w-16 h-16 rounded-[24px] bg-emerald-500 flex items-center justify-center shadow-lg shadow-emerald-100">
          <span class="text-white text-3xl font-black">E</span>
        </div>

        <h1 class="mt-5 text-2xl font-black text-gray-900">
          E-MAN Mitra
        </h1>

        <p class="text-sm font-medium text-gray-500 mt-1">
          Field Partner Portal
        </p>
      </div>

      <!-- Heading -->
      <section class="mb-12">
        <p class="inline-flex items-center px-4 py-2 rounded-full bg-emerald-50 text-emerald-700 text-sm font-bold mb-6">
          Secure Gmail Verification
        </p>

        <h2 class="text-[36px] leading-[1.1] font-black text-gray-900 tracking-tight">
          Login to your<br />
          Mitra account
        </h2>

        <p class="mt-4 text-[16px] leading-7 text-gray-500 font-medium">
          Apne registered Gmail se login karein. Company approval ke baad hi Mitra Portal access milega.
        </p>
      </section>

      <!-- Form -->
      <form id="mitraLoginForm" action="/mitra/login" method="POST">

        <div class="mb-8">
          <label class="block text-sm font-bold text-gray-600 mb-1">
            Gmail Address
          </label>

          <input
            type="email"
            name="email"
            placeholder="example@gmail.com"
            class="material-input"
          />
        </div>

        <div class="mb-4">
          <label class="block text-sm font-bold text-gray-600 mb-1">
            Password
          </label>

          <input
            type="password"
            name="password"
            placeholder="Enter password"
            class="material-input"
          />
        </div>

        <div class="flex justify-end mt-5">
          <a href="#" class="text-sm font-black text-emerald-600">
            Forgot Password?
          </a>
        </div>

      </form>

      <!-- Info -->
      <section class="mt-12 rounded-[28px] bg-emerald-50 border border-emerald-100 p-5">
        <div class="flex gap-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500 flex items-center justify-center text-white text-xl font-black">
            ✓
          </div>

          <div>
            <h3 class="font-black text-gray-900">
              Verified Mitra Access
            </h3>

            <p class="text-sm text-gray-600 mt-1 leading-6 font-medium">
              Sirf approved Gmail accounts se hi login allow hoga.
            </p>
          </div>
        </div>
      </section>

    </main>

    <!-- Only Login Button. No navbar. No sidebar. -->
    <footer class="fixed bottom-0 left-0 right-0 bg-white px-6 pt-4 pb-7 border-t border-gray-100">
      <button
        type="submit"
        form="mitraLoginForm"
        class="w-full h-[58px] rounded-[22px] bg-emerald-500 active:bg-emerald-600 text-white text-[17px] font-black shadow-xl shadow-emerald-100"
      >
        Verify & Login
      </button>
    </footer>

  </div>

</body>
</html>