<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>E-MAN Mitra Login</title>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;min-height:100%;background:#fff;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .login-shell{min-height:100dvh;display:grid;place-items:center;padding:max(20px,env(safe-area-inset-top)) 18px max(20px,env(safe-area-inset-bottom));background:#fff}
    .login-card{width:min(100%,380px)}
    .login-brand{display:flex;align-items:center;gap:10px;margin-bottom:34px}.login-brand-mark{width:38px;height:38px;border-radius:12px;background:#0f9f63;color:#fff;display:grid;place-items:center;font-weight:900}.login-brand strong{font-size:18px}
    .login-card h1{margin:0 0 22px;font-size:25px;line-height:1.15;letter-spacing:-.03em}.field{margin-bottom:14px}.field label{display:block;margin-bottom:6px;font-size:11px;font-weight:850;color:#6b7280;text-transform:uppercase;letter-spacing:.04em}.field input{width:100%;height:48px;border:1px solid #e5e7eb;border-radius:13px;padding:0 13px;font-size:14px;font-weight:700;outline:none}.field input:focus{border-color:#79cda7;box-shadow:0 0 0 3px rgba(15,159,99,.08)}
    .login-btn{width:100%;height:48px;border:0;border-radius:13px;background:#0f9f63;color:#fff;font-size:14px;font-weight:900;margin-top:4px;cursor:pointer}
  </style>
</head>
<body>
  <main class="login-shell">
    <div class="login-card">
      <div class="login-brand"><div class="login-brand-mark">E</div><strong>E-MAN Mitra</strong></div>
      <h1>Login</h1>
      <form action="/mitra/login" method="POST">
        <div class="field"><label>Email</label><input type="email" name="email" autocomplete="email" required /></div>
        <div class="field"><label>Password</label><input type="password" name="password" autocomplete="current-password" required /></div>
        <button class="login-btn" type="submit">Login</button>
      </form>
    </div>
  </main>
</body>
</html>
