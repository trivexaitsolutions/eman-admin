const idProofType = document.getElementById('idProofType');
const idNumberInput = document.getElementById('idNumber');
const idNumberLabel = document.getElementById('idNumberLabel');
const idNumberHelp = document.getElementById('idNumberHelp');

function calculateAgeFromDob(dobValue) {
  if (!dobValue) return 0;

  const birthDate = new Date(`${dobValue}T00:00:00`);

  if (Number.isNaN(birthDate.getTime())) return 0;

  const today = new Date();

  let age = today.getFullYear() - birthDate.getFullYear();
  const monthDifference = today.getMonth() - birthDate.getMonth();

  if (
    monthDifference < 0 ||
    (
      monthDifference === 0 &&
      today.getDate() < birthDate.getDate()
    )
  ) {
    age--;
  }

  return age;
}

function updateAgePreview() {
  const age = calculateAgeFromDob(workerDob.value);

  workerAge.value = age > 0 ? age : '';
}

function getBmiStatus(value) {
  if (value < 18.5) return 'Underweight range';
  if (value < 25) return 'Healthy range';
  if (value < 30) return 'Overweight range';

  return 'Higher BMI range';
}

function updateBmiPreview() {
  const height = Number(heightCmInput.value);
  const weight = Number(weightKgInput.value);

  if (
    !Number.isFinite(height) ||
    !Number.isFinite(weight) ||
    height <= 0 ||
    weight <= 0
  ) {
    bmiValue.textContent = '--';
    bmiStatus.textContent = 'Enter height and weight to calculate BMI.';
    bmiCard.classList.remove('is-ready');
    return;
  }

  const heightInMeters = height / 100;
  const bmi = weight / (heightInMeters * heightInMeters);

  bmiValue.textContent = bmi.toFixed(1);
  bmiStatus.textContent = getBmiStatus(bmi);
  bmiCard.classList.add('is-ready');
}

function updateIdentityInputUI(resetValue = false) {
  const selectedType = idProofType.value;

  if (resetValue) {
    idNumberInput.value = '';
  }

  clearFieldError(idNumberInput);

  if (selectedType === 'AADHAR') {
    idNumberLabel.textContent = 'Aadhaar Number *';
    idNumberInput.placeholder = 'Enter 12-digit Aadhaar number';
    idNumberInput.maxLength = 12;
    idNumberInput.inputMode = 'numeric';
    idNumberInput.classList.remove('uppercase');

    idNumberHelp.textContent =
      'Enter exactly 12 digits. Aadhaar number must not already be registered.';
    return;
  }

  if (selectedType === 'PAN') {
    idNumberLabel.textContent = 'PAN Number *';
    idNumberInput.placeholder = 'Example: ABCDE1234F';
    idNumberInput.maxLength = 10;
    idNumberInput.inputMode = 'text';
    idNumberInput.classList.add('uppercase');

    idNumberHelp.textContent =
      'PAN format: ABCDE1234F. PAN number must not already be registered.';
    return;
  }

  if (selectedType === 'VOTING') {
    idNumberLabel.textContent = 'Voter ID Number *';
    idNumberInput.placeholder = 'Enter Voter ID number';
    idNumberInput.maxLength = 30;
    idNumberInput.inputMode = 'text';
    idNumberInput.classList.add('uppercase');

    idNumberHelp.textContent =
      'Enter valid Voter ID number. Duplicate ID is not allowed.';
    return;
  }

  if (selectedType === 'DRIVING') {
    idNumberLabel.textContent = 'Driving License Number *';
    idNumberInput.placeholder = 'Enter driving license number';
    idNumberInput.maxLength = 30;
    idNumberInput.inputMode = 'text';
    idNumberInput.classList.add('uppercase');

    idNumberHelp.textContent =
      'Enter valid driving license number. Duplicate ID is not allowed.';
    return;
  }

  idNumberLabel.textContent = 'ID Number *';
  idNumberInput.placeholder = 'Select proof type first';
  idNumberInput.maxLength = 30;
  idNumberInput.inputMode = 'text';

  idNumberHelp.textContent =
    'Select Aadhaar, PAN, Voter ID or Driving License.';
}

