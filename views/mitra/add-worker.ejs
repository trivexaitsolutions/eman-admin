<script>
  let currentStep = 1;
  const totalSteps = 5;

  const isEditMode = <%= editMode ? "true" : "false" %>;
  const hasExistingConsentVideo = <%= hasExistingConsentVideo ? "true" : "false" %>;

  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  const form = document.getElementById('workerForm');
  const progressLine = document.getElementById('progressLine');
  const summaryStepTitle = document.getElementById('summaryStepTitle');
  const summaryStepText = document.getElementById('summaryStepText');

  const stepInfo = {
    1: {
      title: 'Basic Details',
      text: 'Worker ka login aur personal information add karein.'
    },
    2: {
      title: 'Aadhaar / ID Verification',
      text: 'Worker ka identity proof carefully verify karein.'
    },
    3: {
      title: 'Work Profile',
      text: 'Worker ke skills aur assigned naka select karein.'
    },
    4: {
      title: 'Payment Details',
      text: 'Worker ke payment receiving details add karein.'
    },
    5: {
      title: 'Video Consent',
      text: 'Final step me worker ka consent video record karein.'
    }
  };

  function updateUI() {
    document.querySelectorAll('.step-section').forEach((el, index) => {
      el.classList.toggle('active', index + 1 === currentStep);
    });

    for (let i = 1; i <= totalSteps; i++) {
      const indicator = document.getElementById('indicator-' + i);

      if (i < currentStep) {
        indicator.className = 'step-indicator w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-black text-sm shadow-md shadow-emerald-100';
        indicator.innerHTML = '✓';
      } else if (i === currentStep) {
        indicator.className = 'step-indicator w-8 h-8 rounded-full bg-gray-900 text-white flex items-center justify-center font-black text-sm shadow-md';
        indicator.innerHTML = i;
      } else {
        indicator.className = 'step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm';
        indicator.innerHTML = i;
      }
    }

    const progressPercent = ((currentStep - 1) / (totalSteps - 1)) * 100;
    progressLine.style.width = progressPercent + '%';

    prevBtn.classList.toggle('hidden', currentStep === 1);

    if (currentStep === totalSteps) {
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    }

    if (summaryStepTitle && summaryStepText) {
      summaryStepTitle.textContent = stepInfo[currentStep].title;
      summaryStepText.textContent = stepInfo[currentStep].text;
    }

    if (currentStep === 3) {
      updateNakaSearchResults();
      refreshSelectedNakaSummary();
    }

    document.querySelector('.scroll-area').scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  function getErrorNode(input) {
  const fieldName = input.name || input.id;
  let errorNode = input.parentElement.querySelector(
    `[data-error-for="${fieldName}"]`
  );

  if (!errorNode) {
    errorNode = document.createElement('p');
    errorNode.className = 'field-error';
    errorNode.setAttribute('data-error-for', fieldName);
    input.parentElement.appendChild(errorNode);
  }

  return errorNode;
}

function setFieldError(input, message) {
  input.classList.add('input-invalid');
  input.setAttribute('aria-invalid', 'true');

  const errorNode = getErrorNode(input);
  errorNode.textContent = message;
}

function clearFieldError(input) {
  input.classList.remove('input-invalid');
  input.removeAttribute('aria-invalid');

  const fieldName = input.name || input.id;
  const errorNode = input.parentElement.querySelector(
    `[data-error-for="${fieldName}"]`
  );

  if (errorNode) {
    errorNode.remove();
  }
}

function validateBasicStep() {
  let isValid = true;

  const name = document.getElementById('workerName');
  const phone = document.getElementById('workerPhone');
  const password = document.getElementById('workerPassword');
  const dob = document.getElementById('workerDob');
  const gender = document.getElementById('workerGender');
  const height = document.getElementById('heightCm');
  const weight = document.getElementById('weightKg');
  const pincode = document.getElementById('workerPincode');
  const address = document.getElementById('workerAddress');

  [
    name,
    phone,
    password,
    dob,
    gender,
    height,
    weight,
    pincode,
    address
  ].forEach(clearFieldError);

  if (name.value.trim().length < 2) {
    setFieldError(name, 'Please enter worker full name.');
    isValid = false;
  }

  const cleanPhone = phone.value.replace(/\D/g, '');

  if (!/^[6-9]\d{9}$/.test(cleanPhone)) {
    setFieldError(phone, 'Enter a valid 10-digit Indian mobile number.');
    isValid = false;
  }

  if (!isEditMode && password.value.trim().length < 6) {
    setFieldError(password, 'Password must contain at least 6 characters.');
    isValid = false;
  }

  if (
    isEditMode &&
    password.value.trim().length > 0 &&
    password.value.trim().length < 6
  ) {
    setFieldError(password, 'New password must contain at least 6 characters.');
    isValid = false;
  }

  if (!dob.value) {
    setFieldError(dob, 'Please select date of birth.');
    isValid = false;
  } else {
    const age = calculateAgeFromDob(dob.value);

    if (age < 18 || age > 100) {
      setFieldError(dob, 'Worker age must be between 18 and 100 years.');
      isValid = false;
    }
  }

  if (!gender.value) {
    setFieldError(gender, 'Please select gender.');
    isValid = false;
  }

  const heightValue = Number(height.value);

  if (!Number.isFinite(heightValue) || heightValue < 80 || heightValue > 250) {
    setFieldError(height, 'Height must be between 80 cm and 250 cm.');
    isValid = false;
  }

  const weightValue = Number(weight.value);

  if (!Number.isFinite(weightValue) || weightValue < 20 || weightValue > 300) {
    setFieldError(weight, 'Weight must be between 20 kg and 300 kg.');
    isValid = false;
  }

  if (!/^\d{6}$/.test(pincode.value.replace(/\D/g, ''))) {
    setFieldError(pincode, 'Pincode must contain exactly 6 digits.');
    isValid = false;
  }

  if (address.value.trim().length < 10) {
    setFieldError(address, 'Please enter complete worker address.');
    isValid = false;
  }

  return isValid;
}

function validateIdentityStep() {
  let isValid = true;

  const proofType = document.getElementById('idProofType');
  const idNumber = document.getElementById('idNumber');

  clearFieldError(proofType);
  clearFieldError(idNumber);

  if (!proofType.value) {
    setFieldError(proofType, 'Please select an ID proof type.');
    return false;
  }

  const selectedProof = proofType.value;
  const rawValue = idNumber.value.trim();

  if (!rawValue) {
    setFieldError(idNumber, 'Please enter ID proof number.');
    return false;
  }

  if (selectedProof === 'AADHAR') {
    const aadhaar = rawValue.replace(/\D/g, '');

    if (!/^\d{12}$/.test(aadhaar)) {
      setFieldError(idNumber, 'Aadhaar number must contain exactly 12 digits.');
      isValid = false;
    }
  }

  if (selectedProof === 'PAN') {
    const pan = rawValue.toUpperCase().replace(/\s+/g, '');

    if (!/^[A-Z]{5}[0-9]{4}[A-Z]$/.test(pan)) {
      setFieldError(idNumber, 'PAN format must be like ABCDE1234F.');
      isValid = false;
    }
  }

  if (
    selectedProof === 'VOTING' ||
    selectedProof === 'DRIVING'
  ) {
    const otherId = rawValue.replace(/\s+/g, '');

    if (otherId.length < 5 || otherId.length > 30) {
      setFieldError(idNumber, 'Please enter a valid ID proof number.');
      isValid = false;
    }
  }

  return isValid;
}

function validateCurrentStep() {
  if (currentStep === 1) {
    return validateBasicStep();
  }

  if (currentStep === 2) {
    return validateIdentityStep();
  }

  const currentSection = document.getElementById('step-' + currentStep);

  const inputs = currentSection.querySelectorAll(
    'input[required], select[required], textarea[required]'
  );

  for (let input of inputs) {
    if (!input.checkValidity()) {
      input.reportValidity();
      return false;
    }
  }

  if (currentStep === 3) {
    const skillChecked = document.querySelectorAll('.skill-check:checked').length > 0;
    const nakaChecked = document.querySelectorAll('.naka-check:checked').length > 0;

    if (!skillChecked) {
      alert('Please select at least 1 skill.');
      return false;
    }

    if (!nakaChecked) {
      alert('Please assign at least 1 naka.');
      return false;
    }
  }

  if (currentStep === 4) {
    const upiId = document.getElementById('upiId').value.trim();
    const upiNumber = document.getElementById('upiNumber').value.trim();
    const bankDetails = document.getElementById('bankDetails').value.trim();

    if (!upiId && !upiNumber && !bankDetails) {
      alert('Please add UPI ID, UPI Number, or Bank Details.');
      return false;
    }
  }

  if (currentStep === 5) {
    const videoConsentFile = document.getElementById('videoConsentFile');

    if (
      !hasExistingConsentVideo &&
      (!videoConsentFile.files || videoConsentFile.files.length === 0)
    ) {
      alert('Please record worker video consent before completing KYC.');
      return false;
    }
  }

  return true;
}

  nextBtn.addEventListener('click', () => {
    if (validateCurrentStep()) {
      currentStep++;
      updateUI();
    }
  });

  prevBtn.addEventListener('click', () => {
    currentStep--;
    updateUI();
  });

  form.addEventListener('submit', function (e) {
    if (!validateCurrentStep()) {
      e.preventDefault();
    }
  });

  updateUI();


  const workerDob = document.getElementById('workerDob');
const workerAge = document.getElementById('workerAge');
const heightCmInput = document.getElementById('heightCm');
const weightKgInput = document.getElementById('weightKg');
const bmiValue = document.getElementById('bmiValue');
const bmiStatus = document.getElementById('bmiStatus');
const bmiCard = document.getElementById('bmiCard');

const workerPhone = document.getElementById('workerPhone');
const workerPincode = document.getElementById('workerPincode');

const nakaSearchPincode = document.getElementById("nakaSearchPincode");
const nakaSearchHint = document.getElementById("nakaSearchHint");
const nakaNoMatch = document.getElementById("nakaNoMatch");
const nakaCards = document.querySelectorAll("[data-naka-card]");

const selectedNakaList = document.getElementById("selectedNakaList");
const selectedNakaEmpty = document.getElementById("selectedNakaEmpty");
const selectedNakaCount = document.getElementById("selectedNakaCount");

function cleanNakaPincode(value) {
  return String(value || "").replace(/\D/g, "");
}

function refreshSelectedNakaSummary() {
  const selectedCheckboxes = document.querySelectorAll(".naka-check:checked");

  selectedNakaList.innerHTML = "";
  selectedNakaCount.textContent = selectedCheckboxes.length;

  selectedNakaEmpty.classList.toggle(
    "hidden",
    selectedCheckboxes.length > 0
  );

  selectedCheckboxes.forEach((checkbox) => {
    const card = checkbox.closest("[data-naka-card]");
    const nakaName = card?.dataset.nakaName || "Selected Naka";
    const nakaPincode = card?.dataset.nakaPincode || "";

    const chip = document.createElement("div");

    chip.className =
      "inline-flex items-center gap-2 rounded-full bg-white border border-emerald-200 px-3 py-2 text-xs font-black text-emerald-800 shadow-sm";

    const chipText = document.createElement("span");
    chipText.textContent = `${nakaName}${nakaPincode ? ` · ${nakaPincode}` : ""}`;

    const removeButton = document.createElement("button");
    removeButton.type = "button";
    removeButton.className =
      "w-5 h-5 rounded-full bg-emerald-100 text-emerald-800 font-black leading-none hover:bg-emerald-200";
    removeButton.textContent = "×";
    removeButton.title = `Remove ${nakaName}`;

    removeButton.addEventListener("click", () => {
      checkbox.checked = false;

      refreshSelectedNakaSummary();
      updateNakaSearchResults();
    });

    chip.appendChild(chipText);
    chip.appendChild(removeButton);

    selectedNakaList.appendChild(chip);
  });
}

function updateNakaSearchResults() {
  const enteredPincode = cleanNakaPincode(nakaSearchPincode.value);

  if (!/^\d{6}$/.test(enteredPincode)) {
    nakaCards.forEach((card) => {
      card.classList.add("hidden");
    });

    nakaNoMatch.classList.add("hidden");
    nakaSearchHint.classList.remove("hidden");

    nakaSearchHint.innerHTML = `
      <p class="text-sm font-black text-gray-700">
        Area ka valid 6-digit pincode enter karein.
      </p>
      <p class="text-xs font-bold text-gray-500 mt-1">
        Matching Nakas yahan automatically dikhne lagenge.
      </p>
    `;

    return;
  }

  let matchedCount = 0;

  nakaCards.forEach((card) => {
    const nakaPincode = cleanNakaPincode(card.dataset.nakaPincode);
    const isMatch = nakaPincode === enteredPincode;

    card.classList.toggle("hidden", !isMatch);

    if (isMatch) {
      matchedCount++;
    }
  });

  if (matchedCount > 0) {
    nakaNoMatch.classList.add("hidden");
    nakaSearchHint.classList.remove("hidden");

    nakaSearchHint.innerHTML = `
      <p class="text-sm font-black text-emerald-800">
        ${matchedCount} Naka${matchedCount > 1 ? "s" : ""} found for pincode ${enteredPincode}.
      </p>
      <p class="text-xs font-bold text-emerald-600 mt-1">
        Required Nakas select karein. Search pincode change karne par selected Nakas remove nahi honge.
      </p>
    `;
  } else {
    nakaSearchHint.classList.add("hidden");
    nakaNoMatch.classList.remove("hidden");
  }
}

nakaSearchPincode.addEventListener("input", () => {
  nakaSearchPincode.value = nakaSearchPincode.value
    .replace(/\D/g, "")
