<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>Add Worker | E-MAN Mitra</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      background: #e5e7eb;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .app {
      width: 100%;
      height: 100dvh;
      background: #f8fafc;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      margin: 0 auto;
    }

    .scroll-area {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 112px;
    }

    .scroll-area::-webkit-scrollbar {
      display: none;
    }

    .bottom-safe {
      padding-bottom: max(16px, env(safe-area-inset-bottom));
    }

    .hero-gradient {
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.25), transparent 35%),
        linear-gradient(135deg, #10b981, #059669);
    }

    .dark-card {
      background:
        radial-gradient(circle at top right, rgba(16,185,129,0.25), transparent 38%),
        linear-gradient(135deg, #111827, #030712);
    }

    .app-input {
      width: 100%;
      border: 1.5px solid #e5e7eb;
      background: #ffffff;
      border-radius: 18px;
      padding: 14px 16px;
      outline: none;
      font-size: 15px;
      font-weight: 700;
      color: #111827;
      transition: 0.2s ease;
    }

    .app-input:focus {
      border-color: #10b981;
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.10);
    }

    .input-label {
      display: block;
      font-size: 11px;
      font-weight: 900;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 7px;
    }

    .section-card {
      background: #ffffff;
      border: 1px solid #f1f5f9;
      border-radius: 30px;
      padding: 20px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }

    .step-section {
      display: none;
    }

    .step-section.active {
      display: block;
      animation: fadeIn 0.25s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateX(8px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .custom-checkbox input:checked + div {
      background: #ecfdf5;
      border-color: #10b981;
      color: #047857;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.12);
    }

    @media (max-width: 767px) {
      .app {
        max-width: 430px;
      }

      .tablet-container {
        width: 100%;
      }

      .tablet-grid {
        display: block;
      }

      .tablet-summary {
        display: none;
      }
    }

    @media (min-width: 768px) {
      .app {
        max-width: 100%;
        background: #eef2f7;
      }

      .tablet-container {
        max-width: 1120px;
        margin: 0 auto;
      }

      .tablet-grid {
        display: grid;
        grid-template-columns: 0.72fr 0.28fr;
        gap: 28px;
        align-items: start;
      }

      .scroll-area {
        padding-bottom: 110px;
      }
    }
  </style>
</head>

<body>
    <%- include('../partials/toast') %>
<div class="app">

  <!-- Header -->
  <header class="bg-white px-5 md:px-8 pt-5 pb-4 border-b border-gray-100">
    <div class="tablet-container">

      <div class="flex items-center justify-between gap-4 mb-5">

        <div class="flex items-center gap-3 min-w-0">
          <a
            href="/mitra/dashboard"
            class="w-11 h-11 md:w-12 md:h-12 rounded-full bg-gray-50 flex items-center justify-center active:bg-gray-100 shrink-0"
          >
            <span class="text-2xl font-black text-gray-900">←</span>
          </a>

          <div class="min-w-0">
            <p class="text-xs font-black text-emerald-600 uppercase tracking-wide">
              Worker Onboarding
            </p>

            <h1 class="text-xl md:text-2xl font-black text-gray-900 leading-tight truncate">
              Add New Worker
            </h1>

            <p class="text-xs md:text-sm text-gray-500 font-semibold mt-0.5">
              Complete KYC in simple steps
            </p>
          </div>
        </div>

        <div class="hidden md:flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 text-emerald-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-sm font-black">Mitra Portal</span>
        </div>

      </div>

      <!-- Step Progress -->
      <div class="relative">
        <div class="absolute left-6 right-6 top-4 h-1 bg-gray-100 rounded-full"></div>
        <div id="progressLine" class="absolute left-6 top-4 h-1 bg-emerald-500 rounded-full transition-all duration-300" style="width: 0%;"></div>

        <div class="relative z-10 grid grid-cols-5 gap-1">

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-1" class="step-indicator w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-black text-sm shadow-md shadow-emerald-100">
              1
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">BASIC</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-2" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              2
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">ID</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-3" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              3
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">WORK</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-4" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              4
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">PAY</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-5" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              5
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">CONSENT</span>
          </div>

        </div>
      </div>

    </div>
  </header>

  <!-- Main -->
  <main class="scroll-area">

    <div class="tablet-container px-5 md:px-8 pt-5 md:pt-8">

      <% if (error === 'duplicate') { %>
        <div class="mb-5 rounded-[24px] bg-red-50 border border-red-100 p-4 flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-red-100 flex items-center justify-center text-xl">
            ⚠️
          </div>
          <div>
            <h3 class="text-sm font-black text-red-700">Worker Already Registered</h3>
            <p class="text-xs font-bold text-red-500 mt-0.5">Mobile number or Aadhaar already exists.</p>
          </div>
        </div>
      <% } %>

      <form id="workerForm" action="/mitra/workers/save" method="POST" enctype="multipart/form-data">

        <div class="tablet-grid">

          <!-- Form Column -->
          <div>

            <!-- Step 1 -->
            <section id="step-1" class="step-section active">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 1 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Basic Details</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ka login aur personal information add karein.
                  </p>
                </div>
              </div>

              <div class="section-card">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-2xl">👤</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Personal Information</h3>
                    <p class="text-xs font-bold text-gray-500">Name, phone, password and address</p>
                  </div>
                </div>

                <div class="space-y-4">
                  <div>
                    <label class="input-label">Full Name *</label>
                    <input type="text" name="name" required placeholder="Enter worker full name" class="app-input" />
                  </div>

                  <div>
                    <label class="input-label">Mobile Number *</label>
                    <input type="tel" name="phone" required placeholder="10-digit mobile number" pattern="[0-9]{10}" class="app-input" />
                  </div>

                  <div>
                    <label class="input-label">Set Password *</label>
                    <input type="password" name="password" required placeholder="Set worker login password" class="app-input" />
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    <div>
                      <label class="input-label">Date of Birth *</label>
                      <input type="date" name="dob" required class="app-input" />
                    </div>

                    <div>
                      <label class="input-label">Age *</label>
                      <input type="number" name="age" required placeholder="Age" class="app-input" />
                    </div>
                  </div>

                  <div>
                    <label class="input-label">Pincode *</label>
                    <input type="text" name="pincode" required placeholder="6-digit pincode" pattern="[0-9]{6}" class="app-input" />
                  </div>

                  <div>
                    <label class="input-label">Full Address *</label>
                    <textarea name="address" required rows="3" placeholder="Worker current/native address" class="app-input resize-none"></textarea>
                  </div>
                </div>
              </div>

            </section>

            <!-- Step 2 -->
            <section id="step-2" class="step-section">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 2 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Aadhaar / ID Verification</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ka identity proof verify karein.
                  </p>
                </div>
              </div>

              <div class="section-card">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-2xl">🪪</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Identity Details</h3>
                    <p class="text-xs font-bold text-gray-500">Aadhaar or other government ID</p>
                  </div>
                </div>

                <div class="space-y-4">
                  <div>
                    <label class="input-label">ID Proof Type *</label>
                    <select name="idProofType" required class="app-input bg-white">
                      <option value="AADHAR">Aadhaar Card</option>
                      <option value="PAN">PAN Card</option>
                      <option value="VOTING">Voter ID</option>
                      <option value="DRIVING">Driving License</option>
                    </select>
                  </div>

                  <div>
                    <label class="input-label">ID Number *</label>
                    <input type="text" name="idNumber" required placeholder="Enter ID number" class="app-input uppercase tracking-wider" />
                  </div>

                  <div class="rounded-[24px] bg-emerald-50 border border-emerald-100 p-4">
                    <div class="flex gap-3">
                      <div class="w-10 h-10 rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-black">
                        ✓
                      </div>
                      <div>
                        <h4 class="text-sm font-black text-gray-900">Verification Note</h4>
                        <p class="text-xs font-bold text-gray-600 leading-5 mt-1">
                          ID number carefully check karein. Duplicate ID submit hone par worker save nahi hoga.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </section>

            <!-- Step 3 -->
            <section id="step-3" class="step-section">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 3 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Work Profile</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ke skills aur naka assign karein.
                  </p>
                </div>
              </div>

              <div class="section-card mb-5">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 flex items-center justify-center text-2xl">🛠️</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Select Skills</h3>
                    <p class="text-xs font-bold text-gray-500">Multiple skills select kar sakte ho</p>
                  </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                  <% skills.forEach(skill => { %>
                    <label class="custom-checkbox cursor-pointer">
                      <input type="checkbox" name="skillIds[]" value="<%= skill.id %>" class="hidden skill-check" />
                      <div class="px-3 py-3 border-2 border-gray-100 rounded-2xl text-center text-sm font-black text-gray-500 transition">
                        <%= skill.name %>
                      </div>
                    </label>
                  <% }) %>
                </div>
              </div>

              <div class="section-card">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-2xl">📍</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Assign Nakas</h3>
                    <p class="text-xs font-bold text-gray-500">Worker kis location par available rahega</p>
                  </div>
                </div>

                <div class="space-y-3">
                  <% nakas.forEach(naka => { %>
                    <label class="custom-checkbox cursor-pointer block">
                      <input type="checkbox" name="nakaIds[]" value="<%= naka.id %>" class="hidden naka-check" />
                      <div class="px-4 py-4 border-2 border-gray-100 rounded-2xl font-black text-gray-600 transition flex items-center justify-between">
                        <span><%= naka.name %></span>
                        <span class="text-xl">📍</span>
                      </div>
                    </label>
                  <% }) %>

                  <% if (nakas.length === 0) { %>
                    <div class="rounded-2xl bg-red-50 border border-red-100 p-4">
                      <p class="text-sm text-red-600 font-black">No active Nakas available.</p>
                    </div>
                  <% } %>
                </div>
              </div>

            </section>

            <!-- Step 4 -->
            <section id="step-4" class="step-section">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 4 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Payment Details</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ko payment receive karne ke liye details add karein.
                  </p>
                </div>
              </div>

              <div class="section-card">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-2xl">🏦</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Payment Information</h3>
                    <p class="text-xs font-bold text-gray-500">UPI ya bank me se koi ek required</p>
                  </div>
                </div>

                <div class="space-y-4">
                  <div>
                    <label class="input-label">UPI ID</label>
                    <input type="text" name="upiId" id="upiId" placeholder="example@paytm" class="app-input" />
                  </div>

                  <div>
                    <label class="input-label">UPI Number</label>
                    <input type="tel" name="upiNumber" id="upiNumber" placeholder="Number linked to UPI" class="app-input" />
                  </div>

                  <div>
                    <label class="input-label">Bank Details</label>
                    <textarea name="bankDetails" id="bankDetails" rows="3" placeholder="Account number, IFSC code, bank name" class="app-input resize-none"></textarea>
                  </div>

                  <div class="rounded-[24px] bg-yellow-50 border border-yellow-100 p-4">
                    <div class="flex gap-3">
                      <div class="w-10 h-10 rounded-2xl bg-yellow-100 flex items-center justify-center">
                        ⚠️
                      </div>
                      <div>
                        <h4 class="text-sm font-black text-gray-900">Payment Detail Required</h4>
                        <p class="text-xs font-bold text-gray-600 leading-5 mt-1">
                          UPI ID, UPI Number ya Bank Details me se kam se kam ek detail add karein.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </section>

            <!-- Step 5 -->
            <section id="step-5" class="step-section">

              <div class="dark-card rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-gray-300 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-emerald-500/20 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-300">Final Step</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Video Consent</h2>
                  <p class="text-sm md:text-base font-semibold text-gray-300 mt-2">
                    Worker ki final permission video me record karein.
                  </p>
                </div>
              </div>

              <div class="section-card bg-gray-950 border-gray-900 text-white">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-500 flex items-center justify-center text-2xl">🎥</div>
                  <div>
                    <h3 class="text-lg font-black text-white">Live Video Consent</h3>
                    <p class="text-xs font-bold text-gray-400">Worker ko camera ke saamne consent bolna hai</p>
                  </div>
                </div>

                <div class="rounded-[24px] bg-white/5 border border-white/10 p-4 mb-5">
                  <p class="text-xs font-black text-emerald-300 uppercase tracking-wide mb-2">Worker Script</p>
                  <p class="text-sm md:text-base font-bold text-white leading-7">
                    “Mujhe E-MAN ki terms manzoor hain. Main apni marzi se registration kar raha/rahi hoon.”
                  </p>
                </div>

                <div class="relative w-full max-w-[420px] mx-auto aspect-[3/4] bg-black rounded-[28px] overflow-hidden mb-5 border border-white/10">
                  <video id="cameraPreview" autoplay muted playsinline class="w-full h-full object-cover"></video>

                  <div id="faceOval" class="absolute inset-0 pointer-events-none hidden flex items-center justify-center shadow-[0_0_0_999px_rgba(0,0,0,0.62)]">
                    <div class="w-[65%] h-[58%] border-4 border-dashed border-emerald-400 rounded-[50%]"></div>
                  </div>

                  <div id="recordingIndicator" class="hidden absolute top-4 right-4 flex items-center gap-2 bg-red-600 px-3 py-1.5 rounded-full shadow-lg">
                    <span class="w-2.5 h-2.5 bg-white rounded-full animate-pulse"></span>
                    <span class="text-white text-xs font-black">REC</span>
                  </div>

                  <div id="cameraPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center text-center px-8">
                    <div class="w-16 h-16 rounded-full bg-white/10 flex items-center justify-center text-3xl mb-4">
                      🎥
                    </div>
                    <h4 class="text-lg font-black text-white">Camera Off</h4>
                    <p class="text-sm font-semibold text-gray-400 mt-2">
                      Turn on camera and record consent video.
                    </p>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <button
                    type="button"
                    id="startCameraBtn"
                    class="h-[54px] rounded-2xl bg-blue-600 text-white font-black active:bg-blue-700"
                  >
                    📸 Turn On Camera
                  </button>

                  <button
                    type="button"
                    id="startRecordBtn"
                    class="hidden h-[54px] rounded-2xl bg-red-600 text-white font-black active:bg-red-700"
                  >
                    🔴 Start Recording
                  </button>

                  <button
                    type="button"
                    id="stopRecordBtn"
                    class="hidden h-[54px] rounded-2xl bg-gray-700 text-white font-black active:bg-gray-800"
                  >
                    ⏹ Stop Recording
                  </button>

                  <button
                    type="button"
                    id="retakeBtn"
                    class="hidden h-[54px] rounded-2xl bg-white text-gray-900 font-black active:bg-gray-100"
                  >
                    🔄 Retake
                  </button>
                </div>

                <input type="file" id="videoConsentFile" name="videoConsent" accept="video/*" class="hidden" required />
              </div>

            </section>

          </div>

          <!-- Tablet Summary Column -->
          <aside class="tablet-summary">
            <div class="sticky top-6 space-y-5">

              <div class="section-card">
                <h3 class="text-lg font-black text-gray-900 mb-2">KYC Checklist</h3>
                <p class="text-sm font-semibold text-gray-500 leading-6">
                  Worker onboarding complete karne ke liye sabhi steps properly fill karein.
                </p>

                <div class="space-y-3 mt-5">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-2xl bg-emerald-50 flex items-center justify-center">👤</div>
                    <p class="text-sm font-black text-gray-700">Basic Details</p>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-2xl bg-blue-50 flex items-center justify-center">🪪</div>
                    <p class="text-sm font-black text-gray-700">Aadhaar / ID</p>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-2xl bg-purple-50 flex items-center justify-center">🛠️</div>
                    <p class="text-sm font-black text-gray-700">Skills & Naka</p>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-2xl bg-yellow-50 flex items-center justify-center">🏦</div>
                    <p class="text-sm font-black text-gray-700">Payment</p>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-2xl bg-gray-100 flex items-center justify-center">🎥</div>
                    <p class="text-sm font-black text-gray-700">Final Consent</p>
                  </div>
                </div>
              </div>

              <div class="hero-gradient rounded-[30px] p-5 text-white shadow-xl shadow-emerald-100">
                <p class="text-sm font-bold text-emerald-50">Current Step</p>
                <h3 id="summaryStepTitle" class="text-2xl font-black mt-1">Basic Details</h3>
                <p id="summaryStepText" class="text-sm font-semibold text-emerald-50 leading-6 mt-2">
                  Worker ka login aur personal information add karein.
                </p>
              </div>

            </div>
          </aside>

        </div>

      </form>

    </div>

  </main>

  <!-- Footer Buttons -->
  <footer class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-100 px-5 md:px-8 pt-3 bottom-safe shadow-[0_-10px_30px_rgba(15,23,42,0.06)]">
    <div class="tablet-container">
      <div class="flex gap-3">

        <button
          type="button"
          id="prevBtn"
          class="hidden w-1/3 md:w-[180px] h-[58px] rounded-[22px] bg-gray-100 text-gray-700 text-base md:text-lg font-black active:bg-gray-200 transition"
        >
          Back
        </button>

        <button
          type="button"
          id="nextBtn"
          class="flex-1 h-[58px] rounded-[22px] bg-gray-900 text-white text-base md:text-lg font-black shadow-lg active:bg-black transition"
        >
          Next Step
        </button>

        <button
          type="submit"
          form="workerForm"
          id="submitBtn"
          class="hidden flex-1 h-[58px] rounded-[22px] bg-emerald-500 text-white text-base md:text-lg font-black shadow-lg shadow-emerald-100 active:bg-emerald-600 transition"
        >
          Complete KYC
        </button>

      </div>
    </div>
  </footer>

</div>

<script>
  let currentStep = 1;
  const totalSteps = 5;

  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const submitBtn = document.getElementById('submitBtn');
  const form = document.getElementById('workerForm');
  const progressLine = document.getElementById('progressLine');
  const summaryStepTitle = document.getElementById('summaryStepTitle');
  const summaryStepText = document.getElementById('summaryStepText');

  const stepInfo = {
    1: {
      title: 'Basic Details',
      text: 'Worker ka login aur personal information add karein.'
    },
    2: {
      title: 'Aadhaar / ID Verification',
      text: 'Worker ka identity proof carefully verify karein.'
    },
    3: {
      title: 'Work Profile',
      text: 'Worker ke skills aur assigned naka select karein.'
    },
    4: {
      title: 'Payment Details',
      text: 'Worker ke payment receiving details add karein.'
    },
    5: {
      title: 'Video Consent',
      text: 'Final step me worker ka consent video record karein.'
    }
  };

  function updateUI() {
    document.querySelectorAll('.step-section').forEach((el, index) => {
      el.classList.toggle('active', index + 1 === currentStep);
    });

    for (let i = 1; i <= totalSteps; i++) {
      const indicator = document.getElementById('indicator-' + i);

      if (i < currentStep) {
        indicator.className = 'step-indicator w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-black text-sm shadow-md shadow-emerald-100';
        indicator.innerHTML = '✓';
      } else if (i === currentStep) {
        indicator.className = 'step-indicator w-8 h-8 rounded-full bg-gray-900 text-white flex items-center justify-center font-black text-sm shadow-md';
        indicator.innerHTML = i;
      } else {
        indicator.className = 'step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm';
        indicator.innerHTML = i;
      }
    }

    const progressPercent = ((currentStep - 1) / (totalSteps - 1)) * 100;
    progressLine.style.width = progressPercent + '%';

    prevBtn.classList.toggle('hidden', currentStep === 1);

    if (currentStep === totalSteps) {
      nextBtn.classList.add('hidden');
      submitBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      submitBtn.classList.add('hidden');
    }

    if (summaryStepTitle && summaryStepText) {
      summaryStepTitle.textContent = stepInfo[currentStep].title;
      summaryStepText.textContent = stepInfo[currentStep].text;
    }

    document.querySelector('.scroll-area').scrollTo({
      top: 0,
      behavior: 'smooth'
    });
  }

  function validateCurrentStep() {
    const currentSection = document.getElementById('step-' + currentStep);

    const inputs = currentSection.querySelectorAll('input[required], select[required], textarea[required]');

    for (let input of inputs) {
      if (!input.checkValidity()) {
        input.reportValidity();
        return false;
      }
    }

    if (currentStep === 3) {
      const skillChecked = document.querySelectorAll('.skill-check:checked').length > 0;
      const nakaChecked = document.querySelectorAll('.naka-check:checked').length > 0;

      if (!skillChecked) {
        alert('Please select at least 1 skill.');
        return false;
      }

      if (!nakaChecked) {
        alert('Please assign at least 1 naka.');
        return false;
      }
    }

    if (currentStep === 4) {
      const upiId = document.getElementById('upiId').value.trim();
      const upiNumber = document.getElementById('upiNumber').value.trim();
      const bankDetails = document.getElementById('bankDetails').value.trim();

      if (!upiId && !upiNumber && !bankDetails) {
        alert('Please add UPI ID, UPI Number, or Bank Details.');
        return false;
      }
    }

    if (currentStep === 5) {
      const videoConsentFile = document.getElementById('videoConsentFile');

      if (!videoConsentFile.files || videoConsentFile.files.length === 0) {
        alert('Please record worker video consent before completing KYC.');
        return false;
      }
    }

    return true;
  }

  nextBtn.addEventListener('click', () => {
    if (validateCurrentStep()) {
      currentStep++;
      updateUI();
    }
  });

  prevBtn.addEventListener('click', () => {
    currentStep--;
    updateUI();
  });

  form.addEventListener('submit', function (e) {
    if (!validateCurrentStep()) {
      e.preventDefault();
    }
  });

  updateUI();

  // ================= VIDEO RECORDING LOGIC =================

  let mediaRecorder;
  let recordedChunks = [];
  let stream;

  const cameraPreview = document.getElementById('cameraPreview');
  const faceOval = document.getElementById('faceOval');
  const startCameraBtn = document.getElementById('startCameraBtn');
  const startRecordBtn = document.getElementById('startRecordBtn');
  const stopRecordBtn = document.getElementById('stopRecordBtn');
  const retakeBtn = document.getElementById('retakeBtn');
  const videoConsentFile = document.getElementById('videoConsentFile');
  const recordingIndicator = document.getElementById('recordingIndicator');
  const cameraPlaceholder = document.getElementById('cameraPlaceholder');

  startCameraBtn.addEventListener('click', async () => {
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user' },
        audio: true
      });

      cameraPreview.srcObject = stream;
      cameraPreview.muted = true;
      cameraPreview.controls = false;

      cameraPlaceholder.classList.add('hidden');
      startCameraBtn.classList.add('hidden');
      startRecordBtn.classList.remove('hidden');
      faceOval.classList.remove('hidden');
    } catch (err) {
      alert('Camera/Microphone permission denied. Browser settings check karein.');
    }
  });

  startRecordBtn.addEventListener('click', () => {
    recordedChunks = [];

    let options = {};

    if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9')) {
      options = { mimeType: 'video/webm;codecs=vp9' };
    } else if (MediaRecorder.isTypeSupported('video/webm')) {
      options = { mimeType: 'video/webm' };
    }

    mediaRecorder = new MediaRecorder(stream, options);

    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) {
        recordedChunks.push(e.data);
      }
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      const file = new File([blob], 'consent-' + Date.now() + '.webm', { type: 'video/webm' });

      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(file);
      videoConsentFile.files = dataTransfer.files;

      cameraPreview.srcObject = null;
      cameraPreview.src = URL.createObjectURL(blob);
      cameraPreview.muted = false;
      cameraPreview.controls = true;
      cameraPreview.play();
    };

    mediaRecorder.start();

    startRecordBtn.classList.add('hidden');
    stopRecordBtn.classList.remove('hidden');
    recordingIndicator.classList.remove('hidden');
    faceOval.classList.add('hidden');
  });

  stopRecordBtn.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }

    if (stream) {
      stream.getTracks().forEach(track => track.stop());
    }

    stopRecordBtn.classList.add('hidden');
    recordingIndicator.classList.add('hidden');
    retakeBtn.classList.remove('hidden');
  });

  retakeBtn.addEventListener('click', () => {
    videoConsentFile.value = '';
    cameraPreview.removeAttribute('src');
    cameraPreview.load();

    retakeBtn.classList.add('hidden');
    cameraPlaceholder.classList.remove('hidden');
    startCameraBtn.classList.remove('hidden');
  });
</script>

</body>
</html>