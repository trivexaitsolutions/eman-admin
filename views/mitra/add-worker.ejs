<%
  const editMode = Boolean(typeof isEdit !== "undefined" && isEdit && worker);
  const formWorker = editMode ? worker : {};
  const formWorkerDob = editMode && typeof workerDob !== "undefined" ? workerDob : "";

  const selectedSkillIds = new Set(
    editMode && Array.isArray(formWorker.skills)
      ? formWorker.skills.map((skill) => Number(skill.id))
      : []
  );

  const selectedNakaIds = new Set(
    editMode && Array.isArray(formWorker.nakas)
      ? formWorker.nakas.map((naka) => Number(naka.id))
      : []
  );

  const hasExistingConsentVideo = Boolean(
    editMode && formWorker.consentVoiceUrl
  );
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title><%= editMode ? "Edit Worker" : "Add Worker" %> | E-MAN Mitra</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      background: #e5e7eb;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .app {
      width: 100%;
      height: 100dvh;
      background: #f8fafc;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      margin: 0 auto;
    }

    .scroll-area {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 112px;
    }

    .scroll-area::-webkit-scrollbar {
      display: none;
    }

    .bottom-safe {
      padding-bottom: max(16px, env(safe-area-inset-bottom));
    }

    .hero-gradient {
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.25), transparent 35%),
        linear-gradient(135deg, #10b981, #059669);
    }

    .dark-card {
      background:
        radial-gradient(circle at top right, rgba(16,185,129,0.25), transparent 38%),
        linear-gradient(135deg, #111827, #030712);
    }

    .app-input {
      width: 100%;
      border: 1.5px solid #e5e7eb;
      background: #ffffff;
      border-radius: 18px;
      padding: 14px 16px;
      outline: none;
      font-size: 15px;
      font-weight: 700;
      color: #111827;
      transition: 0.2s ease;
    }

    .app-input:focus {
      border-color: #10b981;
      box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.10);
    }

    .input-label {
      display: block;
      font-size: 11px;
      font-weight: 900;
      color: #6b7280;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 7px;
    }

    .section-card {
      background: #ffffff;
      border: 1px solid #f1f5f9;
      border-radius: 30px;
      padding: 20px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }

    .step-section {
      display: none;
    }

    .step-section.active {
      display: block;
      animation: fadeIn 0.25s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateX(8px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    .custom-checkbox input:checked + div {
      background: #ecfdf5;
      border-color: #10b981;
      color: #047857;
      box-shadow: 0 8px 20px rgba(16, 185, 129, 0.12);
    }

    @media (max-width: 767px) {
      .app {
        max-width: 430px;
      }

      .tablet-container {
        width: 100%;
      }

      .tablet-grid {
        display: block;
      }

      .tablet-summary {
        display: none;
      }
    }

    @media (min-width: 768px) {
      .app {
        max-width: 100%;
        background: #eef2f7;
      }

      .tablet-container {
        max-width: 1120px;
        margin: 0 auto;
      }

      .tablet-grid {
        display: grid;
        grid-template-columns: 0.72fr 0.28fr;
        gap: 28px;
        align-items: start;
      }

      .scroll-area {
        padding-bottom: 110px;
      }
    }

    .app-input.input-invalid {
  border-color: #ef4444;
  background: #fff7f7;
  box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.08);
}

.field-error {
  margin-top: 6px;
  color: #dc2626;
  font-size: 12px;
  font-weight: 800;
  line-height: 1.35;
}

.bmi-card {
  border: 1px solid #bbf7d0;
  background: #ecfdf5;
  border-radius: 20px;
  padding: 14px 16px;
}

.bmi-card.is-ready {
  background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
}
  </style>
</head>

<body>
    <%- include('../partials/toast') %>
<div class="app">

  <!-- Header -->
  <header class="bg-white px-5 md:px-8 pt-5 pb-4 border-b border-gray-100">
    <div class="tablet-container">

      <div class="flex items-center justify-between gap-4 mb-5">

        <div class="flex items-center gap-3 min-w-0">
          <a
            href="/mitra/dashboard"
            class="w-11 h-11 md:w-12 md:h-12 rounded-full bg-gray-50 flex items-center justify-center active:bg-gray-100 shrink-0"
          >
            <span class="text-2xl font-black text-gray-900">←</span>
          </a>

          <div class="min-w-0">
            <p class="text-xs font-black text-emerald-600 uppercase tracking-wide">
              <%= editMode ? "Worker Management" : "Worker Onboarding" %>
            </p>

            <h1 class="text-xl md:text-2xl font-black text-gray-900 leading-tight truncate">
              <%= editMode ? "Edit Worker" : "Add New Worker" %>
            </h1>

            <p class="text-xs md:text-sm text-gray-500 font-semibold mt-0.5">
              <%= editMode ? "Update worker details safely" : "Complete KYC in simple steps" %>
            </p>
          </div>
        </div>

        <div class="hidden md:flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 text-emerald-700">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span class="text-sm font-black">Mitra Portal</span>
        </div>

      </div>

      <!-- Step Progress -->
      <div class="relative">
        <div class="absolute left-6 right-6 top-4 h-1 bg-gray-100 rounded-full"></div>
        <div id="progressLine" class="absolute left-6 top-4 h-1 bg-emerald-500 rounded-full transition-all duration-300" style="width: 0%;"></div>

        <div class="relative z-10 grid grid-cols-5 gap-1">

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-1" class="step-indicator w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-black text-sm shadow-md shadow-emerald-100">
              1
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">BASIC</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-2" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              2
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">ID</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-3" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              3
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">WORK</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-4" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              4
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">PAY</span>
          </div>

          <div class="flex flex-col items-center gap-1.5">
            <div id="indicator-5" class="step-indicator w-8 h-8 rounded-full bg-gray-100 text-gray-400 flex items-center justify-center font-black text-sm">
              5
            </div>
            <span class="text-[9px] md:text-[10px] font-black text-gray-700">CONSENT</span>
          </div>

        </div>
      </div>

    </div>
  </header>

  <!-- Main -->
  <main class="scroll-area">

    <div class="tablet-container px-5 md:px-8 pt-5 md:pt-8">

      <% if (error) { %>
  <div class="mb-5 rounded-[24px] bg-red-50 border border-red-100 p-4 flex items-center gap-3">
    <div class="w-11 h-11 rounded-2xl bg-red-100 flex items-center justify-center text-xl">
      ⚠️
    </div>

    <div>
      <h3 class="text-sm font-black text-red-700"><%= editMode ? "Unable to Update Worker" : "Unable to Continue" %></h3>

      <p class="text-xs font-bold text-red-500 mt-0.5 leading-5">
        <%= error %>
      </p>
    </div>
  </div>
<% } %>

      <form id="workerForm" action="<%= editMode ? `/mitra/workers/update/${formWorker.id}` : '/mitra/workers/save' %>" method="POST" enctype="multipart/form-data">

        <div class="tablet-grid">

          <!-- Form Column -->
          <div>

            <!-- Step 1 -->
            <section id="step-1" class="step-section active">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 1 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Basic Details</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ka login aur personal information add karein.
                  </p>
                </div>
              </div>

              <div class="section-card">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-2xl">👤</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Personal Information</h3>
                    <p class="text-xs font-bold text-gray-500"><%= editMode ? "Password blank chhodein agar change nahi karna hai" : "Name, phone, password and address" %></p>
                  </div>
                </div>

                <div class="space-y-4">

  <div>
    <label class="input-label">Full Name *</label>

    <input
      type="text"
      id="workerName"
      name="name"
      required
      minlength="2"
      maxlength="100"
      value="<%= editMode ? (formWorker.name || '') : '' %>"
      placeholder="Enter worker full name"
      class="app-input"
    />
  </div>

  <div>
    <label class="input-label">Mobile Number *</label>

    <input
      type="tel"
      id="workerPhone"
      name="phone"
      required
      inputmode="numeric"
      maxlength="10"
      value="<%= editMode ? (formWorker.phone || '') : '' %>"
      placeholder="10-digit mobile number"
      class="app-input"
    />
  </div>

  <div>
    <label class="input-label">
      <%= editMode ? "New Password (Optional)" : "Set Password *" %>
    </label>

    <input
      type="password"
      id="workerPassword"
      name="password"
      <%= editMode ? "" : "required" %>
      minlength="6"
      placeholder="<%= editMode ? "Leave blank to keep current password" : "Minimum 6 characters" %>"
      class="app-input"
    />

    <% if (editMode) { %>
      <p class="mt-2 text-xs font-bold text-gray-500">
        Password sirf tab enter karein jab worker ka login password change karna ho.
      </p>
    <% } %>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="input-label">Date of Birth *</label>

      <input
        type="date"
        id="workerDob"
        name="dob"
        required
        value="<%= formWorkerDob %>"
        class="app-input"
      />
    </div>

    <div>
      <label class="input-label">Age</label>

      <input
        type="number"
        id="workerAge"
        name="age"
        readonly
        tabindex="-1"
        placeholder="Auto calculated"
        class="app-input bg-gray-50 text-gray-500 cursor-not-allowed"
      />
    </div>
  </div>

  <div>
    <label class="input-label">Gender *</label>

    <select
      id="workerGender"
      name="gender"
      required
      class="app-input bg-white"
    >
      <option value="">Select gender</option>
      <option value="MALE" <%= editMode && formWorker.gender === "MALE" ? "selected" : "" %>>Male</option>
      <option value="FEMALE" <%= editMode && formWorker.gender === "FEMALE" ? "selected" : "" %>>Female</option>
      <option value="OTHER" <%= editMode && formWorker.gender === "OTHER" ? "selected" : "" %>>Other</option>
    </select>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="input-label">Height (cm) *</label>

      <input
        type="number"
        id="heightCm"
        name="heightCm"
        required
        min="80"
        max="250"
        step="0.1"
        inputmode="decimal"
        value="<%= editMode && formWorker.heightCm != null ? formWorker.heightCm : '' %>"
        placeholder="Example: 170"
        class="app-input"
      />
    </div>

    <div>
      <label class="input-label">Weight (kg) *</label>

      <input
        type="number"
        id="weightKg"
        name="weightKg"
        required
        min="20"
        max="300"
        step="0.1"
        inputmode="decimal"
        value="<%= editMode && formWorker.weightKg != null ? formWorker.weightKg : '' %>"
        placeholder="Example: 70"
        class="app-input"
      />
    </div>
  </div>

  <div id="bmiCard" class="bmi-card">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-[11px] font-black text-emerald-700 uppercase tracking-wide">
          BMI Preview
        </p>

        <p id="bmiStatus" class="text-xs font-bold text-emerald-700 mt-1">
          Enter height and weight to calculate BMI.
        </p>
      </div>

      <div class="text-right">
        <p id="bmiValue" class="text-3xl font-black text-emerald-700">--</p>
        <p class="text-[10px] font-black text-emerald-600 uppercase tracking-wide">
          BMI
        </p>
      </div>
    </div>
  </div>

  <div>
    <label class="input-label">Pincode *</label>

    <input
      type="text"
      id="workerPincode"
      name="pincode"
      required
      inputmode="numeric"
      maxlength="6"
      value="<%= editMode ? (formWorker.pincode || '') : '' %>"
      placeholder="6-digit pincode"
      class="app-input"
    />
  </div>

  <div>
    <label class="input-label">Full Address *</label>

    <textarea
      id="workerAddress"
      name="address"
      required
      minlength="10"
      rows="3"
      placeholder="Worker current/native address"
      class="app-input resize-none"
    ><%= editMode ? (formWorker.address || '') : '' %></textarea>
  </div>

</div>
              </div>

            </section>

            <!-- Step 2 -->
            <section id="step-2" class="step-section">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 2 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Aadhaar / ID Verification</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ka identity proof verify karein.
                  </p>
                </div>
              </div>

              <div class="section-card">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-2xl">🪪</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Identity Details</h3>
                    <p class="text-xs font-bold text-gray-500">Aadhaar or other government ID</p>
                  </div>
                </div>

                <div class="space-y-4">
                  <div>
                    <label class="input-label">ID Proof Type *</label>
                    <select
  id="idProofType"
  name="idProofType"
  required
  class="app-input bg-white"
>
  <option value="">Select ID proof type</option>
  <option value="AADHAR" <%= editMode && (formWorker.idProofType === "AADHAR" || formWorker.idProofType === "AADHAAR") ? "selected" : "" %>>Aadhaar Card</option>
  <option value="PAN" <%= editMode && formWorker.idProofType === "PAN" ? "selected" : "" %>>PAN Card</option>
  <option value="VOTING" <%= editMode && formWorker.idProofType === "VOTING" ? "selected" : "" %>>Voter ID</option>
  <option value="DRIVING" <%= editMode && formWorker.idProofType === "DRIVING" ? "selected" : "" %>>Driving License</option>
</select>
                  </div>

                  <div>
  <label id="idNumberLabel" class="input-label">ID Number *</label>

  <input
    type="text"
    id="idNumber"
    name="idNumber"
    required
    value="<%= editMode ? (formWorker.idNumber || '') : '' %>"
    placeholder="Select proof type first"
    autocomplete="off"
    class="app-input uppercase tracking-wider"
  />

  <p id="idNumberHelp" class="mt-2 text-xs font-bold text-gray-500 leading-5">
    Select Aadhaar, PAN, Voter ID or Driving License.
  </p>
</div>

                  <div class="rounded-[24px] bg-emerald-50 border border-emerald-100 p-4">
                    <div class="flex gap-3">
                      <div class="w-10 h-10 rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-black">
                        ✓
                      </div>
                      <div>
                        <h4 class="text-sm font-black text-gray-900">Verification Note</h4>
                        <p class="text-xs font-bold text-gray-600 leading-5 mt-1">
                          ID number carefully check karein. Duplicate ID submit hone par worker save nahi hoga.
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

            </section>

            <!-- Step 3 -->
            <section id="step-3" class="step-section">

              <div class="hero-gradient rounded-[32px] p-5 md:p-6 text-white shadow-xl shadow-emerald-100 mb-5 relative overflow-hidden">
                <div class="absolute -right-10 -top-10 w-36 h-36 bg-white/10 rounded-full"></div>
                <div class="relative z-10">
                  <p class="text-sm font-bold text-emerald-50">Step 3 of 5</p>
                  <h2 class="text-2xl md:text-3xl font-black mt-1">Work Profile</h2>
                  <p class="text-sm md:text-base font-semibold text-emerald-50 mt-2">
                    Worker ke skills aur naka assign karein.
                  </p>
                </div>
              </div>

              <div class="section-card mb-5">
                <div class="flex items-center gap-3 mb-5">
                  <div class="w-12 h-12 rounded-2xl bg-purple-50 flex items-center justify-center text-2xl">🛠️</div>
                  <div>
                    <h3 class="text-lg font-black text-gray-900">Select Skills</h3>
                    <p class="text-xs font-bold text-gray-500">Multiple skills select kar sakte ho</p>
                  </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                  <% skills.forEach(skill => { %>
                    <label class="custom-checkbox cursor-pointer">
                      <input type="checkbox" name="skillIds[]" value="<%= skill.id %>" <%= selectedSkillIds.has(Number(skill.id)) ? "checked" : "" %> class="hidden skill-check" />
                      <div class="px-3 py-3 border-2 border-gray-100 rounded-2xl text-center text-sm font-black text-gray-500 transition">
                        <%= skill.name %>
                      </div>
                    </label>
                  <% }) %>
                </div>
              </div>

              <div class="section-card">
  <div class="flex items-center gap-3 mb-5">
    <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-2xl">📍</div>

    <div>
      <h3 class="text-lg font-black text-gray-900">Assign Nakas</h3>

      <p class="text-xs font-bold text-gray-500">
        Pincode se Naka / Chouk search karke select karein
      </p>
    </div>
  </div>

  <!-- Search by Naka Area Pincode -->
  <div class="rounded-[24px] bg-blue-50 border border-blue-100 p-4 mb-5">
    <label class="input-label text-blue-800">Search Naka by Pincode</label>

    <input
      type="text"
      id="nakaSearchPincode"
      inputmode="numeric"
      maxlength="6"
      placeholder="Enter area pincode, e.g. 421201"
      class="app-input"
    />

    <p class="mt-2 text-xs font-bold text-blue-700 leading-5">
      Worker ke ghar ka pincode nahi. Jis area ke Naka / Chouk me worker kaam karega, us area ka pincode enter karein.
    </p>
  </div>

  <!-- Selected Nakas, kept visible even after changing pincode -->
  <div class="rounded-[24px] bg-emerald-50 border border-emerald-100 p-4 mb-5">
    <div class="flex items-center justify-between gap-3">
      <div>
        <h4 class="text-sm font-black text-emerald-900">Selected Nakas</h4>

        <p class="text-xs font-bold text-emerald-700 mt-1">
          Different pincodes se multiple Nakas select kar sakte ho.
        </p>
      </div>

      <span
        id="selectedNakaCount"
        class="min-w-9 h-9 px-3 rounded-full bg-emerald-500 text-white flex items-center justify-center text-sm font-black"
      >
        0
      </span>
    </div>

    <p
      id="selectedNakaEmpty"
      class="text-xs font-bold text-emerald-700 mt-4"
    >
      Abhi koi Naka select nahi hai.
    </p>

    <div
      id="selectedNakaList"
      class="flex flex-wrap gap-2 mt-4"
    ></div>
  </div>

  <!-- Search Result Message -->
  <div
    id="nakaSearchHint"
    class="rounded-[22px] bg-gray-50 border border-gray-100 p-4 mb-4"
  >
    <p class="text-sm font-black text-gray-700">
      Area ka valid 6-digit pincode enter karein.
    </p>

    <p class="text-xs font-bold text-gray-500 mt-1">
      Matching Nakas yahan automatically dikhne lagenge.
    </p>
  </div>

  <!-- No Match Message -->
  <div
    id="nakaNoMatch"
    class="hidden rounded-[22px] bg-red-50 border border-red-100 p-4 mb-4"
  >
    <p class="text-sm font-black text-red-700">
      Is pincode ke liye koi Naka available nahi hai.
    </p>

    <p class="text-xs font-bold text-red-500 mt-1">
      Pincode check karein ya Admin Panel se is area ka Naka add karein.
    </p>
  </div>

  <!-- Search Results -->
  <div id="nakaList" class="space-y-3">
    <% nakas.forEach(naka => { %>
      <label
        data-naka-card
        data-naka-pincode="<%= naka.pincode || '' %>"
        data-naka-name="<%= naka.name %>"
        class="custom-checkbox cursor-pointer block hidden"
      >
        <input
