refreshSelectedNakaSummary();

  // ================= VIDEO RECORDING LOGIC =================

  let mediaRecorder;
  let recordedChunks = [];
  let stream;

  const cameraPreview = document.getElementById('cameraPreview');
  const faceOval = document.getElementById('faceOval');
  const startCameraBtn = document.getElementById('startCameraBtn');
  const startRecordBtn = document.getElementById('startRecordBtn');
  const stopRecordBtn = document.getElementById('stopRecordBtn');
  const retakeBtn = document.getElementById('retakeBtn');
  const videoConsentFile = document.getElementById('videoConsentFile');
  const recordingIndicator = document.getElementById('recordingIndicator');
  const cameraPlaceholder = document.getElementById('cameraPlaceholder');

  startCameraBtn.addEventListener('click', async () => {
    try {
      stream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: 'user' },
        audio: true
      });

      cameraPreview.srcObject = stream;
      cameraPreview.muted = true;
      cameraPreview.controls = false;

      cameraPlaceholder.classList.add('hidden');
      startCameraBtn.classList.add('hidden');
      startRecordBtn.classList.remove('hidden');
      faceOval.classList.remove('hidden');
    } catch (err) {
      alert('Camera/Microphone permission denied. Browser settings check karein.');
    }
  });

  startRecordBtn.addEventListener('click', () => {
    recordedChunks = [];

    let options = {};

    if (MediaRecorder.isTypeSupported('video/webm;codecs=vp9')) {
      options = { mimeType: 'video/webm;codecs=vp9' };
    } else if (MediaRecorder.isTypeSupported('video/webm')) {
      options = { mimeType: 'video/webm' };
    }

    mediaRecorder = new MediaRecorder(stream, options);

    mediaRecorder.ondataavailable = (e) => {
      if (e.data.size > 0) {
        recordedChunks.push(e.data);
      }
    };

    mediaRecorder.onstop = () => {
      const blob = new Blob(recordedChunks, { type: 'video/webm' });
      const file = new File([blob], 'consent-' + Date.now() + '.webm', { type: 'video/webm' });

      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(file);
      videoConsentFile.files = dataTransfer.files;

      cameraPreview.srcObject = null;
      cameraPreview.src = URL.createObjectURL(blob);
      cameraPreview.muted = false;
      cameraPreview.controls = true;
      cameraPreview.play();
    };

    mediaRecorder.start();

    startRecordBtn.classList.add('hidden');
    stopRecordBtn.classList.remove('hidden');
    recordingIndicator.classList.remove('hidden');
    faceOval.classList.add('hidden');
  });

  stopRecordBtn.addEventListener('click', () => {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
    }

    if (stream) {
      stream.getTracks().forEach(track => track.stop());
    }

    stopRecordBtn.classList.add('hidden');
    recordingIndicator.classList.add('hidden');
    retakeBtn.classList.remove('hidden');
  });

  retakeBtn.addEventListener('click', () => {
    videoConsentFile.value = '';
    cameraPreview.removeAttribute('src');
    cameraPreview.load();

    retakeBtn.classList.add('hidden');
    cameraPlaceholder.classList.remove('hidden');
    startCameraBtn.classList.remove('hidden');
  });

  const workerForm = document.getElementById("workerForm");

  workerForm.addEventListener("submit", (event) => {
    // Existing validation ne form block kiya ho to button ka text change nahi hoga.
    if (event.defaultPrevented) {
      return;
    }

    const submitButton = document.getElementById("submitBtn");

    submitButton.disabled = true;
    submitButton.textContent = isEditMode ? "Updating Worker..." : "Saving Worker...";
    submitButton.classList.add("opacity-70", "cursor-wait");
  });
</script>

