<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Leaves | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
    .scroll-area{flex:1;overflow-y:auto}
    .leave-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
    .leave-form .full{grid-column:1/-1}
    @media(min-width:720px){.leave-form{grid-template-columns:repeat(4,minmax(0,1fr))}.leave-form .reason{grid-column:1/4}.leave-form .submit{grid-column:4/5}}
  </style>
</head>
<body>
<%- include('../partials/toast') %>
<div class="app">
  <%- include('./partials/navbar', { activePage: 'leaves', mitraName }) %>

  <main class="scroll-area">
    <div class="mitra-page">
      <div class="mitra-page-head">
        <h1 class="mitra-page-title">Leaves</h1>
        <span class="mitra-chip <%= currentLeave ? 'blue' : 'green' %>"><%= currentLeave ? 'On Leave' : 'Available' %></span>
      </div>

      <section class="mitra-card mitra-card-pad">
        <form method="POST" action="/mitra/leaves/apply" class="leave-form">
          <% const labels = {CASUAL:'Casual',SICK:'Sick',EMERGENCY:'Emergency',PAID:'Paid',UNPAID:'Unpaid',OTHER:'Other'}; %>
          <label><span class="input-label">Type</span><select name="leaveType" required class="mitra-input"><% leaveTypes.forEach(type => { %><option value="<%= type %>"><%= labels[type] || type %></option><% }) %></select></label>
          <label><span class="input-label">Day</span><select name="dayType" required class="mitra-input"><option value="FULL_DAY">Full Day</option><option value="HALF_DAY">Half Day</option></select></label>
          <label><span class="input-label">From</span><input type="date" name="fromDate" required class="mitra-input" /></label>
          <label><span class="input-label">To (optional)</span><input type="date" name="toDate" class="mitra-input" /></label>
          <label class="full reason"><span class="input-label">Reason</span><textarea name="reason" rows="2" required class="mitra-input" placeholder="Reason"></textarea></label>
          <div class="full submit" style="display:flex;align-items:end"><button type="submit" class="mitra-primary-btn" style="width:100%;min-height:44px">Submit</button></div>
        </form>
      </section>

      <div class="mitra-section-title">History <span style="color:#9ca3af">(<%= leaves.length %>)</span></div>
      <% if (!leaves.length) { %>
        <div class="mitra-empty">No leave requests.</div>
      <% } else { %>
        <section class="mitra-list-grid">
          <% const badge = {PENDING:'amber',ON_LEAVE:'blue',UPCOMING:'blue',COMPLETED:'',REJECTED:'red',CANCELLED:''}; %>
          <% leaves.forEach(leave => { %>
            <article class="mitra-list-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
                <div>
                  <div class="mitra-card-title"><%= labels[leave.leaveType] || leave.leaveType %> Leave</div>
                  <div class="mitra-card-sub"><%= leave.fromDateLabel %> → <%= leave.toDate ? leave.toDateLabel : 'Until returned' %></div>
                </div>
                <span class="mitra-chip <%= badge[leave.displayState] || '' %>"><%= leave.displayState.replaceAll('_',' ') %></span>
              </div>
              <div class="mitra-card-sub" style="margin-top:8px;color:#374151"><%= leave.reason %></div>
              <% if (leave.decisionNote) { %><div class="mitra-card-sub" style="margin-top:7px">Admin: <%= leave.decisionNote %></div><% } %>
              <% if (['PENDING','APPROVED'].includes(leave.status) && ['PENDING','UPCOMING','ON_LEAVE'].includes(leave.displayState)) { %>
                <div class="mitra-card-foot" style="justify-content:flex-end">
                  <form method="POST" action="/mitra/leaves/<%= leave.id %>/cancel" onsubmit="return confirm('Cancel this leave request?')"><button class="mitra-danger-btn" type="submit">Cancel</button></form>
                </div>
              <% } %>
            </article>
          <% }) %>
        </section>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
