<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>E-MAN Mitra Leaves</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    html, body { margin:0; width:100%; height:100%; overflow:hidden; background:#e5e7eb; font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    .app { width:100%; height:100dvh; background:#f8fafc; overflow:hidden; display:flex; flex-direction:column; margin:0 auto; }
    .scroll-area { flex:1; overflow-y:auto; padding-bottom:112px; }
    .scroll-area::-webkit-scrollbar { display:none; }
    .bottom-safe { padding-bottom:max(16px, env(safe-area-inset-bottom)); }
    @media (max-width:767px) { .app{max-width:430px}.tablet-container{width:100%} }
    @media (min-width:768px) { .app{max-width:100%;background:#eef2f7}.tablet-container{max-width:1120px;margin:0 auto}.scroll-area{padding-bottom:40px} }
  </style>
</head>
<body>
<%- include('../partials/toast') %>
<div class="app">
  <%- include('./partials/navbar', { activePage: 'leaves', mitraName }) %>

  <main class="scroll-area">
    <div class="tablet-container px-5 md:px-8 pt-5 md:pt-8 space-y-5">
      <section class="grid grid-cols-2 gap-3 md:grid-cols-3">
        <div class="rounded-[24px] border border-gray-100 bg-white p-4 shadow-sm">
          <p class="text-[11px] font-black uppercase tracking-wide text-gray-400">Current</p>
          <p class="mt-2 text-lg font-black <%= currentLeave ? 'text-blue-700' : 'text-gray-900' %>"><%= currentLeave ? 'On Leave' : 'Available' %></p>
        </div>
        <div class="rounded-[24px] border border-gray-100 bg-white p-4 shadow-sm">
          <p class="text-[11px] font-black uppercase tracking-wide text-gray-400">Upcoming</p>
          <p class="mt-2 text-lg font-black text-gray-900"><%= upcomingLeave ? upcomingLeave.fromDateLabel : 'None' %></p>
        </div>
        <div class="hidden md:block rounded-[24px] border border-gray-100 bg-white p-4 shadow-sm">
          <p class="text-[11px] font-black uppercase tracking-wide text-gray-400">Requests</p>
          <p class="mt-2 text-lg font-black text-gray-900"><%= leaves.length %></p>
        </div>
      </section>

      <section class="rounded-[28px] border border-gray-100 bg-white p-4 md:p-5 shadow-sm">
        <div class="flex items-center justify-between gap-3">
          <div>
            <h2 class="text-lg font-black text-gray-900">Apply Leave</h2>
            <p class="text-xs font-semibold text-gray-500 mt-1">Admin approval ke baad leave active hogi.</p>
          </div>
          <div class="w-11 h-11 rounded-2xl bg-emerald-50 flex items-center justify-center text-xl">📅</div>
        </div>

        <form method="POST" action="/mitra/leaves/apply" class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">
          <label class="block col-span-1">
            <span class="mb-1.5 block text-[11px] font-black uppercase text-gray-500">Leave Type</span>
            <select name="leaveType" required class="h-11 w-full rounded-xl border border-gray-200 bg-gray-50 px-3 text-sm font-bold outline-none focus:border-emerald-400">
              <% const labels = {CASUAL:'Casual',SICK:'Sick',EMERGENCY:'Emergency',PAID:'Paid',UNPAID:'Unpaid',OTHER:'Other'}; %>
              <% leaveTypes.forEach((type) => { %><option value="<%= type %>"><%= labels[type] || type %></option><% }) %>
            </select>
          </label>

          <label class="block col-span-1">
            <span class="mb-1.5 block text-[11px] font-black uppercase text-gray-500">Day Type</span>
            <select name="dayType" required class="h-11 w-full rounded-xl border border-gray-200 bg-gray-50 px-3 text-sm font-bold outline-none focus:border-emerald-400">
              <option value="FULL_DAY">Full Day</option>
              <option value="HALF_DAY">Half Day</option>
            </select>
          </label>

          <label class="block col-span-1">
            <span class="mb-1.5 block text-[11px] font-black uppercase text-gray-500">From</span>
            <input type="date" name="fromDate" required class="h-11 w-full rounded-xl border border-gray-200 bg-gray-50 px-3 text-sm font-bold outline-none focus:border-emerald-400" />
          </label>

          <label class="block col-span-1">
            <span class="mb-1.5 block text-[11px] font-black uppercase text-gray-500">To <span class="font-semibold text-gray-400">Optional</span></span>
            <input type="date" name="toDate" class="h-11 w-full rounded-xl border border-gray-200 bg-gray-50 px-3 text-sm font-bold outline-none focus:border-emerald-400" />
          </label>

          <label class="block col-span-2 md:col-span-3">
            <span class="mb-1.5 block text-[11px] font-black uppercase text-gray-500">Reason</span>
            <textarea name="reason" rows="2" required placeholder="Leave ka short reason" class="w-full rounded-xl border border-gray-200 bg-gray-50 px-3 py-2.5 text-sm font-semibold outline-none focus:border-emerald-400"></textarea>
          </label>

          <div class="col-span-2 md:col-span-1 flex items-end">
            <button class="h-11 w-full rounded-xl bg-emerald-500 px-4 text-sm font-black text-white shadow-lg shadow-emerald-100 active:bg-emerald-600">Submit</button>
          </div>
        </form>
      </section>

      <section class="rounded-[28px] border border-gray-100 bg-white shadow-sm overflow-hidden">
        <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3 md:px-5">
          <h2 class="font-black text-gray-900">Leave History</h2>
          <span class="text-xs font-black text-gray-400"><%= leaves.length %></span>
        </div>

        <% if (!leaves.length) { %>
          <div class="px-5 py-10 text-center text-sm font-semibold text-gray-500">No leave request yet.</div>
        <% } else { %>
          <div class="divide-y divide-gray-100">
            <% const badge = {PENDING:'bg-amber-100 text-amber-700',ON_LEAVE:'bg-blue-100 text-blue-700',UPCOMING:'bg-violet-100 text-violet-700',COMPLETED:'bg-gray-100 text-gray-600',REJECTED:'bg-red-100 text-red-700',CANCELLED:'bg-gray-100 text-gray-500'}; %>
            <% leaves.forEach((leave) => { %>
              <article class="p-4 md:p-5">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="font-black text-gray-900"><%= labels[leave.leaveType] || leave.leaveType %> Leave</h3>
                      <span class="rounded-full px-2.5 py-1 text-[10px] font-black <%= badge[leave.displayState] || 'bg-emerald-100 text-emerald-700' %>"><%= leave.displayState.replaceAll('_',' ') %></span>
                    </div>
                    <p class="mt-2 text-sm font-bold text-gray-600">
                      <%= leave.fromDateLabel %> → <%= leave.toDate ? leave.toDateLabel : 'Until returned' %>
                      <% if (leave.days !== null) { %> · <%= leave.days %> day<%= leave.days === 1 ? '' : 's' %><% } %>
                    </p>
                    <p class="mt-1 text-sm font-semibold text-gray-500"><%= leave.reason %></p>
                    <% if (leave.decisionNote) { %><p class="mt-2 rounded-xl bg-gray-50 px-3 py-2 text-xs font-semibold text-gray-600"><span class="font-black">Admin:</span> <%= leave.decisionNote %></p><% } %>
                  </div>
                  <% if (['PENDING','APPROVED'].includes(leave.status) && ['PENDING','UPCOMING','ON_LEAVE'].includes(leave.displayState)) { %>
                    <form method="POST" action="/mitra/leaves/<%= leave.id %>/cancel" onsubmit="return confirm('Cancel this leave request?')">
                      <button class="rounded-xl border border-red-100 px-3 py-2 text-xs font-black text-red-600 active:bg-red-50">Cancel</button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </main>
</div>
</body>
</html>
