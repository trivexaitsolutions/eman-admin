<%
  const statusMeta = {
    VERIFIED: { label: 'Verified', chip: 'green' },
    REVERIFY_REQUIRED: { label: 'Reverify', chip: 'amber' },
    PENDING_VERIFICATION: { label: 'Pending', chip: 'blue' },
  };
  const getStatusMeta = (status) => statusMeta[status] || { label: String(status || 'Pending').replace(/_/g,' '), chip: '' };
  const formatDate = (value) => value ? new Intl.DateTimeFormat('en-IN',{day:'2-digit',month:'short',year:'numeric'}).format(new Date(value)) : '--';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>My Nakas | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}.scroll-area{flex:1;overflow-y:auto}
    .naka-filters{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:12px}
    .naka-filter{min-height:50px;border:1px solid var(--mitra-border);border-radius:14px;background:#fff;padding:9px 10px;text-decoration:none;color:#4b5563;font-size:11px;font-weight:850;display:flex;align-items:center;justify-content:space-between;gap:6px}
    .naka-filter.active{border-color:#86efac;background:#ecfdf5;color:#047857}.naka-filter b{font-size:17px;color:#111827}
  </style>
</head>
<body>
<div class="app">
  <%- include('../partials/navbar', { activePage: 'nakas', mitraName }) %>
  <main class="scroll-area">
    <div class="mitra-page">
      <% if (success_msg) { %><div class="mitra-card mitra-card-pad" style="margin-bottom:10px;color:#047857"><%= success_msg %></div><% } %>
      <% if (error_msg) { %><div class="mitra-card mitra-card-pad" style="margin-bottom:10px;color:#b91c1c"><%= error_msg %></div><% } %>

      <div class="mitra-page-head">
        <div style="display:flex;align-items:center;gap:8px"><h1 class="mitra-page-title">My Nakas</h1><span class="mitra-page-count"><%= counts.total %></span></div>
        <a href="/mitra/nakas/add" class="mitra-primary-btn">+ Add</a>
      </div>

      <div class="naka-filters">
        <a href="/mitra/nakas?filter=all" class="naka-filter <%= activeFilter === 'all' ? 'active' : '' %>"><span>All</span><b><%= counts.total %></b></a>
        <a href="/mitra/nakas?filter=verified" class="naka-filter <%= activeFilter === 'verified' ? 'active' : '' %>"><span>Verified</span><b><%= counts.verified %></b></a>
        <a href="/mitra/nakas?filter=pending" class="naka-filter <%= activeFilter === 'pending' ? 'active' : '' %>"><span>Pending</span><b><%= counts.pending %></b></a>
      </div>

      <% if (!nakas.length) { %>
        <div class="mitra-empty">No Nakas found.</div>
      <% } else { %>
        <section class="mitra-list-grid">
          <% nakas.forEach(naka => { const meta = getStatusMeta(naka.computedVerificationStatus); %>
            <article class="mitra-list-card">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
                <div style="min-width:0">
                  <div class="mitra-card-title" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= naka.name %></div>
                  <div class="mitra-card-sub"><%= naka.city.state ? `${naka.city.state.name} · ` : '' %><%= naka.city.name %></div>
                </div>
                <span class="mitra-chip <%= meta.chip %>"><%= meta.label %></span>
              </div>
              <div class="mitra-detail-grid" style="margin-top:10px">
                <div class="mitra-detail-cell"><label>Survey</label><p><%= formatDate(naka.surveyDate) %></p></div>
                <div class="mitra-detail-cell"><label>Peak Workers</label><p><%= naka.peakHourHeadcount != null ? naka.peakHourHeadcount : '--' %></p></div>
              </div>
              <% if (naka.computedVerificationStatus === 'VERIFIED' && naka.lastVerifiedAt) { %><div class="mitra-card-sub" style="margin-top:8px;color:#047857">Verified <%= formatDate(naka.lastVerifiedAt) %></div><% } %>
            </article>
          <% }) %>
        </section>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
