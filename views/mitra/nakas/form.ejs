<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Submit Naka | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden;background:var(--mitra-bg)}
    .scroll-area{flex:1;overflow-y:auto;padding-bottom:86px!important}.form-grid{display:grid;grid-template-columns:1fr;gap:10px}.field-grid{display:grid;grid-template-columns:1fr;gap:10px}
    .form-footer{position:fixed;left:0;right:0;bottom:0;z-index:50;background:#fff;border-top:1px solid var(--mitra-border);padding:9px 14px max(9px,env(safe-area-inset-bottom))}.form-footer-inner{width:min(100%,900px);margin:0 auto}
    #map{height:280px!important;border-radius:14px!important}.file-input{width:100%;border:1px solid var(--mitra-border);border-radius:12px;padding:10px;background:#fff;font-size:12px;font-weight:700}
    @media(min-width:680px){.field-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.field-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}#map{height:320px!important}}
  </style>
</head>
<body>
<div class="app">
  <header class="mitra-task-header">
    <div class="mitra-task-header-inner">
      <a href="/mitra/nakas" class="mitra-back">←</a>
      <div class="mitra-task-title"><h1>Submit Naka</h1></div>
    </div>
  </header>

  <main class="scroll-area">
    <div class="mitra-page">
      <% if (error_msg) { %><div class="mitra-card mitra-card-pad" style="margin-bottom:10px;color:#b91c1c"><%= error_msg %></div><% } %>

      <form id="mitraNakaForm" action="/mitra/nakas/submit" method="POST" enctype="multipart/form-data" class="form-grid">
        <section class="mitra-card mitra-card-pad">
          <div class="mitra-card-title" style="margin-bottom:10px">Area</div>
          <div class="field-grid two">
            <label><span class="input-label">State / UT *</span><select id="stateId" name="stateId" required class="app-input"><option value="">Select State / UT</option><% states.forEach(state => { %><option value="<%= state.id %>"><%= state.name %> (<%= state.code %>)<%= state.type === 'UNION_TERRITORY' ? ' — UT' : '' %></option><% }) %></select></label>
            <label><span class="input-label">City *</span><select id="cityId" name="cityId" required disabled class="app-input"><option value="">Select State first</option><% cities.forEach(city => { %><option value="<%= city.id %>" data-state-id="<%= city.stateId %>" hidden disabled><%= city.name %></option><% }) %></select><span id="cityHelp" class="mitra-card-sub" style="display:block;margin-top:4px">Select a State.</span></label>
          </div>
          <div class="field-grid two" style="margin-top:10px">
            <label><span class="input-label">Naka / Chouk Name *</span><input id="name" name="name" required minlength="2" maxlength="120" placeholder="Naka name" class="app-input" /></label>
            <label><span class="input-label">PIN Code *</span><input id="pincode" name="pincode" type="text" inputmode="numeric" autocomplete="postal-code" required minlength="6" maxlength="6" pattern="[0-9]{6}" placeholder="6 digit PIN" class="app-input" /></label>
          </div>
          <label style="display:block;margin-top:10px"><span class="input-label">Landmark</span><input id="landmark" name="landmark" maxlength="191" placeholder="Nearest landmark" class="app-input" /></label>
        </section>

        <section class="mitra-card mitra-card-pad">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px">
            <div class="mitra-card-title">Location</div>
            <button id="useCurrentLocationBtn" type="button" class="mitra-secondary-btn">Use Current</button>
          </div>
          <div id="locationStatus" class="mitra-card-sub" style="margin-bottom:8px;color:#b45309">Exact GPS location required.</div>
          <div id="map"></div>
          <div class="field-grid two" style="margin-top:10px">
            <label><span class="input-label">Latitude *</span><input id="latitude" name="latitude" readonly required placeholder="Select on map" class="app-input" /></label>
            <label><span class="input-label">Longitude *</span><input id="longitude" name="longitude" readonly required placeholder="Select on map" class="app-input" /></label>
          </div>
        </section>

        <section class="mitra-card mitra-card-pad">
          <div class="mitra-card-title" style="margin-bottom:10px">Survey</div>
          <div class="field-grid three">
            <label><span class="input-label">Confidence *</span><select id="confidenceLevel" name="confidenceLevel" required class="app-input"><option value="">Select</option><option value="HIGH">High</option><option value="MEDIUM">Medium</option><option value="LOW">Low</option><option value="N_A">N/A</option></select></label>
            <label><span class="input-label">Survey Date *</span><input id="surveyDate" type="date" name="surveyDate" max="<%= new Date().toISOString().slice(0, 10) %>" required class="app-input" /></label>
            <label><span class="input-label">Peak Workers *</span><input id="peakHourHeadcount" type="number" name="peakHourHeadcount" min="0" max="1000000" step="1" required placeholder="0" class="app-input" /></label>
          </div>
          <label style="display:block;margin-top:10px"><span class="input-label">Verification Photo *</span><input id="verificationPhoto" type="file" name="verificationPhoto" accept="image/jpeg,image/png,image/webp" required class="file-input" /></label>
          <label style="display:block;margin-top:10px"><span class="input-label">Notes</span><textarea id="surveyNotes" name="surveyNotes" rows="3" maxlength="3000" placeholder="Optional notes" class="app-input" style="resize:vertical"></textarea></label>
        </section>
      </form>
    </div>
  </main>

  <footer class="form-footer"><div class="form-footer-inner"><button type="submit" form="mitraNakaForm" class="mitra-primary-btn" style="width:100%;min-height:48px">Submit Naka</button></div></footer>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const stateSelect = document.getElementById('stateId');
    const citySelect = document.getElementById('cityId');
    const cityHelp = document.getElementById('cityHelp');
    const pincodeInput = document.getElementById('pincode');
    const latitudeInput = document.getElementById('latitude');
    const longitudeInput = document.getElementById('longitude');
    const locationStatus = document.getElementById('locationStatus');
    const useCurrentLocationBtn = document.getElementById('useCurrentLocationBtn');

    function refreshCityOptions() {
      const stateId = stateSelect.value;
      let visible = 0;
      Array.from(citySelect.options).forEach((option, index) => {
        if (index === 0) return;
        const allowed = Boolean(stateId) && option.dataset.stateId === stateId;
        option.hidden = !allowed;
        option.disabled = !allowed;
        if (allowed) visible += 1;
      });
      citySelect.disabled = !stateId;
      citySelect.value = '';
      cityHelp.textContent = !stateId ? 'Select a State to see its Cities.' : visible ? `${visible} ${visible === 1 ? 'City' : 'Cities'} available.` : 'No City exists for this State. Please contact Admin.';
    }
    stateSelect.addEventListener('change', refreshCityOptions);

    pincodeInput.addEventListener('input', () => {
      pincodeInput.value = pincodeInput.value.replace(/\D/g, '').slice(0, 6);
    });

    const map = L.map('map').setView([19.2183, 73.0867], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution:'© OpenStreetMap contributors', maxZoom:19 }).addTo(map);
    let marker = null;

    function setLocation(lat, lng, zoom = true) {
      const latitude = Number(lat), longitude = Number(lng);
      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return;
      if (!marker) {
        marker = L.marker([latitude, longitude], { draggable:true }).addTo(map);
        marker.on('dragend', () => { const point = marker.getLatLng(); setLocation(point.lat, point.lng, false); });
      } else marker.setLatLng([latitude, longitude]);
      latitudeInput.value = latitude.toFixed(6);
      longitudeInput.value = longitude.toFixed(6);
      locationStatus.className = 'mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-800';
      locationStatus.textContent = 'Exact Naka location selected. Pin drag karke ya map par click karke adjust kar sakte ho.';
      if (zoom) map.setView([latitude, longitude], 16);
    }

    map.on('click', (event) => setLocation(event.latlng.lat, event.latlng.lng));
    useCurrentLocationBtn.addEventListener('click', () => {
      if (!navigator.geolocation) { locationStatus.textContent = 'Browser current location support nahi karta. Map par point select karo.'; return; }
      useCurrentLocationBtn.disabled = true; useCurrentLocationBtn.textContent = 'Getting location…';
      navigator.geolocation.getCurrentPosition(
        (position) => { setLocation(position.coords.latitude, position.coords.longitude); useCurrentLocationBtn.disabled = false; useCurrentLocationBtn.textContent = 'Use Current Location'; },
        () => { locationStatus.className = 'mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700'; locationStatus.textContent = 'Location unavailable. Permission allow karo ya map par manually select karo.'; useCurrentLocationBtn.disabled = false; useCurrentLocationBtn.textContent = 'Use Current Location'; },
        { enableHighAccuracy:true, timeout:12000, maximumAge:0 }
      );
    });

    document.getElementById('mitraNakaForm').addEventListener('submit', (event) => {
      if (!stateSelect.value || !citySelect.value) { event.preventDefault(); alert('Please select State and City.'); return; }
      if (!/^\d{6}$/.test(pincodeInput.value)) { event.preventDefault(); alert('Please enter a valid 6-digit PIN code.'); pincodeInput.focus(); return; }
      const selected = citySelect.options[citySelect.selectedIndex];
      if (!selected || selected.dataset.stateId !== stateSelect.value) { event.preventDefault(); alert('Selected City does not belong to the selected State.'); return; }
      if (!latitudeInput.value || !longitudeInput.value) { event.preventDefault(); alert('Please capture the exact Naka location.'); return; }
      if (!document.getElementById('verificationPhoto').files.length) { event.preventDefault(); alert('Please upload a Naka verification photo.'); return; }
    });
  </script>
</body>
</html>
