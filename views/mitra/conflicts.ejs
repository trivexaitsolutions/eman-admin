<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Conflicts | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
    .scroll-area{flex:1;overflow-y:auto}
  </style>
</head>
<body>
<div class="app">
  <%- include('./partials/navbar', { activePage: 'conflicts', mitraName: mitra?.name }) %>

  <main class="scroll-area">
    <div class="mitra-page">
      <div class="mitra-page-head">
        <div style="display:flex;align-items:center;gap:8px">
          <h1 class="mitra-page-title">Conflicts</h1>
          <span class="mitra-page-count"><%= conflicts.length %></span>
        </div>
      </div>

      <form method="GET" action="/mitra/conflicts" class="mitra-filter conflict">
        <select name="status" class="mitra-input wide">
          <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All status</option>
          <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
          <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
          <option value="SOLVED" <%= filters.status === 'SOLVED' ? 'selected' : '' %>>Solved</option>
          <option value="UNRESOLVED" <%= filters.status === 'UNRESOLVED' ? 'selected' : '' %>>Unresolved</option>
        </select>
        <input type="date" name="fromDate" value="<%= filters.fromDate %>" class="mitra-input" aria-label="From date" />
        <input type="date" name="toDate" value="<%= filters.toDate %>" class="mitra-input" aria-label="To date" />
        <div style="display:flex;gap:6px">
          <button class="mitra-primary-btn" type="submit">Apply</button>
          <a class="mitra-secondary-btn" href="/mitra/conflicts">Clear</a>
        </div>
      </form>

      <% if (!conflicts || !conflicts.length) { %>
        <div class="mitra-empty">No conflicts found.</div>
      <% } else { %>
        <section class="mitra-list-grid">
          <% conflicts.forEach(conflict => { %>
            <%
              const statusClass = conflict.status === 'PENDING' ? 'amber' : conflict.status === 'IN_PROGRESS' ? 'blue' : conflict.status === 'SOLVED' ? 'green' : 'red';
              const statusLabel = conflict.status === 'IN_PROGRESS' ? 'In Progress' : String(conflict.status || '').replaceAll('_',' ');
              const when = new Date(conflict.createdAt).toLocaleString('en-IN', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
            %>
            <a href="/mitra/conflicts/<%= conflict.id %>" class="mitra-list-card" style="display:block;text-decoration:none;color:inherit">
              <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
                <div style="min-width:0">
                  <div class="mitra-card-title"><%= String(conflict.requestedAction || 'Issue').replaceAll('_',' ') %></div>
                  <div class="mitra-card-sub">C#<%= conflict.id %> · Booking #<%= conflict.bookingId %></div>
                </div>
                <span class="mitra-chip <%= statusClass %>"><%= statusLabel %></span>
              </div>

              <div class="mitra-detail-grid" style="margin-top:10px">
                <div class="mitra-detail-cell"><label>Client</label><p><%= conflict.customer?.name || '-' %></p></div>
                <div class="mitra-detail-cell"><label>Worker</label><p><%= conflict.worker?.name || 'Full booking' %></p></div>
              </div>

              <div class="mitra-card-sub" style="margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= conflict.reason || '' %></div>
              <div class="mitra-card-foot">
                <span class="mitra-card-sub"><%= when %></span>
                <span class="mitra-link">Review ›</span>
              </div>
            </a>
          <% }) %>
        </section>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
