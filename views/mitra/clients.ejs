<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Clients | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
    .scroll-area{flex:1;overflow-y:auto}
  </style>
</head>
<body>
<%- include('../partials/toast') %>
<div class="app">
  <%- include('./partials/navbar', { activePage: 'clients' }) %>

  <main class="scroll-area">
    <div class="mitra-page">
      <div class="mitra-page-head">
        <div style="display:flex;align-items:center;gap:8px">
          <h1 class="mitra-page-title">Clients</h1>
          <span class="mitra-page-count"><%= clients.length %></span>
        </div>
        <a href="/mitra/clients/add" class="mitra-primary-btn">+ Add</a>
      </div>

      <form method="GET" action="/mitra/clients" class="mitra-filter two">
        <input class="mitra-input" type="text" name="search" value="<%= filters.search %>" placeholder="Search client" />
        <select class="mitra-input" name="type">
          <option value="ALL" <%= filters.type === 'ALL' ? 'selected' : '' %>>All</option>
          <option value="INDIVIDUAL" <%= filters.type === 'INDIVIDUAL' ? 'selected' : '' %>>Individual</option>
          <option value="COMPANY" <%= filters.type === 'COMPANY' ? 'selected' : '' %>>Company</option>
        </select>
        <div class="filter-actions" style="display:flex;gap:6px">
          <button class="mitra-primary-btn" type="submit">Search</button>
          <% if (filters.search || filters.type !== 'ALL') { %><a href="/mitra/clients" class="mitra-secondary-btn">Clear</a><% } %>
        </div>
      </form>

      <% if (!clients.length) { %>
        <div class="mitra-empty">No clients found.</div>
      <% } else { %>
        <section class="mitra-list-grid">
          <% clients.forEach(client => { %>
            <%
              const displayName = client.businessName || client.name || 'Client';
              const initial = String(displayName).trim().charAt(0).toUpperCase() || 'C';
              const company = String(client.clientType || '').toLowerCase() === 'company';
              const address = client.addresses && client.addresses.length ? client.addresses[0] : null;
              const site = address?.addressLine || client.siteAddress || '';
            %>
            <article class="mitra-list-card">
              <div class="mitra-person-row">
                <div class="mitra-avatar" style="background:#eff6ff;color:#1d4ed8"><%= initial %></div>
                <div style="flex:1;min-width:0">
                  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px">
                    <div style="min-width:0">
                      <div class="mitra-card-title" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= displayName %></div>
                      <div class="mitra-card-sub"><%= client.phone %><%= client.name && company ? ` · ${client.name}` : '' %></div>
                    </div>
                    <span class="mitra-chip <%= company ? 'blue' : '' %>"><%= company ? 'Company' : 'Individual' %></span>
                  </div>

                  <div class="mitra-chip-row">
                    <% if (client.isVerified) { %><span class="mitra-chip green">Verified</span><% } else { %><span class="mitra-chip amber">Pending</span><% } %>
                    <% if (client.workerRequirement) { %><span class="mitra-chip"><%= client.workerRequirement %> workers</span><% } %>
                    <% if (address?.pincode) { %><span class="mitra-chip blue"><%= address.pincode %></span><% } %>
                  </div>
                </div>
              </div>
              <% if (site) { %><div class="mitra-card-sub" style="margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">⌖ <%= site %></div><% } %>
              <div class="mitra-card-foot">
                <span class="mitra-card-sub"><%= client.email || '' %></span>
                <a class="mitra-link" href="/mitra/clients/edit/<%= client.id %>">Edit ›</a>
              </div>
            </article>
          <% }) %>
        </section>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
