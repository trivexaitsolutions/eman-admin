<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />
  <title>My Clients | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      background: #e5e7eb;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .app {
      width: 100%;
      height: 100dvh;
      background: #f8fafc;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      margin: 0 auto;
    }

    .scroll-area {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 112px;
    }

    .scroll-area::-webkit-scrollbar {
      display: none;
    }

    .bottom-safe {
      padding-bottom: max(16px, env(safe-area-inset-bottom));
    }

    .hero-gradient {
      background:
        radial-gradient(circle at top right, rgba(255,255,255,0.25), transparent 35%),
        linear-gradient(135deg, #2563eb, #1d4ed8);
    }

    .app-input {
      width: 100%;
      border: 1.5px solid #e5e7eb;
      background: #ffffff;
      border-radius: 18px;
      padding: 13px 15px;
      outline: none;
      font-size: 14px;
      font-weight: 700;
      color: #111827;
      transition: 0.2s ease;
    }

    .app-input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.10);
    }

    .section-card {
      background: #ffffff;
      border: 1px solid #f1f5f9;
      border-radius: 28px;
      padding: 18px;
      box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }

    .client-card {
      background: #ffffff;
      border: 1px solid #eef2f7;
      border-radius: 28px;
      padding: 16px;
      box-shadow: 0 8px 22px rgba(15, 23, 42, 0.04);
    }

    .chip {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 11px;
      font-weight: 800;
      line-height: 1;
    }

    .address-preview {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    @media (max-width: 767px) {
      .app {
        max-width: 430px;
      }

      .tablet-container {
        width: 100%;
      }
    }

    @media (min-width: 768px) {
      .app {
        max-width: 100%;
        background: #eef2f7;
      }

      .tablet-container {
        max-width: 1120px;
        margin: 0 auto;
      }

      .clients-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .scroll-area {
        padding-bottom: 40px;
      }
    }
  </style>
</head>

<body>

<%- include('../partials/toast') %>

<div class="app">

  <%- include('./partials/navbar', { activePage: 'clients' }) %>

  <main class="scroll-area">
    <div class="tablet-container px-5 md:px-8 pt-5 md:pt-8">

      <section class="hero-gradient rounded-[30px] md:rounded-[34px] p-5 md:p-6 text-white shadow-xl shadow-blue-100 mb-5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-sm font-bold text-blue-50">
              Client Management
            </p>

            <h2 class="text-3xl md:text-4xl font-black mt-1">
              <%= clients.length %>
              <span class="text-xl md:text-2xl font-bold text-blue-100">
                Records
              </span>
            </h2>

            <p class="text-sm font-semibold text-blue-50 mt-2 leading-5">
              Sirf aapke onboard kiye hue clients yahan dikhte hain.
            </p>
          </div>

          <div class="w-14 h-14 rounded-2xl bg-white/20 flex items-center justify-center text-3xl">
            🏢
          </div>
        </div>
      </section>

      <section class="section-card mb-5">
        <form method="GET" action="/mitra/clients">
          <div class="grid grid-cols-1 md:grid-cols-[1fr_200px_auto] gap-3">

            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-lg">
                🔍
              </span>

              <input
                type="text"
                name="search"
                value="<%= filters.search %>"
                placeholder="Search client, company, mobile or email"
                class="app-input pl-11"
              />
            </div>

            <select name="type" class="app-input bg-white">
              <option value="ALL" <%= filters.type === 'ALL' ? 'selected' : '' %>>
                All Clients
              </option>
              <option value="INDIVIDUAL" <%= filters.type === 'INDIVIDUAL' ? 'selected' : '' %>>
                Individual
              </option>
              <option value="COMPANY" <%= filters.type === 'COMPANY' ? 'selected' : '' %>>
                Company
              </option>
            </select>

            <div class="flex gap-2">
              <button
                type="submit"
                class="flex-1 md:flex-none h-[50px] px-5 rounded-2xl bg-gray-900 text-white text-sm font-black active:bg-black"
              >
                Search
              </button>

              <% if (filters.search || filters.type !== 'ALL') { %>
                <a
                  href="/mitra/clients"
                  class="h-[50px] px-4 rounded-2xl bg-gray-100 text-gray-700 text-sm font-black flex items-center justify-center active:bg-gray-200"
                >
                  Clear
                </a>
              <% } %>
            </div>

          </div>
        </form>
      </section>

      <% if (clients.length === 0) { %>

        <section class="section-card text-center py-10">
          <div class="w-16 h-16 mx-auto rounded-[22px] bg-blue-50 flex items-center justify-center text-3xl">
            🏢
          </div>

          <h2 class="text-xl font-black text-gray-900 mt-5">
            No Clients Found
          </h2>

          <p class="text-sm font-semibold text-gray-500 leading-6 mt-2 max-w-sm mx-auto">
            Aapke search/filter ke hisaab se koi client nahi mila.
          </p>

          <a
            href="/mitra/clients/add"
            class="inline-flex mt-5 h-[52px] px-5 rounded-2xl bg-blue-600 text-white font-black items-center justify-center shadow-lg shadow-blue-100"
          >
            + Add First Client
          </a>
        </section>

      <% } else { %>

        <section class="clients-grid space-y-4 md:space-y-0">

          <% clients.forEach(client => { %>
            <%
              const displayBusinessName = client.businessName || client.name || 'Client';
              const clientInitial = String(displayBusinessName).trim().charAt(0).toUpperCase() || 'C';
              const isCompany = String(client.clientType || '').toLowerCase() === 'company';
              const primaryAddress = client.addresses && client.addresses.length > 0
                ? client.addresses[0]
                : null;
              const workSiteAddress = primaryAddress?.addressLine || client.siteAddress || 'Work site address not added.';
              const hasSavedLocation = Boolean(primaryAddress?.latitude && primaryAddress?.longitude);
              const addedOn = new Date(client.createdAt).toLocaleDateString('en-IN', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
              });
            %>

            <article class="client-card">

              <div class="flex items-start gap-3">
                <div class="w-14 h-14 rounded-[20px] bg-blue-50 text-blue-700 flex items-center justify-center text-xl font-black shrink-0">
                  <%= clientInitial %>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0">
                      <h2 class="text-base md:text-lg font-black text-gray-900 truncate">
                        <%= displayBusinessName %>
                      </h2>

                      <p class="text-xs font-bold text-gray-500 mt-0.5 truncate">
                        <%= isCompany ? client.name : 'Individual Client' %>
                      </p>
                    </div>

                    <span class="chip <%= isCompany ? 'bg-blue-50 text-blue-700 border border-blue-100' : 'bg-purple-50 text-purple-700 border border-purple-100' %> shrink-0">
                      <%= isCompany ? 'Company' : 'Individual' %>
                    </span>
                  </div>

                  <p class="text-sm font-black text-gray-800 mt-2">
                    📞 <%= client.phone %>
                  </p>

                  <% if (client.email) { %>
                    <p class="text-xs font-bold text-gray-500 mt-1 truncate">
                      ✉️ <%= client.email %>
                    </p>
                  <% } %>
                </div>
              </div>

              <div class="flex flex-wrap gap-2 mt-4">
                <% if (client.isVerified) { %>
                  <span class="chip bg-emerald-50 text-emerald-700 border border-emerald-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
                    Verified
                  </span>
                <% } else { %>
                  <span class="chip bg-yellow-50 text-yellow-700 border border-yellow-100">
                    Pending verification
                  </span>
                <% } %>

                <% if (client.workerRequirement) { %>
                  <span class="chip bg-orange-50 text-orange-700 border border-orange-100">
                    👷 <%= client.workerRequirement %> workers
                  </span>
                <% } %>

                <% if (client.businessType) { %>
                  <span class="chip bg-gray-100 text-gray-700 border border-gray-200">
                    <%= client.businessType %>
                  </span>
                <% } %>
              </div>

              <div class="mt-4 pt-4 border-t border-gray-100">
                <p class="text-[10px] font-black text-gray-400 uppercase tracking-wide">
                  Primary Work Site
                </p>

                <p class="address-preview text-sm font-bold text-gray-700 leading-5 mt-2">
                  📍 <%= workSiteAddress %>
                </p>

                <div class="flex items-center gap-2 mt-3">
                  <% if (hasSavedLocation) { %>
                    <span class="chip bg-emerald-50 text-emerald-700 border border-emerald-100">
                      📍 Location captured
                    </span>
                  <% } else { %>
                    <span class="chip bg-gray-100 text-gray-600 border border-gray-200">
                      Address only
                    </span>
                  <% } %>

                  <% if (primaryAddress?.pincode) { %>
                    <span class="chip bg-blue-50 text-blue-700 border border-blue-100">
                      <%= primaryAddress.pincode %>
                    </span>
                  <% } %>
                </div>
              </div>

              <div class="mt-4 flex items-center justify-between gap-3">
                <p class="text-xs font-bold text-gray-400">
                  Added: <%= addedOn %>
                </p>

                <a
                  href="/mitra/clients/edit/<%= client.id %>"
                  class="h-10 px-4 rounded-xl bg-blue-50 text-blue-700 text-xs font-black flex items-center justify-center active:bg-blue-100"
                >
                  Edit Client →
                </a>
              </div>

            </article>
          <% }) %>

        </section>

      <% } %>

    </div>
  </main>

</div>

</body>
</html>
