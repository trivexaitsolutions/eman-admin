<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Conflict #<%= conflict.id %> | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/mitra-ui.css" />
  <style>
    html,body{margin:0;width:100%;height:100%;overflow:hidden;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .app{width:100%;height:100dvh;display:flex;flex-direction:column;overflow:hidden}
    .scroll-area{flex:1;overflow-y:auto}
    .review-layout{display:grid;grid-template-columns:1fr;gap:10px}
    @media(min-width:760px){.review-layout{grid-template-columns:1fr 1fr;align-items:start}.decision-card{position:sticky;top:10px}}
  </style>
</head>
<body>
<div class="app">
  <header class="mitra-task-header">
    <div class="mitra-task-header-inner">
      <a class="mitra-back" href="/mitra/conflicts">←</a>
      <div class="mitra-task-title">
        <h1>Conflict #<%= conflict.id %> · Booking #<%= conflict.bookingId %></h1>
      </div>
      <%
        const topStatusClass = conflict.status === 'PENDING' ? 'amber' : conflict.status === 'IN_PROGRESS' ? 'blue' : conflict.status === 'SOLVED' ? 'green' : 'red';
      %>
      <span class="mitra-chip <%= topStatusClass %>"><%= String(conflict.status || '').replaceAll('_',' ') %></span>
    </div>
  </header>

  <main class="scroll-area">
    <div class="mitra-page">
      <div class="review-layout">
        <div>
          <section class="mitra-card mitra-card-pad">
            <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
              <div>
                <div class="mitra-card-title"><%= String(conflict.requestedAction || 'Issue').replaceAll('_',' ') %></div>
                <div class="mitra-card-sub"><%= conflict.reason || '-' %></div>
              </div>
              <span class="mitra-chip"><%= conflict.raisedByType || '-' %></span>
            </div>
            <% if (conflict.description) { %><div class="mitra-card-sub" style="margin-top:10px;color:#374151"><%= conflict.description %></div><% } %>
          </section>

          <section class="mitra-card mitra-card-pad">
            <div class="mitra-detail-grid">
              <div class="mitra-detail-cell">
                <label>Client</label><p><%= conflict.customer?.name || '-' %></p>
                <% if (conflict.customer?.phone) { %><a href="tel:<%= conflict.customer.phone %>" style="color:#047857"><%= conflict.customer.phone %></a><% } %>
              </div>
              <div class="mitra-detail-cell">
                <label>Worker</label><p><%= conflict.worker?.name || 'Full booking' %></p>
                <% if (conflict.worker?.phone) { %><a href="tel:<%= conflict.worker.phone %>" style="color:#047857"><%= conflict.worker.phone %></a><% } %>
              </div>
            </div>
          </section>

          <section class="mitra-card mitra-card-pad">
            <div class="mitra-detail-grid">
              <div class="mitra-detail-cell"><label>Booking</label><p>₹<%= conflict.totalBookingAmount || 0 %></p></div>
              <div class="mitra-detail-cell"><label>Per Worker</label><p>₹<%= conflict.perWorkerAmount || 0 %></p></div>
              <div class="mitra-detail-cell"><label>Suggested Refund</label><p>₹<%= conflict.suggestedRefundAmount || 0 %></p></div>
              <div class="mitra-detail-cell"><label>Penalty</label><p>₹<%= conflict.penaltyAmount || 0 %></p></div>
            </div>
          </section>

          <section class="mitra-card" style="overflow:hidden">
            <div style="padding:12px 14px;border-bottom:1px solid #f3f4f6;font-size:13px;font-weight:900">Timeline</div>
            <div style="padding:4px 14px 8px">
              <% if (!conflict.timeline || !conflict.timeline.length) { %>
                <div class="mitra-card-sub" style="padding:10px 0">No timeline yet.</div>
              <% } else { %>
                <% conflict.timeline.forEach((item, index) => { %>
                  <div style="display:flex;gap:10px;padding:10px 0;<%= index < conflict.timeline.length - 1 ? 'border-bottom:1px solid #f3f4f6' : '' %>">
                    <div style="width:24px;height:24px;border-radius:999px;background:#ecfdf5;color:#059669;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;flex:0 0 24px">✓</div>
                    <div style="min-width:0;flex:1">
                      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                        <strong style="font-size:11px;color:#111827"><%= item.oldStatus || 'NEW' %> → <%= item.newStatus %></strong>
                        <span class="mitra-card-sub" style="white-space:nowrap"><%= new Date(item.createdAt).toLocaleDateString('en-IN') %></span>
                      </div>
                      <% if (item.note) { %><div class="mitra-card-sub" style="margin-top:3px;color:#4b5563"><%= item.note %></div><% } %>
                      <div class="mitra-card-sub" style="margin-top:3px;font-size:10px">By: <%= item.updatedByType || 'SYSTEM' %></div>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </section>
        </div>

        <section class="mitra-card mitra-card-pad decision-card">
          <div class="mitra-card-title" style="margin-bottom:12px">Decision</div>
          <form id="conflictStatusForm" method="POST" action="/mitra/conflicts/<%= conflict.id %>/status" style="display:grid;gap:10px">
            <label>
              <span class="input-label">Status</span>
              <select id="conflictStatus" name="status" required class="mitra-input">
                <option value="PENDING" <%= conflict.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
                <option value="IN_PROGRESS" <%= conflict.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
                <option value="SOLVED" <%= conflict.status === 'SOLVED' ? 'selected' : '' %>>Solved</option>
                <option value="UNRESOLVED" <%= conflict.status === 'UNRESOLVED' ? 'selected' : '' %>>Unresolved</option>
              </select>
            </label>

            <% if (conflict.raisedByType === 'WORKER' && conflict.requestedAction === 'CANCEL_DUTY') { %>
              <label id="workerPenaltyField">
                <span class="input-label">Worker Penalty (₹)</span>
                <input id="penaltyAmount" name="penaltyAmount" type="number" min="0" step="1" value="<%= conflict.penaltyAmount || 0 %>" inputmode="numeric" class="mitra-input" />
              </label>
            <% } %>

            <label>
              <span class="input-label">Mitra Note</span>
              <textarea name="note" rows="4" required class="mitra-input" style="resize:vertical" placeholder="Add decision note"></textarea>
            </label>

            <button class="mitra-primary-btn" style="width:100%;min-height:48px" type="submit">Save Update</button>
          </form>
        </section>
      </div>
    </div>
  </main>

  <%- include('./partials/bottom-nav', { activePage: 'conflicts' }) %>
</div>
<script>
  (() => {
    const statusSelect = document.getElementById('conflictStatus');
    const penaltyInput = document.getElementById('penaltyAmount');
    if (!statusSelect || !penaltyInput) return;
    const syncPenaltyRequirement = () => { penaltyInput.required = statusSelect.value === 'SOLVED'; };
    statusSelect.addEventListener('change', syncPenaltyRequirement);
    syncPenaltyRequirement();
  })();
</script>
</body>
</html>
