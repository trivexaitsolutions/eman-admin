<aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-stone-900 text-stone-300 flex flex-col z-30 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl">
    
    <div class="h-16 flex items-center justify-between px-6 border-b border-stone-800 bg-stone-950">
        <span class="text-xl font-bold text-white tracking-wider">
            E-<span class="text-emerald-500">man</span>
        </span>
        <button onclick="toggleSidebar()" class="md:hidden text-stone-400 hover:text-white focus:outline-none">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <p class="px-2 text-xs font-semibold text-stone-500 uppercase tracking-wider mb-4">Navigation</p>
        
        <% navItems.forEach(item => { %>
            <% if (user && item.roles.includes(user.role)) { %>
                <% const isActive = currentPath.startsWith(item.path); %>
                <a href="<%= item.path %>" 
                   class="flex items-center px-2 py-2.5 rounded-lg group transition-colors 
                          <%= isActive ? 'bg-emerald-600/10 text-emerald-400' : 'hover:bg-stone-800 hover:text-white' %>">
                    <svg class="w-5 h-5 mr-3 <%= isActive ? 'text-emerald-500' : 'text-stone-400 group-hover:text-stone-300' %>" 
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <%- item.icon %>
                    </svg>
                    <%= item.name %>
                </a>
            <% } %>
        <% }) %>
    </nav>

    <div class="p-4 border-t border-stone-800 bg-stone-950 flex items-center">
        <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm mr-3 uppercase shrink-0">
            <%= user ? user.name.charAt(0) : 'U' %>
        </div>
        <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate"><%= user ? user.name : 'Admin' %></p>
            <p class="text-xs text-stone-500 capitalize truncate"><%= user ? user.role : '' %></p>
        </div>
    </div>
</aside>