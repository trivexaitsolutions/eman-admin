<aside id="sidebar" class="fixed inset-y-0 left-0 w-60 bg-stone-950 text-stone-300 flex flex-col z-30 transform -translate-x-full md:relative md:translate-x-0 transition-transform duration-300 ease-in-out shadow-2xl">
    <div class="h-16 flex items-center justify-between px-5 border-b border-stone-800">
        <a href="/admin/dashboard" class="text-xl font-bold text-white tracking-wider">
            E-<span class="text-emerald-500">man</span>
        </a>
        <button onclick="toggleSidebar()" class="md:hidden text-stone-400 hover:text-white" aria-label="Close menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
    </div>

    <nav class="flex-1 px-3 py-4 space-y-2 overflow-y-auto">
        <% const role = String(user?.role || '').toLowerCase(); %>
        <% navGroups.forEach((group) => { %>
            <% const visibleItems = group.items.filter((item) => item.roles.includes(role)); %>
            <% if (visibleItems.length === 0) return; %>
            <% const groupActive = group.items.some((item) => item.exact ? currentPath.split('?')[0] === item.path : currentPath.startsWith(item.path)); %>

            <% if (!group.name) { %>
                <% visibleItems.forEach((item) => { const active = item.exact ? currentPath.split('?')[0] === item.path : currentPath.startsWith(item.path); %>
                    <a href="<%= item.path %>" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition <%= active ? 'bg-emerald-500/15 text-emerald-400' : 'hover:bg-stone-900 hover:text-white' %>">
                        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%- item.icon %></svg>
                        <span><%= item.name %></span>
                    </a>
                <% }) %>
            <% } else { %>
                <details class="group rounded-xl" <%= groupActive ? 'open' : '' %>>
                    <summary class="list-none cursor-pointer flex items-center justify-between px-3 py-2 text-[11px] font-bold uppercase tracking-[0.12em] text-stone-500 hover:text-stone-300">
                        <span><%= group.name %></span>
                        <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </summary>
                    <div class="mt-1 space-y-1">
                        <% visibleItems.forEach((item) => { const active = item.exact ? currentPath.split('?')[0] === item.path : currentPath.startsWith(item.path); %>
                            <a href="<%= item.path %>" class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition <%= active ? 'bg-emerald-500/15 text-emerald-400' : 'text-stone-400 hover:bg-stone-900 hover:text-white' %>">
                                <svg class="w-4.5 h-4.5 shrink-0" style="width:18px;height:18px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><%- item.icon %></svg>
                                <span><%= item.name %></span>
                            </a>
                        <% }) %>
                    </div>
                </details>
            <% } %>
        <% }) %>
    </nav>

    <div class="px-4 py-3 border-t border-stone-800 flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm uppercase shrink-0">
            <%= user?.name ? user.name.charAt(0) : 'U' %>
        </div>
        <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-white truncate"><%= user?.name || 'Admin' %></p>
            <p class="text-[11px] text-stone-500 capitalize truncate"><%= user?.role || '' %></p>
        </div>
    </div>
</aside>
