<header class="h-16 bg-white flex items-center justify-between px-4 md:px-6 z-10 border-b border-stone-200 shrink-0">
    <div class="flex items-center min-w-0">
        <button onclick="toggleSidebar()" class="mr-3 md:hidden text-stone-500 hover:text-stone-800" aria-label="Open menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <h2 class="text-lg font-bold text-stone-900 truncate"><%= pageTitle %></h2>
    </div>

    <a href="/admin/logout" class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-semibold text-stone-500 hover:bg-red-50 hover:text-red-600 transition" title="Logout">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span class="hidden sm:inline">Logout</span>
    </a>
</header>
