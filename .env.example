# Copy to .env on the server and insert your own credentials. Never commit .env.
DATABASE_URL="mysql://USER:URL_ENCODED_PASSWORD@localhost:3306/DATABASE_NAME"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
PORT=3500
NODE_ENV=production

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Gmail SMTP account used for Customer OTP emails.
MAIL_USER=""
MAIL_APP_PASSWORD=""

# OPTIONAL: RazorpayX is a separate account-validation product and must be
# enabled by Razorpay. Without these, the UPI Verify button says unavailable.
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""
RAZORPAYX_SOURCE_ACCOUNT_NUMBER=""

POOL_START_HOUR=8
POOL_START_MINUTE=0
POOL_END_HOUR=23
POOL_END_MINUTE=59
SIMULATOR_ENABLED=false
DEMO_OTP_ENABLED=false
ARRIVAL_CODE_SECRET="CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET"

# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Back up this key; losing it makes encrypted Admin API settings unreadable.
API_SETTINGS_ENCRYPTION_KEY=""
# Optional MSG91 defaults before first Admin save (store no real keys in ZIPs).
MSG91_SMS_AUTH_KEY=""
MSG91_SMS_TEMPLATE_ID=""
MSG91_WHATSAPP_AUTH_KEY=""
MSG91_WHATSAPP_SENDER=""
MSG91_WHATSAPP_TEMPLATE=""
MSG91_WHATSAPP_LANGUAGE="en"
