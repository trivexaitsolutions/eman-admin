generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Admins who log into this panel
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Added for auditing
}

// Master Data
model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nakas     Naka[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Naka {
  id        Int      @id @default(autoincrement())
  name      String
  pincode   String?  // <--- ADD THIS LINE
  latitude  Float?   
  longitude Float?   
  cityId    Int
  city      City     @relation(fields: [cityId], references: [id])
  workers   Worker[] 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?     @db.Text
  isActive    Boolean     @default(true)
  rates       SkillRate[] // This links to our dynamic pricing tiers
  workers     Worker[]    // Keeps the link to the workers
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
}

model SkillRate {
  id        Int      @id @default(autoincrement())
  skillId   Int
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  star      Float    // Using Float allows for 1, 2, 3, but also 3.5 or 4.5!
  rate      Float    
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([skillId, star]) // Prevents having two different prices for "3 stars"
}

model Worker {
  id                Int       @id @default(autoincrement())
  name              String

  // --- NEW LOGIN FIELDS ---
  phone             String    @unique
  email             String?   @unique // Optional, as some laborers might not have email
  password          String
  // ------------------------
  
  dob               DateTime  @db.Date
  age               Int
  qualification     String?
  photoUrl          String?   // Path to the uploaded photo
  idProofType       String    // AADHAR, PAN, VOTING, DRIVING
  idNumber          String    @unique
  consentVoiceUrl   String?   // Path to the uploaded voice recording
  address           String    @db.Text
  pincode           String
  
  // Payment Details (Optional, but one should ideally be filled)
  bankDetails       String?   @db.Text 
  upiId             String?
  upiNumber         String?
  
  isActive          Boolean   @default(true)
  
  // Many-to-Many Relationships
  nakas             Naka[]    // Allows assigning up to 3 Nakas
  skills            Skill[]   // Allows assigning multiple skills
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  isAvailable Boolean  @default(false) // Naya field!
  lastActive  DateTime @default(now())
  bookings    Booking[]
  pushToken         String?   @db.Text // @db.Text isliye kyunki Expo token thoda lamba hota hai
}

model Customer {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String    @unique
  email       String    @unique
  
  // OTP ke liye fields
  otp         String?   
  otpExpiry   DateTime? 

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]
  pushToken String?
}

model Booking {
  id          Int      @id @default(autoincrement())
  customerId  Int
  nakaId      Int
  skillId     Int
  workerCount Int
  
  // STATUS update kiya: Pehle PENDING rahega, pay hone ke baad ASSIGNED hoga
  status      String   @default("PENDING") // "PENDING", "ASSIGNED", "COMPLETED", "CANCELLED"
  
  // --- NAYE PAYMENT FIELDS ---
  amount            Float?   
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  // ---------------------------
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer    Customer @relation(fields: [customerId], references: [id])
  workers     Worker[] 
  arrivedWorkerIds  String  @default("[]")  // NAYA FIELD
}

