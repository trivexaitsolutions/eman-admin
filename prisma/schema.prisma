generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Admins who log into this panel
model Employee {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee")
}

// Master Data
model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nakas     Naka[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("city")
}

model Naka {
  id        Int      @id @default(autoincrement())
  name      String
  pincode   String?
  latitude  Float?
  longitude Float?

  cityId Int
  city   City @relation(fields: [cityId], references: [id])

  workers Worker[] @relation("nakatoworker")
  mitras  Mitra[]  @relation("mitratonaka")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("naka")
}

model Mitra {
  id       Int     @id @default(autoincrement())
  name     String
  phone    String  @unique
  email    String? @unique
  password String
  photoUrl String?
  isActive Boolean @default(true)

  nakas     Naka[]     @relation("mitratonaka")
  workers   Worker[]
  customers Customer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mitra")
}

model Skill {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?     @db.Text
  imageUrl    String?
  isActive    Boolean     @default(true)

  rates   SkillRate[]
  workers Worker[] @relation("skilltoworker")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("skill")
}

model SkillRate {
  id      Int   @id @default(autoincrement())
  skillId Int
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  star Float
  rate Float

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([skillId, star])
  @@map("skillrate")
}

model Worker {
  id   Int    @id @default(autoincrement())
  name String

  phone    String  @unique
  email    String? @unique
  password String

  dob           DateTime @db.Date
  age           Int
  qualification String?
  photoUrl      String?

  // AADHAR / PAN / VOTING / DRIVING
  idProofType String

  // Legacy mirror field
  idNumber String @unique

  aadhaarNumber String? @unique
  panNumber     String? @unique
  otherIdNumber String? @unique

  consentVoiceUrl String?
  address         String  @db.Text
  pincode         String

  gender   String?
  heightCm Float?
  weightKg Float?
  bmi      Float?

  bankDetails String? @db.Text
  upiId       String?
  upiNumber   String?

  isActive Boolean @default(true)

  nakas    Naka[]    @relation("nakatoworker")
  skills   Skill[]   @relation("skilltoworker")
  bookings Booking[] @relation("bookingtoworker")

  isAvailable Boolean  @default(false)
  lastActive  DateTime @default(now())

  pushToken String? @db.Text

  mitraId Int?
  mitra   Mitra? @relation(fields: [mitraId], references: [id])

  availabilityType  String?
  availabilityStart DateTime?
  availabilityHours Int?
  availabilityUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("worker")
}

model Customer {
  id    Int     @id @default(autoincrement())
  phone String  @unique
  email String? @unique
  name  String

  clientType        String?
  businessName      String?
  businessType      String?
  siteAddress       String? @db.Text
  gstNumber         String?
  workerRequirement String?

  otp        String?
  otpExpiry  DateTime?
  isVerified Boolean @default(false)
  pushToken  String? @db.Text

  mitraId Int?
  mitra   Mitra? @relation(fields: [mitraId], references: [id])

  bookings  Booking[]
  addresses CustomerAddress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customer")
}

model Booking {
  id          Int @id @default(autoincrement())
  customerId  Int
  nakaId      Int
  skillId     Int
  workerCount Int

  status String @default("PENDING")

  amount            Float?
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  customer Customer @relation(fields: [customerId], references: [id])
  workers  Worker[] @relation("bookingtoworker")

  arrivedWorkerIds   String  @default("[]")
  cancelledWorkerIds String  @default("[]")
  completedWorkerIds String? @db.Text

  isRated Boolean @default(false)

  ratings             Rating[]
  conflicts           Conflict[]
  workerClientRatings WorkerClientRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("booking")
}

model Rating {
  id        Int      @id @default(autoincrement())
  bookingId Int
  workerId  Int
  mehnat    Int
  vyavhaar  Int
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("rating")
}

model WorkerClientRating {
  id Int @id @default(autoincrement())

  bookingId  Int
  workerId   Int
  customerId Int

  rating           Int
  behaviour        Int?
  locationAccuracy Int?
  coordination     Int?
  comment          String? @db.Text

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, workerId])
  @@map("workerclientrating")
}

model Conflict {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id])

  raisedByType ConflictRaisedBy
  raisedById   Int?

  customerId Int?
  workerId   Int?
  mitraId    Int?

  reason      String
  description String?

  penaltyAmount Int?
  status        ConflictStatus @default(PENDING)

  continueWork    Boolean @default(true)
  requestedAction String?

  timeline ConflictTimeline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conflict")
}

model ConflictTimeline {
  id Int @id @default(autoincrement())

  conflictId Int
  conflict   Conflict @relation(fields: [conflictId], references: [id])

  updatedByType ConflictUpdatedBy
  updatedById   Int?

  oldStatus ConflictStatus?
  newStatus ConflictStatus

  note String?

  createdAt DateTime @default(now())

  @@map("conflicttimeline")
}

model CustomerAddress {
  id         Int @id @default(autoincrement())
  customerId Int

  title    String?
  fullName String?
  phone    String?

  addressLine   String
  addressDetail String? @db.Text
  mapAddress    String? @db.Text
  landmark      String?

  cityId Int?
  city   String?

  nakaId   Int?
  nakaName String?

  state   String?
  pincode String?

  latitude  String?
  longitude String?

  placeId        String?
  locationSource String?

  isDefault Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customeraddress")
}

enum ConflictRaisedBy {
  CLIENT
  WORKER
}

enum ConflictStatus {
  PENDING
  IN_PROGRESS
  SOLVED
  UNRESOLVED
}

enum ConflictUpdatedBy {
  ADMIN
  MITRA
  SYSTEM
}