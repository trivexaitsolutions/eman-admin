<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-stone-900 md:text-3xl">Master: States &amp; Union Territories</h1>
    <p class="mt-1 text-sm text-stone-500">System master used to keep every City and Naka geographically consistent.</p>
  </div>
  <a href="/admin/cities/create" class="inline-flex items-center justify-center rounded-xl bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700">
    Add City
  </a>
</div>

<div class="mb-5 rounded-xl border border-sky-200 bg-sky-50 px-4 py-3 text-sm text-sky-900">
  States are pre-seeded and read-only. Add cities and their exact PIN codes from <a href="/admin/cities" class="font-bold underline">Master: Cities</a>.
</div>

<div class="hidden overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm md:block">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[720px] text-left">
      <thead class="border-b border-stone-200 bg-stone-50">
        <tr>
          <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">State / Union Territory</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">Code</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">Type</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">Cities</th>
          <th class="px-6 py-4 text-xs font-semibold uppercase text-stone-500">Mapped PIN Codes</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-100">
        <% states.forEach(state => { %>
          <tr class="hover:bg-stone-50">
            <td class="px-6 py-4 font-bold text-stone-900"><%= state.name %></td>
            <td class="px-6 py-4"><span class="rounded bg-stone-100 px-2 py-1 font-mono text-xs font-bold text-stone-700"><%= state.code %></span></td>
            <td class="px-6 py-4 text-sm text-stone-600"><%= state.type === 'UNION_TERRITORY' ? 'Union Territory' : 'State' %></td>
            <td class="px-6 py-4 text-sm font-semibold text-stone-700"><%= state._count.cities %></td>
            <td class="px-6 py-4 text-sm font-semibold text-stone-700"><%= state.pincodeCount %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="grid grid-cols-1 gap-4 md:hidden">
  <% states.forEach(state => { %>
    <article class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div>
          <p class="font-bold text-stone-900"><%= state.name %></p>
          <p class="mt-1 text-xs text-stone-500"><%= state.type === 'UNION_TERRITORY' ? 'Union Territory' : 'State' %></p>
        </div>
        <span class="rounded bg-stone-100 px-2 py-1 font-mono text-xs font-bold text-stone-700"><%= state.code %></span>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3 rounded-xl bg-stone-50 p-3 text-xs">
        <div><p class="text-stone-400">Cities</p><p class="mt-1 font-bold text-stone-700"><%= state._count.cities %></p></div>
        <div><p class="text-stone-400">Mapped PINs</p><p class="mt-1 font-bold text-stone-700"><%= state.pincodeCount %></p></div>
      </div>
    </article>
  <% }) %>
</div>
