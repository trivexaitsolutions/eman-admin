<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Submit Naka | E-MAN Mitra</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    html, body { margin:0; width:100%; min-height:100%; background:#f8fafc; font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
    .app { min-height:100dvh; max-width:720px; margin:0 auto; background:#f8fafc; }
    .app-input { width:100%; border:1.5px solid #e5e7eb; background:#fff; border-radius:18px; padding:14px 16px; outline:none; font-size:15px; font-weight:700; color:#111827; transition:.2s ease; }
    .app-input:focus { border-color:#10b981; box-shadow:0 0 0 4px rgba(16,185,129,.1); }
    .app-input:disabled { background:#f1f5f9; color:#94a3b8; }
    .input-label { display:block; font-size:11px; font-weight:900; color:#64748b; text-transform:uppercase; letter-spacing:.06em; margin-bottom:7px; }
    .section-card { background:#fff; border:1px solid #f1f5f9; border-radius:28px; padding:20px; box-shadow:0 8px 24px rgba(15,23,42,.04); }
  </style>
</head>
<body>
  <div class="app px-5 pb-12 pt-5 md:px-8 md:pt-8">
    <a href="/mitra/nakas" class="inline-flex items-center gap-2 text-sm font-black text-slate-500 hover:text-emerald-700">← Back to My Nakas</a>

    <section class="mt-5 rounded-[30px] bg-gradient-to-br from-emerald-600 to-teal-700 p-6 text-white shadow-xl shadow-emerald-100">
      <p class="text-sm font-bold text-emerald-100">Ground Survey Submission</p>
      <h1 class="mt-1 text-3xl font-black">Submit a Naka</h1>
      <p class="mt-3 text-sm font-semibold leading-5 text-emerald-50">Aap survey details submit karoge. Admin verify karega. Submit hote hi Naka aapko assign ho jayega, lekin operational use Admin approval ke baad hi hoga.</p>
    </section>

    <% if (error_msg) { %><div class="mt-5 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700"><%= error_msg %></div><% } %>

    <form id="mitraNakaForm" action="/mitra/nakas/submit" method="POST" enctype="multipart/form-data" class="mt-5 space-y-5">
      <section class="section-card">
        <div class="mb-5"><h2 class="text-xl font-black text-slate-900">1. Area & Naka</h2><p class="mt-1 text-sm font-semibold text-slate-500">Pehle State aur City select karo.</p></div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="input-label" for="stateId">State / Union Territory *</label>
            <select id="stateId" name="stateId" required class="app-input">
              <option value="">-- Select State / UT --</option>
              <% states.forEach(state => { %><option value="<%= state.id %>"><%= state.name %> (<%= state.code %>)<%= state.type === 'UNION_TERRITORY' ? ' — UT' : '' %></option><% }) %>
            </select>
          </div>
          <div>
            <label class="input-label" for="cityId">City *</label>
            <select id="cityId" name="cityId" required disabled class="app-input">
              <option value="">-- Select State first --</option>
              <% cities.forEach(city => { %><option value="<%= city.id %>" data-state-id="<%= city.stateId %>" hidden disabled><%= city.name %></option><% }) %>
            </select>
            <p id="cityHelp" class="mt-2 min-h-5 text-xs font-semibold text-slate-500">Select a State to see its Cities.</p>
          </div>
        </div>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="input-label" for="name">Naka / Chouk Name *</label>
            <input id="name" name="name" required minlength="2" maxlength="120" placeholder="Example: Station Road Naka" class="app-input" />
          </div>
          <div>
            <label class="input-label" for="pincode">PIN Code *</label>
            <input id="pincode" name="pincode" type="text" inputmode="numeric" autocomplete="postal-code" required minlength="6" maxlength="6" pattern="[0-9]{6}" placeholder="Example: 421201" class="app-input" />
            <p class="mt-2 text-xs font-semibold text-slate-500">Abhi manually enter karo. Later exact map location se PIN Code auto-fill hoga.</p>
          </div>
        </div>
        <div class="mt-4">
          <label class="input-label" for="landmark">Nearest Landmark</label>
          <input id="landmark" name="landmark" maxlength="191" placeholder="Example: Opposite bus depot" class="app-input" />
        </div>
      </section>

      <section class="section-card">
        <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
          <div><h2 class="text-xl font-black text-slate-900">2. Exact Location</h2><p class="mt-1 text-sm font-semibold text-slate-500">Current location capture karo, ya map par exact labour gathering point select karo.</p></div>
          <button id="useCurrentLocationBtn" type="button" class="shrink-0 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-black text-emerald-700 hover:bg-emerald-100">Use Current Location</button>
        </div>
        <div id="locationStatus" class="mb-4 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-bold text-amber-800">Exact GPS location mandatory hai.</div>
        <div id="map" class="overflow-hidden rounded-3xl border border-slate-200" style="height:360px"></div>
        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div><label class="input-label" for="latitude">Latitude *</label><input id="latitude" name="latitude" readonly required placeholder="Map point select karo" class="app-input cursor-not-allowed" /></div>
          <div><label class="input-label" for="longitude">Longitude *</label><input id="longitude" name="longitude" readonly required placeholder="Map point select karo" class="app-input cursor-not-allowed" /></div>
        </div>
      </section>

      <section class="section-card">
        <div class="mb-5"><h2 class="text-xl font-black text-slate-900">3. Survey Proof</h2><p class="mt-1 text-sm font-semibold text-slate-500">Yeh details Admin ko verification ke liye dikhengi.</p></div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div>
            <label class="input-label" for="confidenceLevel">Confidence *</label>
            <select id="confidenceLevel" name="confidenceLevel" required class="app-input">
              <option value="">-- Select --</option>
              <option value="HIGH">High — known labour gathering</option>
              <option value="MEDIUM">Medium — likely gathering</option>
              <option value="LOW">Low — lead to be checked</option>
              <option value="N_A">N/A — survey from zero</option>
            </select>
          </div>
          <div><label class="input-label" for="surveyDate">Survey Date *</label><input id="surveyDate" type="date" name="surveyDate" max="<%= new Date().toISOString().slice(0, 10) %>" required class="app-input" /></div>
          <div><label class="input-label" for="peakHourHeadcount">Peak-hour workers *</label><input id="peakHourHeadcount" type="number" name="peakHourHeadcount" min="0" max="1000000" step="1" required placeholder="0" class="app-input" /></div>
        </div>
        <div class="mt-4">
          <label class="input-label" for="verificationPhoto">Naka Verification Photo *</label>
          <input id="verificationPhoto" type="file" name="verificationPhoto" accept="image/jpeg,image/png,image/webp" required class="block w-full rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-bold text-slate-600 file:mr-3 file:rounded-xl file:border-0 file:bg-emerald-100 file:px-3 file:py-2 file:font-black file:text-emerald-700" />
          <p class="mt-2 text-xs font-semibold text-slate-500">JPG, PNG ya WEBP • maximum 5 MB.</p>
        </div>
        <div class="mt-4"><label class="input-label" for="surveyNotes">Survey Notes</label><textarea id="surveyNotes" name="surveyNotes" rows="4" maxlength="3000" placeholder="Peak time, skill mix, location detail, ya koi important observation..." class="app-input resize-y"></textarea></div>
      </section>

      <section class="rounded-3xl border border-sky-200 bg-sky-50 p-5 text-sm font-bold leading-6 text-sky-900">Submit karne ke baad status <strong>Pending Admin Verification</strong> rahega. Aap khud Naka ko verified nahi kar sakte. Admin approval ke baad hi yeh customer/worker operations mein aayega.</section>

      <button type="submit" class="w-full rounded-2xl bg-emerald-600 px-5 py-4 text-base font-black text-white shadow-lg shadow-emerald-200 hover:bg-emerald-700">Submit for Admin Verification</button>
    </form>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const stateSelect = document.getElementById('stateId');
    const citySelect = document.getElementById('cityId');
    const cityHelp = document.getElementById('cityHelp');
    const pincodeInput = document.getElementById('pincode');
    const latitudeInput = document.getElementById('latitude');
    const longitudeInput = document.getElementById('longitude');
    const locationStatus = document.getElementById('locationStatus');
    const useCurrentLocationBtn = document.getElementById('useCurrentLocationBtn');

    function refreshCityOptions() {
      const stateId = stateSelect.value;
      let visible = 0;
      Array.from(citySelect.options).forEach((option, index) => {
        if (index === 0) return;
        const allowed = Boolean(stateId) && option.dataset.stateId === stateId;
        option.hidden = !allowed;
        option.disabled = !allowed;
        if (allowed) visible += 1;
      });
      citySelect.disabled = !stateId;
      citySelect.value = '';
      cityHelp.textContent = !stateId ? 'Select a State to see its Cities.' : visible ? `${visible} ${visible === 1 ? 'City' : 'Cities'} available.` : 'No City exists for this State. Please contact Admin.';
    }
    stateSelect.addEventListener('change', refreshCityOptions);

    pincodeInput.addEventListener('input', () => {
      pincodeInput.value = pincodeInput.value.replace(/\D/g, '').slice(0, 6);
    });

    const map = L.map('map').setView([19.2183, 73.0867], 13);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution:'© OpenStreetMap contributors', maxZoom:19 }).addTo(map);
    let marker = null;

    function setLocation(lat, lng, zoom = true) {
      const latitude = Number(lat), longitude = Number(lng);
      if (!Number.isFinite(latitude) || !Number.isFinite(longitude)) return;
      if (!marker) {
        marker = L.marker([latitude, longitude], { draggable:true }).addTo(map);
        marker.on('dragend', () => { const point = marker.getLatLng(); setLocation(point.lat, point.lng, false); });
      } else marker.setLatLng([latitude, longitude]);
      latitudeInput.value = latitude.toFixed(6);
      longitudeInput.value = longitude.toFixed(6);
      locationStatus.className = 'mb-4 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-bold text-emerald-800';
      locationStatus.textContent = 'Exact Naka location selected. Pin drag karke ya map par click karke adjust kar sakte ho.';
      if (zoom) map.setView([latitude, longitude], 16);
    }

    map.on('click', (event) => setLocation(event.latlng.lat, event.latlng.lng));
    useCurrentLocationBtn.addEventListener('click', () => {
      if (!navigator.geolocation) { locationStatus.textContent = 'Browser current location support nahi karta. Map par point select karo.'; return; }
      useCurrentLocationBtn.disabled = true; useCurrentLocationBtn.textContent = 'Getting location…';
      navigator.geolocation.getCurrentPosition(
        (position) => { setLocation(position.coords.latitude, position.coords.longitude); useCurrentLocationBtn.disabled = false; useCurrentLocationBtn.textContent = 'Use Current Location'; },
        () => { locationStatus.className = 'mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-bold text-red-700'; locationStatus.textContent = 'Location unavailable. Permission allow karo ya map par manually select karo.'; useCurrentLocationBtn.disabled = false; useCurrentLocationBtn.textContent = 'Use Current Location'; },
        { enableHighAccuracy:true, timeout:12000, maximumAge:0 }
      );
    });

    document.getElementById('mitraNakaForm').addEventListener('submit', (event) => {
      if (!stateSelect.value || !citySelect.value) { event.preventDefault(); alert('Please select State and City.'); return; }
      if (!/^\d{6}$/.test(pincodeInput.value)) { event.preventDefault(); alert('Please enter a valid 6-digit PIN code.'); pincodeInput.focus(); return; }
      const selected = citySelect.options[citySelect.selectedIndex];
      if (!selected || selected.dataset.stateId !== stateSelect.value) { event.preventDefault(); alert('Selected City does not belong to the selected State.'); return; }
      if (!latitudeInput.value || !longitudeInput.value) { event.preventDefault(); alert('Please capture the exact Naka location.'); return; }
      if (!document.getElementById('verificationPhoto').files.length) { event.preventDefault(); alert('Please upload a Naka verification photo.'); return; }
    });
  </script>
</body>
</html>
