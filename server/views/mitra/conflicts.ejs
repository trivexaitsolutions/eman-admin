<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>E-MAN Mitra Conflicts</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      overscroll-behavior: none;
      background: #e5e7eb;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    .app {
      width: 100%;
      height: 100dvh;
      background: #f8fafc;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      margin: 0 auto;
    }
    .scroll-area {
      flex: 1;
      overflow-y: auto;
      padding-bottom: 112px;
    }
    .scroll-area::-webkit-scrollbar { display: none; }
    .bottom-safe { padding-bottom: max(16px, env(safe-area-inset-bottom)); }
    @media (max-width: 767px) {
      .app { max-width: 430px; }
      .tablet-nav { display: none; }
      .tablet-container { width: 100%; }
    }
    @media (min-width: 768px) {
      .app { max-width: 100%; background: #eef2f7; }
      .tablet-container { max-width: 1120px; margin: 0 auto; }
      .scroll-area { padding-bottom: 40px; }
      .mobile-bottom-nav { display: none; }
    }
  </style>
</head>

<body>
<div class="app">

  <header class="bg-white px-5 md:px-8 pt-5 pb-4 border-b border-gray-100">
    <div class="tablet-container">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
          <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-emerald-500 flex items-center justify-center shadow-lg shadow-emerald-200">
            <span class="text-white text-xl md:text-2xl font-black"><%= mitra?.name ? mitra.name.charAt(0) : 'M' %></span>
          </div>

          <div class="min-w-0">
            <p class="text-xs font-bold text-emerald-600 uppercase tracking-wide">Mitra Panel</p>
            <h1 class="text-xl md:text-2xl font-black text-gray-900 leading-tight truncate">
              Conflict List
            </h1>
            <p class="text-xs md:text-sm text-gray-500 font-semibold mt-0.5">
              Assigned issues and cancellations
            </p>
          </div>
        </div>

        <a href="/mitra/dashboard" class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 text-xs font-black">
          Dashboard
        </a>
      </div>
    </div>
  </header>

  <nav class="tablet-nav bg-white border-b border-gray-100 px-8 py-3">
    <div class="tablet-container flex items-center gap-3">
      <a href="/mitra/dashboard" class="px-5 py-2.5 rounded-full text-gray-500 text-sm font-bold hover:bg-gray-50">Home</a>
      <a href="/mitra/conflicts" class="px-5 py-2.5 rounded-full bg-emerald-50 text-emerald-600 text-sm font-black">Conflicts</a>
      <a href="/mitra/workers/add" class="px-5 py-2.5 rounded-full text-gray-500 text-sm font-bold hover:bg-gray-50">Add Worker</a>
      <a href="/mitra/clients/add" class="px-5 py-2.5 rounded-full text-gray-500 text-sm font-bold hover:bg-gray-50">Add Client</a>
    </div>
  </nav>

  <main class="scroll-area">
    <div class="tablet-container px-5 md:px-8 pt-5 md:pt-8">

      <section class="bg-white rounded-[28px] border border-gray-100 shadow-sm p-4 md:p-5 mb-5">
        <form method="GET" action="/mitra/conflicts" class="grid grid-cols-2 md:grid-cols-5 gap-3 items-end">
          <div>
            <label class="text-[11px] font-black text-gray-500 uppercase">From</label>
            <input
              type="date"
              name="fromDate"
              value="<%= filters.fromDate %>"
              class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold bg-gray-50"
            />
          </div>

          <div>
            <label class="text-[11px] font-black text-gray-500 uppercase">To</label>
            <input
              type="date"
              name="toDate"
              value="<%= filters.toDate %>"
              class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold bg-gray-50"
            />
          </div>

          <div>
            <label class="text-[11px] font-black text-gray-500 uppercase">Status</label>
            <select
              name="status"
              class="mt-1 w-full border border-gray-200 rounded-xl px-3 py-2 text-xs font-bold bg-gray-50"
            >
              <option value="ALL" <%= filters.status === 'ALL' ? 'selected' : '' %>>All</option>
              <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
              <option value="IN_PROGRESS" <%= filters.status === 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
              <option value="SOLVED" <%= filters.status === 'SOLVED' ? 'selected' : '' %>>Solved</option>
              <option value="UNRESOLVED" <%= filters.status === 'UNRESOLVED' ? 'selected' : '' %>>Unresolved</option>
            </select>
          </div>

          <button class="bg-emerald-500 text-white rounded-xl px-4 py-2 text-xs font-black">
            Apply
          </button>

          <a href="/mitra/conflicts" class="text-center bg-gray-100 text-gray-700 rounded-xl px-4 py-2 text-xs font-black">
            Clear
          </a>
        </form>
      </section>

      <section class="mb-5">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="rounded-[24px] bg-white p-4 border border-gray-100 shadow-sm">
            <p class="text-xs font-black text-gray-400 uppercase">Total</p>
            <p class="text-3xl font-black text-gray-900 mt-1"><%= conflicts.length %></p>
          </div>

          <div class="rounded-[24px] bg-white p-4 border border-yellow-100 shadow-sm">
            <p class="text-xs font-black text-yellow-600 uppercase">Pending</p>
            <p class="text-3xl font-black text-yellow-700 mt-1"><%= conflicts.filter(c => c.status === 'PENDING').length %></p>
          </div>

          <div class="rounded-[24px] bg-white p-4 border border-blue-100 shadow-sm">
            <p class="text-xs font-black text-blue-600 uppercase">Progress</p>
            <p class="text-3xl font-black text-blue-700 mt-1"><%= conflicts.filter(c => c.status === 'IN_PROGRESS').length %></p>
          </div>

          <div class="rounded-[24px] bg-white p-4 border border-red-100 shadow-sm">
            <p class="text-xs font-black text-red-600 uppercase">Refund</p>
            <p class="text-3xl font-black text-red-700 mt-1">
              ₹<%= conflicts.reduce((sum, c) => sum + Number(c.suggestedRefundAmount || 0), 0) %>
            </p>
          </div>
        </div>
      </section>

      <section class="space-y-3">
        <% if (!conflicts || conflicts.length === 0) { %>
          <div class="rounded-[28px] bg-white border border-gray-100 p-10 text-center shadow-sm">
            <div class="text-4xl mb-3">🎉</div>
            <h3 class="font-black text-gray-900 text-lg">No conflicts assigned</h3>
            <p class="text-sm text-gray-500 font-semibold mt-1">Selected filter ke liye koi issue nahi mila.</p>
          </div>
        <% } else { %>
          <% conflicts.forEach((conflict) => { %>
            <a href="/mitra/conflicts/<%= conflict.id %>" class="block rounded-[28px] bg-white border border-gray-100 shadow-sm p-4 md:p-5 active:bg-gray-50">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-sm font-black text-gray-900">C#<%= conflict.id %></span>
                    <span class="text-[10px] font-black bg-gray-100 text-gray-500 px-2 py-1 rounded-md">B#<%= conflict.bookingId %></span>
                  </div>

                  <h3 class="text-base md:text-lg font-black text-gray-900">
                    <%= conflict.requestedAction || 'Issue Raised' %>
                  </h3>

                  <p class="text-sm text-gray-500 font-semibold mt-1 line-clamp-1">
                    <%= conflict.reason %>
                  </p>
                </div>

                <% if (conflict.status === 'PENDING') { %>
                  <span class="bg-yellow-50 text-yellow-700 border border-yellow-100 px-3 py-1 rounded-full text-[11px] font-black">Pending</span>
                <% } else if (conflict.status === 'IN_PROGRESS') { %>
                  <span class="bg-blue-50 text-blue-700 border border-blue-100 px-3 py-1 rounded-full text-[11px] font-black">Progress</span>
                <% } else if (conflict.status === 'SOLVED') { %>
                  <span class="bg-emerald-50 text-emerald-700 border border-emerald-100 px-3 py-1 rounded-full text-[11px] font-black">Solved</span>
                <% } else { %>
                  <span class="bg-red-50 text-red-700 border border-red-100 px-3 py-1 rounded-full text-[11px] font-black">Unresolved</span>
                <% } %>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-4">
                <div class="bg-gray-50 rounded-2xl p-3">
                  <p class="text-[10px] font-black text-gray-400 uppercase">Client</p>
                  <p class="font-black text-gray-900 truncate"><%= conflict.customer?.name || '-' %></p>
                  <% if (conflict.customer?.phone) { %>
                    <p class="text-xs font-black text-emerald-600"><%= conflict.customer.phone %></p>
                  <% } %>
                </div>

                <div class="bg-gray-50 rounded-2xl p-3">
                  <p class="text-[10px] font-black text-gray-400 uppercase">Worker</p>
                  <p class="font-black text-gray-900 truncate"><%= conflict.worker?.name || '-' %></p>
                  <% if (conflict.worker?.phone) { %>
                    <p class="text-xs font-black text-emerald-600"><%= conflict.worker.phone %></p>
                  <% } else { %>
                    <p class="text-xs font-black text-gray-400">Full booking</p>
                  <% } %>
                </div>

                

                <div class="bg-red-50 rounded-2xl p-3">
                  <p class="text-[10px] font-black text-red-500 uppercase">Suggested Refund</p>
                  <p class="font-black text-red-700">₹<%= conflict.suggestedRefundAmount || 0 %></p>
                </div>
              </div>

              <div class="flex items-center justify-between mt-4 pt-3 border-t border-gray-100">
                <p class="text-xs text-gray-400 font-bold">
                  <%= new Date(conflict.createdAt).toLocaleDateString('en-IN') %>
                  <%= new Date(conflict.createdAt).toLocaleTimeString('en-IN') %>
                </p>
                <span class="text-sm font-black text-emerald-600">Review ›</span>
              </div>
            </a>
          <% }) %>
        <% } %>
      </section>

    </div>
  </main>

  <footer class="mobile-bottom-nav fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-100 px-4 pt-3 bottom-safe shadow-[0_-10px_30px_rgba(15,23,42,0.06)]">
    <div class="grid grid-cols-5 items-end max-w-[430px] mx-auto">
      <a href="/mitra/dashboard" class="flex flex-col items-center gap-1 text-gray-400">
        <div class="w-10 h-8 rounded-full flex items-center justify-center"><span class="text-lg">⌂</span></div>
        <span class="text-[11px] font-bold">Home</span>
      </a>

      <a href="/mitra/conflicts" class="flex flex-col items-center gap-1 text-emerald-600">
        <div class="w-10 h-8 rounded-full bg-emerald-50 flex items-center justify-center"><span class="text-lg">⚠</span></div>
        <span class="text-[11px] font-black">Issues</span>
      </a>

      <a href="/mitra/workers/add" class="flex flex-col items-center gap-1 text-emerald-600">
        <div class="w-14 h-14 -mt-8 rounded-full bg-emerald-500 border-4 border-white shadow-lg shadow-emerald-200 flex items-center justify-center">
          <span class="text-white text-3xl font-black leading-none">+</span>
        </div>
        <span class="text-[11px] font-black">Worker</span>
      </a>

      <a href="/mitra/clients/add" class="flex flex-col items-center gap-1 text-gray-400">
        <div class="w-10 h-8 rounded-full flex items-center justify-center"><span class="text-lg">🏢</span></div>
        <span class="text-[11px] font-bold">Client</span>
      </a>

      <a href="/mitra/logout" class="flex flex-col items-center gap-1 text-gray-400">
        <div class="w-10 h-8 rounded-full flex items-center justify-center"><span class="text-lg">↪</span></div>
        <span class="text-[11px] font-bold">Logout</span>
      </a>
    </div>
  </footer>

</div>
</body>
</html>