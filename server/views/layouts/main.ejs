<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>E-man | TrivexaIT Solutions</title>
    
    <!-- 🚀 Tailwind CDN Added Here 🚀 -->
    <script src="https://cdn.tailwindcss.com"></script>

    <link href="/css/style.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style> body { font-family: 'Inter', sans-serif; } </style>
</head>
<body class="bg-stone-100 text-stone-800 antialiased flex h-screen overflow-hidden">

    <div id="sidebarOverlay" class="fixed inset-0 bg-stone-900/50 z-20 hidden md:hidden transition-opacity" onclick="toggleSidebar()"></div>

    <%- include('../partials/sidebar') %>

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <%- include('../partials/topbar') %>

        <main class="flex-1 overflow-x-hidden overflow-y-auto bg-stone-50 p-4 md:p-8">
            <div class="max-w-7xl mx-auto">
                <%- body %>
            </div>
        </main>
    </div>

    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            // Slide the sidebar in/out
            sidebar.classList.toggle('-translate-x-full');
            // Show/hide the dark overlay
            overlay.classList.toggle('hidden');
        }
    </script>
</body>
</html>