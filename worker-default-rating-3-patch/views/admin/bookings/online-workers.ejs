<div class="space-y-6 pb-8">
    <section class="rounded-3xl border border-stone-200 bg-white px-5 py-6 shadow-sm sm:px-7">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <div class="mb-2 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
                    <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
                    Live workforce
                </div>
                <h1 class="text-2xl font-bold tracking-tight text-stone-950 sm:text-3xl">Online Workers</h1>
                <p class="mt-2 text-sm text-stone-500">Kaun online hai, kitni der se hai aur abhi kis booking par hai.</p>
            </div>

            <a href="/admin/bookings" class="inline-flex items-center justify-center rounded-xl border border-stone-200 bg-white px-4 py-2.5 text-sm font-bold text-stone-700 transition hover:bg-stone-50">
                ← Back to Bookings
            </a>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <a href="/admin/bookings/online-workers" class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
            <p class="text-sm font-semibold text-emerald-800">Total Online</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.totalOnline %></p>
            <p class="mt-1 text-xs text-emerald-700">Availability not expired</p>
        </a>
        <a href="/admin/bookings/online-workers?state=available" class="rounded-2xl border border-sky-200 bg-sky-50 p-5">
            <p class="text-sm font-semibold text-sky-800">Available Now</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.totalAvailable %></p>
            <p class="mt-1 text-xs text-sky-700">Can receive a booking</p>
        </a>
        <a href="/admin/bookings/online-workers?state=busy" class="rounded-2xl border border-violet-200 bg-violet-50 p-5">
            <p class="text-sm font-semibold text-violet-800">Busy / Locked</p>
            <p class="mt-2 text-3xl font-black text-stone-950"><%= summary.totalBusy %></p>
            <p class="mt-1 text-xs text-violet-700">On booking or payment hold</p>
        </a>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
        <form method="GET" action="/admin/bookings/online-workers" class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_220px_auto_auto]">
            <input
                type="text"
                name="search"
                value="<%= filters.search %>"
                placeholder="Search worker, phone, Naka or skill..."
                class="rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none transition focus:border-emerald-500 focus:bg-white focus:ring-4 focus:ring-emerald-100"
            >
            <select name="state" class="rounded-xl border border-stone-200 bg-stone-50 px-3.5 py-2.5 text-sm outline-none focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100">
                <option value="">All online workers</option>
                <option value="available" <%= filters.state === "available" ? "selected" : "" %>>Available</option>
                <option value="busy" <%= filters.state === "busy" ? "selected" : "" %>>Busy / Locked</option>
            </select>
            <button type="submit" class="rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-700">Filter</button>
            <a href="/admin/bookings/online-workers" class="rounded-xl border border-stone-200 px-4 py-2.5 text-center text-sm font-semibold text-stone-600 hover:bg-stone-50">Clear</a>
        </form>
    </section>

    <section class="overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-sm">
        <div class="flex flex-col gap-1 border-b border-stone-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="font-bold text-stone-950">Live Worker Status</h2>
                <p class="mt-1 text-xs text-stone-500">Showing <%= pagination.firstRecord %>–<%= pagination.lastRecord %> of <%= pagination.totalRecords %></p>
            </div>
            <span class="text-xs font-semibold text-stone-400">Refresh page for latest timestamps</span>
        </div>

        <% if (rows.length === 0) { %>
            <div class="px-6 py-16 text-center">
                <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-stone-100 text-2xl">🕒</div>
                <h3 class="mt-4 font-bold text-stone-900">No online workers found</h3>
                <p class="mt-1 text-sm text-stone-500">Worker availability window active hone par yahan dikhega.</p>
            </div>
        <% } else { %>
            <div class="grid grid-cols-1 gap-4 p-4 lg:hidden">
                <% rows.forEach(worker => { %>
                    <article class="rounded-2xl border border-stone-200 p-4">
                        <div class="flex items-start gap-3">
                            <div class="h-12 w-12 shrink-0 rounded-full border border-stone-200 bg-stone-100 bg-cover bg-center" style="background-image:url('<%= worker.photoUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(worker.name)}` %>')"></div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-black text-stone-950"><%= worker.name %></p>
                                <p class="mt-1 text-xs text-stone-500"><%= worker.phone %></p>

                                <% if (worker.rating.ratingCount > 0) { %>
                                    <div class="mt-1.5 inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2 py-1">
                                        <span class="text-sm leading-none text-amber-500">★</span>
                                        <span class="text-[11px] font-black text-amber-800"><%= worker.rating.averageRating.toFixed(1) %></span>
                                        <span class="text-[10px] font-semibold text-amber-600">(<%= worker.rating.ratingCount %>)</span>
                                    </div>
                                <% } else { %>
                                    <div class="mt-1.5 inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2 py-1">
                                        <span class="text-sm leading-none text-amber-500">★</span>
                                        <span class="text-[11px] font-black text-amber-800"><%= worker.rating.averageRating.toFixed(1) %></span>
                                        <span class="text-[10px] font-semibold text-amber-600">New</span>
                                    </div>
                                <% } %>
                            </div>
                            <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold <%= worker.stateClasses %>"><%= worker.currentState %></span>
                        </div>

                        <dl class="mt-4 grid grid-cols-2 gap-3 text-xs">
                            <div><dt class="text-stone-400">Online Since</dt><dd class="mt-1 font-bold text-stone-700"><%= worker.onlineSinceFormatted %></dd></div>
                            <div><dt class="text-stone-400">Online For</dt><dd class="mt-1 font-bold text-emerald-700"><%= worker.onlineFor %></dd></div>
                            <div><dt class="text-stone-400">Available Until</dt><dd class="mt-1 font-bold text-stone-700"><%= worker.availableUntilFormatted %></dd></div>
                            <div><dt class="text-stone-400">Last Active</dt><dd class="mt-1 font-bold text-stone-700"><%= worker.lastActiveAgo %></dd></div>
                        </dl>

                        <% if (worker.liveBooking) { %>
                            <a href="/admin/bookings/<%= worker.liveBooking.id %>" class="mt-4 block rounded-xl bg-stone-900 px-3 py-2.5 text-center text-xs font-bold text-white">
                                Open Booking #<%= worker.liveBooking.id %>
                            </a>
                        <% } %>
                    </article>
                <% }) %>
            </div>

            <div class="hidden overflow-x-auto lg:block">
                <table class="w-full min-w-[1240px] text-left">
                    <thead class="border-b border-stone-200 bg-stone-50">
                        <tr>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Worker</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Rating</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Naka / Skills</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Current State</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Online Since</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Online For</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Available Until</th>
                            <th class="px-5 py-4 text-xs font-bold uppercase tracking-wide text-stone-500">Last Active</th>
                            <th class="px-5 py-4 text-right text-xs font-bold uppercase tracking-wide text-stone-500">Booking</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100">
                        <% rows.forEach(worker => { %>
                            <tr class="transition hover:bg-stone-50">
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="h-10 w-10 shrink-0 rounded-full border border-stone-200 bg-stone-100 bg-cover bg-center" style="background-image:url('<%= worker.photoUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(worker.name)}` %>')"></div>
                                        <div>
                                            <p class="text-sm font-black text-stone-950"><%= worker.name %></p>
                                            <p class="mt-1 text-xs text-stone-500"><%= worker.phone %></p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4">
                                    <% if (worker.rating.ratingCount > 0) { %>
                                        <div class="inline-flex flex-col">
                                            <div class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1">
                                                <span class="text-sm leading-none text-amber-500">★</span>
                                                <span class="text-xs font-black text-amber-800"><%= worker.rating.averageRating.toFixed(1) %> / 5</span>
                                            </div>
                                            <span class="mt-1 text-[10px] font-semibold text-stone-400"><%= worker.rating.ratingCount %> reviews</span>
                                        </div>
                                    <% } else { %>
                                        <div class="inline-flex flex-col">
                                            <div class="inline-flex items-center gap-1.5 rounded-full border border-amber-200 bg-amber-50 px-2.5 py-1">
                                                <span class="text-sm leading-none text-amber-500">★</span>
                                                <span class="text-xs font-black text-amber-800"><%= worker.rating.averageRating.toFixed(1) %> / 5</span>
                                            </div>
                                            <span class="mt-1 text-[10px] font-semibold text-stone-400">New worker • 0 reviews</span>
                                        </div>
                                    <% } %>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="max-w-[210px] truncate text-sm font-semibold text-stone-800"><%= worker.nakas.map(item => item.name).join(", ") || "No Naka" %></p>
                                    <p class="mt-1 max-w-[210px] truncate text-xs text-stone-500"><%= worker.skills.map(item => item.name).join(", ") || "No Skill" %></p>
                                </td>
                                <td class="px-5 py-4">
                                    <span class="inline-flex rounded-full border px-2.5 py-1 text-[11px] font-bold <%= worker.stateClasses %>"><%= worker.currentState %></span>
                                </td>
                                <td class="px-5 py-4 text-sm font-semibold text-stone-700"><%= worker.onlineSinceFormatted %></td>
                                <td class="px-5 py-4 text-sm font-black text-emerald-700"><%= worker.onlineFor %></td>
                                <td class="px-5 py-4 text-sm font-semibold text-stone-700"><%= worker.availableUntilFormatted %></td>
                                <td class="px-5 py-4">
                                    <p class="text-sm font-semibold text-stone-700"><%= worker.lastActiveAgo %></p>
                                    <p class="mt-1 text-xs text-stone-400"><%= worker.lastActiveFormatted %></p>
                                </td>
                                <td class="px-5 py-4 text-right">
                                    <% if (worker.liveBooking) { %>
                                        <a href="/admin/bookings/<%= worker.liveBooking.id %>" class="inline-flex rounded-lg bg-stone-900 px-3 py-2 text-xs font-bold text-white hover:bg-emerald-700">#<%= worker.liveBooking.id %></a>
                                    <% } else { %>
                                        <span class="text-xs text-stone-400">—</span>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <% if (pagination.totalPages > 1) { %>
            <div class="flex flex-col gap-3 border-t border-stone-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-xs font-semibold text-stone-500">Page <%= pagination.currentPage %> of <%= pagination.totalPages %></p>
                <div class="flex flex-wrap gap-1">
                    <% if (pagination.currentPage > 1) { %>
                        <a href="<%= pagination.pageUrl(pagination.currentPage - 1) %>" class="rounded-lg border border-stone-200 px-3 py-2 text-xs font-bold text-stone-600">Previous</a>
                    <% } %>
                    <%
                        const startPage = Math.max(1, pagination.currentPage - 2);
                        const endPage = Math.min(pagination.totalPages, pagination.currentPage + 2);
                    %>
                    <% for (let page = startPage; page <= endPage; page += 1) { %>
                        <a href="<%= pagination.pageUrl(page) %>" class="rounded-lg border px-3 py-2 text-xs font-bold <%= page === pagination.currentPage ? 'border-emerald-600 bg-emerald-600 text-white' : 'border-stone-200 text-stone-600' %>"><%= page %></a>
                    <% } %>
                    <% if (pagination.currentPage < pagination.totalPages) { %>
                        <a href="<%= pagination.pageUrl(pagination.currentPage + 1) %>" class="rounded-lg border border-stone-200 px-3 py-2 text-xs font-bold text-stone-600">Next</a>
                    <% } %>
                </div>
            </div>
        <% } %>
    </section>
</div>
