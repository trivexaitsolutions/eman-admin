<%
    const customer = booking.customer || {};
    const address = booking.address || {};
%>

<div class="space-y-6 pb-8">
    <section class="rounded-3xl border border-stone-200 bg-white px-5 py-6 shadow-sm sm:px-7">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <a href="/admin/bookings" class="text-sm font-bold text-emerald-700 hover:text-emerald-800">← Back to Bookings</a>
                <div class="mt-3 flex flex-wrap items-center gap-3">
                    <h1 class="text-2xl font-black tracking-tight text-stone-950 sm:text-3xl">Booking #<%= booking.id %></h1>
                    <span class="rounded-full border px-3 py-1 text-xs font-bold <%= booking.statusMeta.classes %>"><%= booking.statusMeta.label %></span>
                </div>
                <p class="mt-2 text-sm text-stone-500">Created <%= booking.createdAtFormatted %> • Updated <%= booking.updatedAtFormatted %></p>
            </div>

            <div class="rounded-2xl bg-stone-950 px-5 py-4 text-white">
                <p class="text-xs font-semibold text-stone-400">Booking Amount</p>
                <p class="mt-1 text-2xl font-black">₹<%= Number(booking.amount || 0).toLocaleString("en-IN") %></p>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 gap-5 xl:grid-cols-3">
        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-black text-stone-950">Customer</h2>
            <dl class="mt-4 space-y-3 text-sm">
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Name</dt><dd class="mt-1 font-bold text-stone-800"><%= customer.name || "—" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Phone</dt><dd class="mt-1 font-semibold text-stone-700"><%= customer.phone || "—" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Type</dt><dd class="mt-1 font-semibold text-stone-700"><%= customer.clientType || "—" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Business</dt><dd class="mt-1 font-semibold text-stone-700"><%= customer.businessName || "—" %></dd></div>
            </dl>
        </article>

        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-black text-stone-950">Work Details</h2>
            <dl class="mt-4 space-y-3 text-sm">
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Skill</dt><dd class="mt-1 font-bold text-stone-800"><%= booking.skill?.name || `Skill #${booking.skillId}` %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Workers Required</dt><dd class="mt-1 font-semibold text-stone-700"><%= booking.workerCount %></dd></div>
                <div>
                    <dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Selected Nakas</dt>
                    <dd class="mt-2 flex flex-wrap gap-1.5">
                        <% booking.selectedNakas.forEach(naka => { %>
                            <span class="rounded-lg border border-stone-200 bg-stone-50 px-2.5 py-1 text-xs font-bold text-stone-700"><%= naka.name %></span>
                        <% }) %>
                    </dd>
                </div>
            </dl>
        </article>

        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-black text-stone-950">Payment</h2>
            <dl class="mt-4 space-y-3 text-sm">
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Razorpay Order</dt><dd class="mt-1 break-all font-mono text-xs font-semibold text-stone-700"><%= booking.razorpayOrderId || "—" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Payment ID</dt><dd class="mt-1 break-all font-mono text-xs font-semibold text-stone-700"><%= booking.razorpayPaymentId || "—" %></dd></div>
                <div><dt class="text-xs font-bold uppercase tracking-wide text-stone-400">Rated</dt><dd class="mt-1 font-semibold text-stone-700"><%= booking.isRated ? "Yes" : "No" %></dd></div>
            </dl>
        </article>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="text-lg font-black text-stone-950">Work Address</h2>
        <div class="mt-4 rounded-2xl border border-stone-200 bg-stone-50 p-4">
            <p class="font-bold text-stone-900"><%= address.title || address.fullName || "Site Address" %></p>
            <p class="mt-2 text-sm leading-6 text-stone-600"><%= address.addressLine || customer.siteAddress || "Address not available" %></p>
            <% if (address.addressDetail) { %><p class="mt-1 text-sm text-stone-500"><%= address.addressDetail %></p><% } %>
            <p class="mt-2 text-xs font-semibold text-stone-500"><%= [address.city, address.state, address.pincode].filter(Boolean).join(", ") || "—" %></p>
        </div>
    </section>

    <section class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <div class="flex items-center justify-between gap-3">
            <div>
                <h2 class="text-lg font-black text-stone-950">Assigned Workers</h2>
                <p class="mt-1 text-sm text-stone-500"><%= booking.workers.length %> workers connected to this booking.</p>
            </div>
        </div>

        <% if (booking.workers.length === 0) { %>
            <div class="mt-5 rounded-2xl border border-dashed border-stone-300 p-8 text-center text-sm text-stone-500">Workers are not assigned yet.</div>
        <% } else { %>
            <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                <% booking.workers.forEach(worker => { %>
                    <article class="rounded-2xl border border-stone-200 p-4">
                        <div class="flex items-start gap-3">
                            <div class="h-12 w-12 shrink-0 rounded-full border border-stone-200 bg-stone-100 bg-cover bg-center" style="background-image:url('<%= worker.photoUrl || `https://ui-avatars.com/api/?name=${encodeURIComponent(worker.name)}` %>')"></div>
                            <div class="min-w-0 flex-1">
                                <p class="truncate font-black text-stone-950"><%= worker.name %></p>
                                <p class="mt-1 text-xs text-stone-500"><%= worker.phone %></p>
                            </div>
                            <span class="rounded-full border px-2.5 py-1 text-[10px] font-bold <%= worker.dutyClasses %>"><%= worker.dutyState %></span>
                        </div>

                        <div class="mt-4">
                            <p class="text-xs font-bold uppercase tracking-wide text-stone-400">Skills</p>
                            <p class="mt-1 text-sm font-semibold text-stone-700"><%= worker.skills.map(skill => skill.name).join(", ") || "—" %></p>
                        </div>
                    </article>
                <% }) %>
            </div>
        <% } %>
    </section>

    <section class="grid grid-cols-1 gap-5 xl:grid-cols-2">
        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-black text-stone-950">Customer Ratings</h2>
            <% if (booking.ratings.length === 0) { %>
                <p class="mt-4 text-sm text-stone-500">No worker ratings submitted yet.</p>
            <% } else { %>
                <div class="mt-4 space-y-3">
                    <% booking.ratings.forEach(rating => { %>
                        <div class="rounded-xl border border-stone-200 p-3 text-sm">
                            <p class="font-bold text-stone-800">Worker #<%= rating.workerId %></p>
                            <p class="mt-1 text-stone-500">Mehnat: <strong><%= rating.mehnat %>/5</strong> • Vyavhaar: <strong><%= rating.vyavhaar %>/5</strong></p>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </article>

        <article class="rounded-3xl border border-stone-200 bg-white p-5 shadow-sm">
            <h2 class="text-lg font-black text-stone-950">Conflicts</h2>
            <% if (booking.conflicts.length === 0) { %>
                <p class="mt-4 text-sm text-stone-500">No conflict raised for this booking.</p>
            <% } else { %>
                <div class="mt-4 space-y-3">
                    <% booking.conflicts.forEach(conflict => { %>
                        <a href="/admin/conflicts/<%= conflict.id %>" class="block rounded-xl border border-stone-200 p-3 transition hover:border-red-300 hover:bg-red-50">
                            <div class="flex items-center justify-between gap-3">
                                <p class="font-bold text-stone-800">Conflict #<%= conflict.id %></p>
                                <span class="text-xs font-bold text-red-600"><%= conflict.status %></span>
                            </div>
                            <p class="mt-1 text-sm text-stone-500"><%= conflict.reason %></p>
                        </a>
                    <% }) %>
                </div>
            <% } %>
        </article>
    </section>
</div>
